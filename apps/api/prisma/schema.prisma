// ------------------------------------------------------------------

/// Public job posting. Applications go to the organization's own page or inbox
/// (applyUrl), so FH never collects applicant personal information.
model JobPosting {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  facilityId       String?          @db.Uuid
  title            String
  titleFr          String?
  description      String
  descriptionFr    String?
  employmentStatus EmploymentStatus
  payMin           Decimal?         @db.Decimal(10, 2)
  payMax           Decimal?         @db.Decimal(10, 2)
  closesOn         DateTime         @db.Date
  /// Where to apply when not in the app (an https link or a mailto: address).
  applyUrl         String?
  /// Applicants apply on the careers page; applications land in FH.
  applyInApp       Boolean          @default(false)
  published        Boolean          @default(false)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  @@index([tenantId, published, closesOn])
}

/// An organization's uploaded logo, served at /api/public/logo.
model TenantLogo {
  tenantId    String   @id @db.Uuid
  contentType String
  bytes       Bytes
  sha256      String
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

/// FlexcityHeadquarters staff who set up and support organizations (the Dev console).
/// Not tied to any tenant; never accepted by tenant routes.
model PlatformAdmin {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique
  name              String
  passwordHash      String
  failedLogins      Int               @default(0)
  lockedUntil       DateTime?         @db.Timestamptz(3)
  /// Progressive lockout, stricter than organizations' (auth/bruteForce.ts POLICIES.platform).
  lastFailedLoginAt DateTime?         @db.Timestamptz(3)
  lockoutLevel      Int               @default(0)
  lastLockedAt      DateTime?         @db.Timestamptz(3)
  /// Networks this admin signed in from recently (keyed hashes, at most 3, 14 days; auth/bruteForce.ts).
  knownNetworks     String[]          @default([])
  lastLoginAt       DateTime?         @db.Timestamptz(3)
  disabledAt        DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  /// Dev console permissions beyond the console itself: "trust.read" (see the Trust area),
  /// "trust.manage" (change it), "releases.manage" (What's new notes, release rings and maintenance
  /// notices). Every console admin had each one when its area was added.
  permissions       String[]          @default(["trust.read", "trust.manage", "releases.manage"])
  sessions          PlatformSession[]
}

/// Opaque, revocable Dev console sessions (HTTP-only cookie). Only the hash is stored.
model PlatformSession {
  id        String        @id @default(uuid()) @db.Uuid
  adminId   String        @db.Uuid
  admin     PlatformAdmin @relation(fields: [adminId], references: [id])
  tokenHash String        @unique
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt DateTime      @db.Timestamptz(3)
  revokedAt DateTime?     @db.Timestamptz(3)
  /// When this session proved a second factor (a passkey). Null = password only.
  mfaAt     DateTime?     @db.Timestamptz(3)

  @@index([adminId])
}

/// Everything done from the Dev console, across organizations.
model PlatformAudit {
  id       String   @id @default(uuid()) @db.Uuid
  adminId  String   @db.Uuid
  tenantId String?  @db.Uuid
  action   String
  detail   Json?
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, at])
}

/// A passkey (WebAuthn credential): Windows Hello, Face ID / Touch ID, Android
/// fingerprint or face unlock, or a security key. Only the public key is stored.
model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  userId       String    @db.Uuid
  /// base64url credential id
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)

  @@index([tenantId, userId])
}

/// Passkeys for FH Dev console accounts.
model PlatformPasskey {
  id           String    @id @default(uuid()) @db.Uuid
  adminId      String    @db.Uuid
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)

  @@index([adminId])
}

/// Single-use WebAuthn challenges (5 minutes).
model WebAuthnChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  challenge String    @unique
  /// register | login | step-up | platform-register | platform-login
  purpose   String
  tenantId  String?   @db.Uuid
  userId    String?   @db.Uuid
  adminId   String?   @db.Uuid
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
}

/// A role an organization defines for its own non-aquatic jobs ("Water Works
/// Operator", "Maintenance Lead"). Its permissions come only from the safe,
/// non-aquatic list in src/services/people/customRoles.ts.
model CustomRole {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  name               String
  nameFr             String?
  description        String?
  permissions        String[]
  /// Department scope: lead and manager capabilities reach only people who hold
  /// one of these positions (empty = every position)…
  scopePositionIds   String[]         @default([]) @db.Uuid
  /// …and only shifts at these facilities (empty = every facility).
  scopeFacilityIds   String[]         @default([]) @db.Uuid
  /// …or every position in these departments, including ones added later.
  scopeDepartmentIds String[]         @default([]) @db.Uuid
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  members            UserCustomRole[]

  @@unique([tenantId, name])
}

model UserCustomRole {
  tenantId     String     @db.Uuid
  userId       String     @db.Uuid
  customRoleId String     @db.Uuid
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@id([userId, customRoleId])
  @@index([tenantId, customRoleId])
}

/// A bather count taken on deck (the clicker). Kept apart from water chemistry.
model HeadCount {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  poolBodyId   String   @db.Uuid
  count        Int
  overCapacity Boolean  @default(false)
  recordedById String   @db.Uuid
  recordedAt   DateTime @default(now()) @db.Timestamptz(3)

  poolBody PoolBody @relation(fields: [poolBodyId], references: [id], onDelete: Restrict)

  @@index([poolBodyId, recordedAt])
  @@index([tenantId, recordedAt])
}

// ------------------------------------------------------------------ Billing
// FlexcityHeadquarters' own invoicing of organizations (Dev console only).

enum BillingPlan {
  /// Public sector: a plan level, priced per facility per month, unlimited staff.
  MUNICIPAL
  /// Private sector: core fee including 20 active users, then per active user, plus chosen modules.
  CLUB
}

/// How often an organization is invoiced (services/billing/terms.ts).
enum BillingCycle {
  MONTHLY
  /// Twelve months of fixed charges in advance.
  ANNUAL
  /// The whole term in advance on one invoice.
  TERM
}

/// Public-sector plans (services/billing/catalog.ts).
enum PlanLevel {
  SMALL
  BUSINESS
  MULTI_COMPLEX
  ENTERPRISE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model BillingAccount {
  tenantId            String       @id @db.Uuid
  plan                BillingPlan  @default(MUNICIPAL)
  legalName           String
  contactName         String?
  email               String
  addressLine1        String?
  addressLine2        String?
  city                String?
  /// Two-letter province or territory: decides the sales tax.
  province            String
  postalCode          String?
  poNumber            String?
  paymentTermsDays    Int          @default(30)
  taxExempt           Boolean      @default(false)
  taxExemptNote       String?
  /// Public sector: which plan.
  level               PlanLevel    @default(BUSINESS)
  /// Public sector: the quoted rate per standard facility per month, in cents (Multi-complex and
  /// Enterprise; replaces the list price). Facility sizes still scale it.
  quotedRateCents     Int?
  /// Public sector, Multi-complex: the quoted staff allowance (active people), replacing the per-facility one.
  includedStaff       Int?
  /// How often fixed charges are invoiced.
  billingCycle        BillingCycle @default(MONTHLY)
  /// Committed term in months (12, 36, 60...); null = month to month. Prices are held for the term.
  termMonths          Int?
  /// First day of the term, and of yearly invoices.
  termStart           DateTime?    @db.Date
  /// Commitment discount on fixed charges, in percent; null = the standard for the term.
  discountPercent     Decimal?     @db.Decimal(5, 2)
  /// Extra staff places added to the plan, billed every month at the plan's per-person rate (private: the per-user rate).
  extraStaffSeats     Int          @default(0)
  /// Options switched away from the plan's standard, and custom prices: { "<option>": { "on": bool, "cents": int } }
  /// (services/billing/catalog.ts). Private sector: every option is off unless switched on here.
  items               Json         @default("{}")
  /// Until then, every feature is on (a trial or pilot).
  trialEndsAt         DateTime?    @db.Timestamptz(3)
  /// Days after an invoice's due date before the app turns read-only.
  graceDays           Int          @default(30)
  /// The Dev console can hold off suspension (e.g. a cheque is in the mail).
  suspensionHoldUntil DateTime?    @db.Timestamptz(3)
  /// How they usually pay: INVOICE (EFT or cheque), CARD or PAD (pre-authorized debit).
  preferredPayment    String       @default("INVOICE")
  /// Private sector: price per active user beyond the 20 included, in cents.
  clubUserRateCents   Int          @default(500)
  notes               String?
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
}

model Invoice {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  /// Assigned when sent, in sequence (FH-2026-0001); drafts have none.
  number        String?          @unique
  status        InvoiceStatus    @default(DRAFT)
  periodStart   DateTime         @db.Date
  periodEnd     DateTime         @db.Date
  issueDate     DateTime?        @db.Date
  dueDate       DateTime?        @db.Date
  currency      String           @default("CAD")
  subtotalCents Int              @default(0)
  /// [{ name: "GST", rate: "5", amountCents: 12500 }]
  taxLines      Json             @default("[]")
  totalCents    Int              @default(0)
  paidCents     Int              @default(0)
  /// The billing details as they were when sent.
  billTo        Json
  poNumber      String?
  notes         String?
  sentAt        DateTime?        @db.Timestamptz(3)
  paidAt        DateTime?        @db.Timestamptz(3)
  voidedAt      DateTime?        @db.Timestamptz(3)
  voidReason    String?
  /// Last online checkout started for this invoice (Stripe Checkout Session id).
  checkoutId    String?
  createdById   String           @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  lines         InvoiceLine[]
  payments      InvoicePayment[]

  @@index([tenantId, periodStart])
  @@index([status])
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  /// facility | club_base | club_users | addon_hr | addon_ops | credit | other: decides the revenue account.
  kind        String  @default("other")
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitCents   Int
  amountCents Int
}

model InvoicePayment {
  id           String   @id @default(uuid()) @db.Uuid
  invoiceId    String   @db.Uuid
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents  Int
  receivedOn   DateTime @db.Date
  /// EFT | CHEQUE | CARD | PAD | OTHER
  method       String
  reference    String?
  recordedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

model InvoiceCounter {
  year Int @id
  last Int @default(0)
}

/// Enquiries from the marketing website (sales, demo requests, support). Seen in the Dev console.
model Lead {
  id               String   @id @default(uuid()) @db.Uuid
  /// SALES | DEMO | SUPPORT
  kind             String
  name             String
  email            String
  organization     String?
  role             String?
  province         String?
  facilities       Int?
  message          String
  locale           String   @default("en-CA")
  /// CASL: express consent to marketing email, recorded separately from the enquiry itself.
  marketingConsent Boolean  @default(false)
  consentText      String?
  /// NEW | CONTACTED | WON | CLOSED
  status           String   @default("NEW")
  notes            String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

/// Cross-city benchmark: quartiles of one measure across opted-in cities on a
/// date. No city ids or values are stored, and only when at least five cities
/// contribute. Platform-owned (no tenant).
model BenchmarkSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  metric     String
  computedOn DateTime @db.Date
  cities     Int
  p25        Float
  p50        Float
  p75        Float

  @@unique([metric, computedOn])
}

/// Sign-in and reset attempts, shared by every API server so rate limits hold
/// across instances and restarts. Platform-level (no tenant); rows older than
/// a day are pruned.
model RateLimitHit {
  id  BigInt   @id @default(autoincrement())
  key String
  at  DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, at])
}

enum LoneWorkStatus {
  ACTIVE
  /// Missed a check-in: the worker and their monitors were told.
  OVERDUE
  /// Still no answer after the grace period: supervisors and HR were told.
  ESCALATED
  /// The worker pressed "I need help".
  HELP
  ENDED
}

/// Someone working alone (a pump station, an arena at night, a park patrol)
/// checks in on a timer. A missed check-in alerts their monitors, then escalates.
model LoneWorkSession {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  userId          String         @db.Uuid
  facilityId      String?        @db.Uuid
  location        String
  task            String?
  intervalMinutes Int
  status          LoneWorkStatus @default(ACTIVE)
  startedAt       DateTime       @default(now()) @db.Timestamptz(3)
  lastCheckInAt   DateTime       @default(now()) @db.Timestamptz(3)
  nextDueAt       DateTime       @db.Timestamptz(3)
  overdueAt       DateTime?      @db.Timestamptz(3)
  escalatedAt     DateTime?      @db.Timestamptz(3)
  helpAt          DateTime?      @db.Timestamptz(3)
  helpNote        String?
  /// The person chose to keep their location up to date during this session (while the app is open).
  shareLocation   Boolean        @default(false)
  locationAt      DateTime?      @db.Timestamptz(3)
  /// The "check-in due soon" reminder for the current interval was sent.
  remindedAt      DateTime?      @db.Timestamptz(3)
  /// Last position the worker's device shared, if any.
  latitude        Decimal?       @db.Decimal(9, 6)
  longitude       Decimal?       @db.Decimal(9, 6)
  respondingId    String?        @db.Uuid
  respondingAt    DateTime?      @db.Timestamptz(3)
  endedAt         DateTime?      @db.Timestamptz(3)

  @@index([tenantId, status, nextDueAt])
  @@index([userId, startedAt])
}

// ------------------------------------------------------------ Winter operations

enum CallOutStatus {
  OPEN
  FILLED
  CANCELLED
}

enum CallOutContactStatus {
  /// Waiting for their turn.
  WAITING
  /// Offered now; answer within the response time.
  OFFERED
  ACCEPTED
  DECLINED
  NO_ANSWER
  /// Not eligible (rest, hours, certificates, time off…); the reason is kept.
  SKIPPED
  /// The call-out was filled or cancelled before their turn.
  NOT_NEEDED
}

/// A storm call-out: extra crew offered in overtime order, one at a time.
model CallOut {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  facilityId      String           @db.Uuid
  positionId      String           @db.Uuid
  /// The open shift created for it; assigned to whoever accepts.
  shiftId         String           @db.Uuid
  reason          String
  startsAt        DateTime         @db.Timestamptz(3)
  endsAt          DateTime         @db.Timestamptz(3)
  responseMinutes Int
  status          CallOutStatus    @default(OPEN)
  filledUserId    String?          @db.Uuid
  createdById     String           @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  closedAt        DateTime?        @db.Timestamptz(3)
  contacts        CallOutContact[]

  @@index([tenantId, status, createdAt])
}

model CallOutContact {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @db.Uuid
  callOutId    String               @db.Uuid
  callOut      CallOut              @relation(fields: [callOutId], references: [id], onDelete: Cascade)
  userId       String               @db.Uuid
  rank         Int
  status       CallOutContactStatus @default(WAITING)
  skipReason   String?
  offeredAt    DateTime?            @db.Timestamptz(3)
  respondedAt  DateTime?            @db.Timestamptz(3)
  /// Who recorded the answer when it came by phone (null = the person answered in the app).
  recordedById String?              @db.Uuid

  @@index([callOutId, rank])
  @@index([tenantId, status, offeredAt])
}

/// A road or area patrolled in winter, and how often it must be checked.
model PatrolRoute {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  name          String
  /// e.g. a road class under the city's maintenance standard (Ontario O. Reg. 239/02: 1–5).
  roadClass     String?
  /// Hours between patrols during the winter season.
  intervalHours Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, name])
}

/// One patrol: what the roads were like and what was done, as evidence.
model PatrolRecord {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  routeId        String    @db.Uuid
  userId         String    @db.Uuid
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  endedAt        DateTime? @db.Timestamptz(3)
  /// CLEAR, WET, SLUSH, SNOW_PACKED, LOOSE_SNOW, ICE, BLACK_ICE, DRIFTING, FREEZING_RAIN
  conditions     String[]
  /// INSPECTED, PLOWED, SALTED, SANDED, BRINE, HAZARD_REPORTED
  actions        String[]
  snowCm         Decimal?  @db.Decimal(5, 1)
  airTempC       Decimal?  @db.Decimal(4, 1)
  roadTempC      Decimal?  @db.Decimal(4, 1)
  materialTonnes Decimal?  @db.Decimal(7, 2)
  vehicle        String?
  notes          String?
  startLat       Decimal?  @db.Decimal(9, 6)
  startLng       Decimal?  @db.Decimal(9, 6)
  endLat         Decimal?  @db.Decimal(9, 6)
  endLng         Decimal?  @db.Decimal(9, 6)

  @@index([tenantId, routeId, startedAt])
  @@index([userId, startedAt])
}

// ------------------------------------------------- Programs and member services

enum EnrollmentStatus {
  ENROLLED
  WAITLISTED
  CANCELLED
}

/// A swim level (Red Cross, Lifesaving Society, or the city's own), with its ages.
model SwimLevel {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @db.Uuid
  program         String
  name            String
  nameFr          String?
  minAgeMonths    Int
  maxAgeMonths    Int?
  parentInWater   Boolean @default(false)
  /// Swimmers per instructor.
  ratio           Int     @default(6)
  durationMinutes Int     @default(30)
  sortOrder       Int     @default(0)
  active          Boolean @default(true)

  @@unique([tenantId, program, name])
}

enum CampaignKind {
  LESSONS
  SWIM_CLUB
  CAMP
  OTHER
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// A registration campaign: a season of lessons, a swim club session, a camp.
model LessonCampaign {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @db.Uuid
  name                 String
  nameFr               String?
  kind                 CampaignKind   @default(LESSONS)
  status               CampaignStatus @default(DRAFT)
  startsOn             DateTime       @db.Date
  endsOn               DateTime       @db.Date
  registrationOpensAt  DateTime?      @db.Timestamptz(3)
  registrationClosesAt DateTime?      @db.Timestamptz(3)
  /// No lessons these days (stat holidays, pool closures).
  skipDates            DateTime[]     @db.Date
  notes                String?
  createdById          String         @db.Uuid
  publishedAt          DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)

  @@index([tenantId, status])
}

/// A family on file: parents or guardians and their children.
model Household {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  name           String
  address        String?
  emergencyName  String?
  emergencyPhone String?
  notes          String?
  /// STAFF or ONLINE; online families may duplicate one already on file.
  source         String   @default("STAFF")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  members        Member[]

  @@index([tenantId, name])
}

enum MemberRole {
  GUARDIAN
  CHILD
  ADULT
}

model Member {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  householdId  String     @db.Uuid
  household    Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role         MemberRole
  firstName    String
  lastName     String
  dateOfBirth  DateTime?  @db.Date
  email        String?
  phone        String?
  /// Short note the instructor sees on deck (e.g. "Asthma: inhaler in bag").
  safetyNote   String?
  /// Consent to share photos, recorded at registration.
  photoConsent Boolean    @default(false)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([tenantId, lastName])
  @@index([householdId])
}

enum FeeKind {
  MEMBERSHIP
  DROP_IN
  PASS
  PROGRAM
}

enum FeePeriod {
  YEAR
  MONTH
  VISIT
  NONE
}

/// The facility price list: memberships by year or month, drop-in, passes, programs.
model FeeItem {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  /// null = every facility.
  facilityId String?   @db.Uuid
  kind       FeeKind
  period     FeePeriod @default(NONE)
  /// ADULT, YOUTH, CHILD, SENIOR, FAMILY, STUDENT, ALL
  ageGroup   String    @default("ALL")
  name       String
  nameFr     String?
  priceCents Int
  /// Visits on a pass (e.g. 10).
  visits     Int?
  active     Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, kind])
}

/// Something member services sold: a membership, a drop-in, a pass, a lesson registration.
model Sale {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  householdId   String?   @db.Uuid
  memberId      String?   @db.Uuid
  feeId         String?   @db.Uuid
  enrollmentId  String?   @db.Uuid
  facilityId    String?   @db.Uuid
  description   String
  priceCents    Int
  validFrom     DateTime? @db.Date
  validTo       DateTime? @db.Date
  /// CASH, DEBIT, CREDIT, ON_ACCOUNT, COMPLIMENTARY
  paymentMethod String
  soldById      String    @db.Uuid
  refundedAt    DateTime? @db.Timestamptz(3)
  refundedById  String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([householdId])
}

/// Something the public can book at a facility: a party room, a lane, ice time.
model BookableService {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  facilityId      String   @db.Uuid
  name            String
  nameFr          String?
  description     String?
  descriptionFr   String?
  durationMinutes Int
  priceCents      Int
  /// Bookings that can run at the same time (e.g. 2 party rooms).
  capacity        Int      @default(1)
  maxPartySize    Int?
  daysOfWeek      Int[]
  openMinute      Int
  closeMinute     Int
  /// Booked at least this many days ahead.
  leadDays        Int      @default(2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, active])
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
}

model BookingRequest {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  serviceId    String        @db.Uuid
  startsAt     DateTime      @db.Timestamptz(3)
  endsAt       DateTime      @db.Timestamptz(3)
  partySize    Int?
  name         String
  email        String
  phone        String
  organization String?
  notes        String?
  status       BookingStatus @default(REQUESTED)
  reference    String        @unique
  decidedById  String?       @db.Uuid
  decidedAt    DateTime?     @db.Timestamptz(3)
  decisionNote String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([tenantId, serviceId, startsAt])
  @@index([tenantId, status])
}

/// A certificate that must be on duty at a facility at set times, e.g. a
/// refrigeration plant operator while an arena's ice plant runs, or a water
/// treatment operator (ORO) at a plant. The schedule is checked against it.
model CoverageRule {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  facilityId      String    @db.Uuid
  name            String
  certificationId String    @db.Uuid
  minCount        Int       @default(1)
  daysOfWeek      Int[]
  startMinute     Int
  /// Up to 2880: a window can run past midnight (e.g. 22:00 to 06:00).
  endMinute       Int
  note            String?
  active          Boolean   @default(true)
  lastAlertedAt   DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, facilityId])
}

// ------------------------------------------------------------------ Fleet

/// A city vehicle: a plow, a pickup, a sewer flusher, an ice resurfacer.
model Vehicle {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  facilityId         String?   @db.Uuid
  unit               String
  description        String
  plate              String?
  /// The licence needed to drive it (a certification, e.g. Class 3 with air brakes).
  certificationId    String?   @db.Uuid
  outOfServiceAt     DateTime? @db.Timestamptz(3)
  outOfServiceReason String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, unit])
}

enum InspectionResult {
  PASS
  MINOR
  MAJOR
}

/// A driver's pre-trip (or post-trip) inspection, item by item.
model VehicleInspection {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  vehicleId    String           @db.Uuid
  userId       String           @db.Uuid
  at           DateTime         @default(now()) @db.Timestamptz(3)
  odometerKm   Int?
  /// [{ item: "BRAKES", ok: false, severity: "MAJOR", note: "Soft pedal" }]
  items        Json
  result       InspectionResult
  notes        String?
  /// When a major defect was fixed and the vehicle returned to service.
  repairedAt   DateTime?        @db.Timestamptz(3)
  repairedById String?          @db.Uuid
  repairNote   String?

  @@index([tenantId, vehicleId, at])
}

enum InjuryClaimStatus {
  /// Needs reporting to the board.
  OPEN
  FILED
  /// First aid only, no lost time: kept on file, no report required.
  NOT_REQUIRED
}

/// A worker's injury and the employer's report to the province's
/// compensation board (WSIB, WorkSafeBC, WCB…), with its deadline.
model InjuryClaim {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  userId          String            @db.Uuid
  facilityId      String            @db.Uuid
  incidentId      String?           @db.Uuid
  occurredAt      DateTime          @db.Timestamptz(3)
  /// When a supervisor or HR learned of it: the deadline counts from here.
  learnedAt       DateTime          @db.Timestamptz(3)
  province        Province
  board           String
  dueAt           DateTime          @db.Timestamptz(3)
  lostTime        Boolean           @default(false)
  healthCare      Boolean           @default(false)
  /// Short and factual (e.g. "Sprained right ankle on pool deck stairs"); details stay in the incident report.
  description     String
  status          InjuryClaimStatus @default(OPEN)
  claimNumber     String?
  filedAt         DateTime?         @db.Timestamptz(3)
  filedById       String?           @db.Uuid
  accommodationId String?           @db.Uuid
  createdById     String            @db.Uuid
  reminderSentAt  DateTime?         @db.Timestamptz(3)
  overdueSentAt   DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  @@index([tenantId, status, dueAt])
}

// ------------------------------------------------------------------ Payroll

enum PayRunStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

enum BankAccountStatus {
  /// Entered, waiting for someone other than the person who entered it to verify.
  PENDING
  ACTIVE
  RETIRED
  REJECTED
}

/// Tax set-up for one employee (from their TD1 forms). SIN is sealed with the city's key.
model PayProfile {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  userId            String    @unique @db.Uuid
  /// Province or territory of employment for tax; null = the province of the facility they work at.
  province          Province?
  /// TD1 total claim amounts; null = the basic personal amount.
  federalClaim      Decimal?  @db.Decimal(12, 2)
  provincialClaim   Decimal?  @db.Decimal(12, 2)
  extraTaxPerPeriod Decimal   @default(0) @db.Decimal(10, 2)
  /// Home mailing address for tax slips (T4, RL-1) and the ROE: { line1, line2, city, province, postalCode }.
  mailingAddress    Json?
  cppExempt         Boolean   @default(false)
  eiExempt          Boolean   @default(false)
  sinCiphertext     Bytes?
  sinIv             Bytes?
  sinAuthTag        Bytes?
  sinWrappedKey     Bytes?
  sinKekId          String?
  sinLast3          String?
  td1SignedAt       DateTime? @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

/// Where someone's pay is deposited. The account number is sealed; only the last four digits are kept in clear.
model BankAccount {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  userId            String            @db.Uuid
  holderName        String
  /// Financial institution number (3 digits) and branch transit (5 digits).
  institution       String
  transit           String
  accountCiphertext Bytes
  accountIv         Bytes
  accountAuthTag    Bytes
  accountWrappedKey Bytes
  accountKekId      String
  last4             String
  status            BankAccountStatus @default(PENDING)
  /// The direct-deposit authorization the person agreed to, word for word.
  consentText       String
  consentAt         DateTime          @db.Timestamptz(3)
  enteredById       String            @db.Uuid
  verifiedById      String?           @db.Uuid
  verifiedAt        DateTime?         @db.Timestamptz(3)
  retiredAt         DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

/// One pay run: a pay period for the whole city or one department.
model PayRun {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  departmentId       String?           @db.Uuid
  periodStart        DateTime          @db.Date
  periodEnd          DateTime          @db.Date
  payDate            DateTime          @db.Date
  periodsPerYear     Int
  status             PayRunStatus      @default(DRAFT)
  preparedById       String            @db.Uuid
  approvedById       String?           @db.Uuid
  approvedAt         DateTime?         @db.Timestamptz(3)
  paidAt             DateTime?         @db.Timestamptz(3)
  voidedAt           DateTime?         @db.Timestamptz(3)
  /// { gross, deductions, net, employerCpp, employerEi, people, deposits, cheques }
  totals             Json              @default("{}")
  /// Problems that must be fixed before approval.
  blockers           Json              @default("[]")
  warnings           Json              @default("[]")
  fileCreationNumber Int?
  depositFileSha256  String?
  /// REGULAR (hours and salaries for the period) or OFF_CYCLE (one-time payments only: a bonus run, final pay, a correction).
  kind               String            @default("REGULAR")
  /// Why an off-cycle run was made.
  note               String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  statements         PayStatement[]
  transmissions      PayTransmission[]

  @@index([tenantId, periodStart])
}

/// What one person is paid in one run: earnings, deductions, net and year-to-date.
model PayStatement {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  payRunId        String   @db.Uuid
  userId          String   @db.Uuid
  departmentId    String?  @db.Uuid
  province        Province
  year            Int
  payDate         DateTime @db.Date
  hours           Decimal  @db.Decimal(10, 2)
  /// [{ code, positionId, hours, rate, amount }]
  earnings        Json
  /// { cpp, cpp2, ei, federalTax, provincialTax, extraTax }
  deductions      Json
  gross           Decimal  @db.Decimal(12, 2)
  totalDeductions Decimal  @db.Decimal(12, 2)
  net             Decimal  @db.Decimal(12, 2)
  employerCpp     Decimal  @db.Decimal(12, 2)
  employerEi      Decimal  @db.Decimal(12, 2)
  /// Year-to-date after this statement: { gross, cpp, cpp2, ei, federalTax, provincialTax, net, insurable, pensionable }
  ytd             Json
  bankAccountId   String?  @db.Uuid
  depositLast4    String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  payRun          PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, year])
  @@index([payRunId])
}

/// CRA and provincial payroll rates for one year and jurisdiction ("CA" = federal, CPP and EI).
/// Shared by every city; FH staff check each table against CRA's T4127 before it's used.
model PayrollTaxTable {
  id           String    @id @default(uuid()) @db.Uuid
  year         Int
  jurisdiction String
  data         Json
  verifiedAt   DateTime? @db.Timestamptz(3)
  verifiedBy   String?
  note         String?
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([year, jurisdiction])
}

enum TransmissionStatus {
  SENT
  FAILED
}

/// Every attempt to send a pay run's deposit file to the city's bank.
model PayTransmission {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  payRunId  String             @db.Uuid
  sentById  String?            @db.Uuid
  method    String
  fileName  String
  sha256    String
  encrypted Boolean
  status    TransmissionStatus
  error     String?
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  payRun    PayRun             @relation(fields: [payRunId], references: [id], onDelete: Cascade)

  @@index([payRunId])
}

// ------------------------------------------------------------------ Benefits

enum BenefitKind {
  /// Registered pension plan (OMERS, MEPP, LAPP…): employee contributions come off taxable income.
  PENSION
  HEALTH
  DENTAL
  LIFE
  DISABILITY
  /// Union dues: deducted from pay and from taxable income.
  UNION_DUES
  EAP
  OTHER
}

/// A benefit plan or payroll deduction the city offers, with the employee and employer shares per pay.
model BenefitPlan {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid
  name            String
  nameFr          String?
  kind            BenefitKind
  provider        String?
  /// Employee share each pay: a percent of gross pay plus a fixed amount.
  employeePercent Decimal             @default(0) @db.Decimal(6, 3)
  employeeAmount  Decimal             @default(0) @db.Decimal(10, 2)
  /// Employer share each pay, the same way.
  employerPercent Decimal             @default(0) @db.Decimal(6, 3)
  employerAmount  Decimal             @default(0) @db.Decimal(10, 2)
  /// The employer's share is a taxable benefit to the employee (e.g. employer-paid group life insurance).
  employerTaxable Boolean             @default(false)
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  enrollments     BenefitEnrollment[]

  @@unique([tenantId, name])
}

model BenefitEnrollment {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  planId         String      @db.Uuid
  userId         String      @db.Uuid
  startsOn       DateTime    @db.Date
  endsOn         DateTime?   @db.Date
  /// e.g. "Single", "Family".
  coverage       String?
  /// Overrides the plan's employee share per pay (e.g. family coverage).
  employeeAmount Decimal?    @db.Decimal(10, 2)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  plan           BenefitPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([planId])
}

// ------------------------------------------------------------------ HR departments

/// Leave for one person, type and year (hours). Balance = hours + carry-over − approved leave that year.
model LeaveEntitlement {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  userId    String      @db.Uuid
  year      Int
  type      TimeOffType
  hours     Decimal     @db.Decimal(8, 2)
  carryover Decimal     @default(0) @db.Decimal(8, 2)
  note      String?
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, year, type])
}

enum ReviewStatus {
  /// Waiting for the employee's self-assessment.
  SELF
  /// Waiting for the reviewer.
  MANAGER
  /// Reviewer done; waiting for the employee to read and acknowledge.
  DISCUSS
  ACKNOWLEDGED
}

/// A performance review: goals, self-assessment, the reviewer's assessment and rating, and the employee's acknowledgement.
model PerformanceReview {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  userId           String       @db.Uuid
  reviewerId       String       @db.Uuid
  cycle            String
  dueOn            DateTime     @db.Date
  status           ReviewStatus @default(SELF)
  /// [{ text, met: boolean | null }]
  goals            Json         @default("[]")
  selfComments     String?
  managerComments  String?
  /// 1 (needs improvement) to 5 (outstanding).
  rating           Int?
  employeeComments String?
  acknowledgedAt   DateTime?    @db.Timestamptz(3)
  createdById      String       @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([reviewerId])
}

/// An internal course: in-service, WHMIS, orientation, defensive driving… Mandatory ones can apply to some positions and need renewing.
model TrainingCourse {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  name        String
  nameFr      String?
  hours       Decimal          @default(0) @db.Decimal(6, 2)
  mandatory   Boolean          @default(false)
  /// Months until it must be retaken; null = once.
  renewMonths Int?
  /// Positions it's mandatory for; empty = everyone.
  positionIds String[]         @default([]) @db.Uuid
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  records     TrainingRecord[]

  @@unique([tenantId, name])
}

model TrainingRecord {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  courseId     String         @db.Uuid
  userId       String         @db.Uuid
  completedOn  DateTime       @db.Date
  hours        Decimal?       @db.Decimal(6, 2)
  trainer      String?
  recordedById String         @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([courseId])
}

enum GrievanceStatus {
  FILED
  STEP_1
  STEP_2
  STEP_3
  ARBITRATION
  RESOLVED
  WITHDRAWN
}

/// A grievance under the collective agreement, tracked step by step against its deadlines.
model Grievance {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  number      Int
  /// The grievor; null for a policy or group grievance.
  userId      String?         @db.Uuid
  kind        String          @default("INDIVIDUAL")
  title       String
  articles    String?
  filedOn     DateTime        @db.Date
  status      GrievanceStatus @default(FILED)
  /// When the employer's reply (or the next step) is due.
  dueOn       DateTime?       @db.Date
  outcome     String?
  /// [{ at, by, status, note }]
  history     Json            @default("[]")
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, number])
}

/// Someone leaving: the checklist from last day to final pay, Record of Employment and access removed.
model Offboarding {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @unique @db.Uuid
  lastDay     DateTime  @db.Date
  reason      String
  /// [{ key, done, doneAt, doneById }]
  checklist   Json
  completedAt DateTime? @db.Timestamptz(3)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
}

enum PadStatus {
  ACTIVE
  CANCELLED
}

/// A city's authorization for FH to debit its bank account for plan charges (business PAD, Payments Canada Rule H1).
model PadAgreement {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  status           PadStatus  @default(ACTIVE)
  /// The account holder: the city or organization.
  payorName        String
  signerName       String
  signerTitle      String
  institution      String
  transit          String
  accountLast4     String
  /// The full account number, sealed with the organization's key.
  accountSealed    Json
  agreementVersion String
  /// Business PAD payors may waive the 10-day pre-notification; invoices still go out before any debit.
  waivedPreNotice  Boolean    @default(false)
  /// DEV_CONSOLE (signed form on file) or ORGANIZATION (authorized in the app).
  channel          String
  authorizedBy     String
  authorizedAt     DateTime   @default(now()) @db.Timestamptz(3)
  cancelledAt      DateTime?  @db.Timestamptz(3)
  cancelReason     String?
  debits           PadDebit[]

  @@index([tenantId, status])
}

enum PadBatchStatus {
  CREATED
  SENT
  SETTLED
}

/// One debit file to FH's bank.
model PadBatch {
  id          String         @id @default(uuid()) @db.Uuid
  /// CPA-005 file creation number, 1–9999, one higher every file.
  fileNumber  Int
  debitDate   DateTime       @db.Date
  status      PadBatchStatus @default(CREATED)
  totalCents  Int
  count       Int
  createdById String         @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  sentAt      DateTime?      @db.Timestamptz(3)
  settledAt   DateTime?      @db.Timestamptz(3)
  debits      PadDebit[]
}

enum PadDebitStatus {
  PENDING
  SETTLED
  RETURNED
}

model PadDebit {
  id           String         @id @default(uuid()) @db.Uuid
  batchId      String         @db.Uuid
  batch        PadBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  agreementId  String         @db.Uuid
  agreement    PadAgreement   @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  invoiceId    String         @db.Uuid
  tenantId     String         @db.Uuid
  amountCents  Int
  status       PadDebitStatus @default(PENDING)
  returnReason String?
  returnedOn   DateTime?      @db.Date

  @@index([invoiceId])
}

/// FH's own books: chart of accounts, PAD originator details, fiscal settings. One row.
model FhBooks {
  id              Int       @id @default(1)
  /// { ar: "1200", bank: "1000", ... } overrides of the default chart.
  accounts        Json      @default("{}")
  /// { originatorId, dataCentre, shortName, longName, transactionCode, returns: { institution, transit, last4, sealed } }
  padOriginator   Json?
  lastFileNumber  Int       @default(0)
  /// First month of FH's fiscal year (1–12).
  fiscalYearStart Int       @default(1)
  /// Entries on or before this date can't change (books closed).
  closedThrough   DateTime? @db.Date
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}

/// Adjustments FH's accountant posts by hand (bank fees, interest, accruals). Each balances.
model FhJournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  memo        String
  /// [{ account: "6100", debitCents: 1500, creditCents: 0 }]
  lines       Json
  reference   String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

enum DocumentKind {
  MEDICAL_NOTE
  CERTIFICATE
  IDENTIFICATION
  CONTRACT
  POLICY
  OTHER
  /// A receipt attached to an expense claim.
  RECEIPT
}

enum DocumentVisibility {
  /// HR only (and the employee): medical notes always.
  HR
  /// HR, the employee and the supervisors of their department.
  DEPARTMENT
}

/// A file kept on an employee's record (a doctor's note, a certificate, a contract). Encrypted with the organization's key.
model EmployeeDocument {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  userId        String             @db.Uuid
  uploadedById  String             @db.Uuid
  kind          DocumentKind
  visibility    DocumentVisibility @default(HR)
  title         String
  fileName      String
  contentType   String
  size          Int
  /// SHA-256 of the original file, to show it hasn't changed.
  sha256        String
  ciphertext    Bytes
  iv            Bytes
  authTag       Bytes
  wrappedKey    Bytes
  kekId         String
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  deletedAt     DateTime?          @db.Timestamptz(3)
  deletedById   String?            @db.Uuid
  deletedReason String?

  @@index([tenantId, userId])
}

enum SupportLevel {
  /// Set-up screens: settings, facilities, positions, roles, menus, billing. No personal records.
  SETUP
  /// Everything HR sees, read-only.
  FULL
}

/// The organization's consent for FH support to look in, read-only, until it expires.
model SupportGrant {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  grantedById String       @db.Uuid
  level       SupportLevel @default(SETUP)
  reason      String?
  expiresAt   DateTime     @db.Timestamptz(3)
  revokedAt   DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([tenantId, expiresAt])
}

/// One FH support visit under a grant: a one-time code exchanged in the city's app for a short, read-only session.
model SupportSession {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  grantId       String    @db.Uuid
  adminId       String    @db.Uuid
  codeHash      String    @unique
  codeExpiresAt DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)
  endsAt        DateTime  @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId])
}

enum SsoProtocol {
  OIDC
  SAML
}

/// The organization's single sign-on: Microsoft Entra ID (or any OpenID Connect provider), or SAML 2.0.
/// Only signs in people who already have an account; it never creates one.
model SsoConnection {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @unique @db.Uuid
  protocol       SsoProtocol
  enabled        Boolean     @default(false)
  /// Password sign-in is off, except for people who can change this setting (so nobody is locked out).
  enforced       Boolean     @default(false)
  /// The identity provider always requires a second factor (e.g. Entra conditional access), so SSO counts as MFA.
  idpMfa         Boolean     @default(false)
  /// Button text, e.g. "Microsoft".
  label          String?
  /// Only emails at these domains may sign in this way; empty means any.
  domains        String[]    @default([])
  oidcIssuer     String?
  oidcClientId   String?
  /// Sealed client secret.
  oidcSecret     Json?
  samlEntryPoint String?
  samlIdpIssuer  String?
  /// The identity provider's signing certificate (PEM or base64).
  samlCert       String?
  lastUsedAt     DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

/// A browser or installed app that receives push notifications for one person.
model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  userId     String    @db.Uuid
  /// The push service's address for this device (unguessable).
  endpoint   String    @unique
  p256dh     String
  auth       String
  /// e.g. "iPhone", "Android", "Windows": shown so people can tell their devices apart.
  device     String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSentAt DateTime? @db.Timestamptz(3)
  failures   Int       @default(0)

  @@index([tenantId, userId])
}

/// A person's signed information and consent agreement (services/privacy/consent.ts): evidence of
/// exactly what they were shown and agreed to. Never edited; a new version is a new row.
model ConsentRecord {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  userId          String   @db.Uuid
  version         String
  locale          String
  /// SHA-256 of the agreement text exactly as shown.
  textSha256      String
  /// The agreement exactly as shown ({ title, intro, sections, confirm }), so a certificate shows the version this person signed.
  agreement       Json?
  signedName      String
  /// PNG from the signature pad, and its SHA-256.
  signature       Bytes
  signatureSha256 String
  /// { notifications, location }: granted, denied, skipped or unsupported.
  choices         Json
  ipAddress       String?
  userAgent       String?
  signedAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, signedAt])
  @@index([userId, version])
}

/// Quebec workforce skills law (Loi sur les compétences, the 1% law): what an employer with a payroll
/// over the threshold spent on eligible training in a year. It reduces the WSDRF contribution owed.
model TrainingSpend {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  year             Int
  spentOn          DateTime          @db.Date
  category         TrainingSpendKind
  description      String
  amountCents      Int
  /// Link to the training it paid for, when there is one.
  trainingRecordId String?           @db.Uuid
  createdById      String            @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)

  @@index([tenantId, year])
}

enum TrainingSpendKind {
  COURSE_FEES
  TRAINER
  WAGES_IN_TRAINING
  TRAVEL
  MATERIALS
  OTHER
}

/// Each pay period sent to a payroll provider (ADP, Dayforce, Wagepoint) over its API.
model PayrollSync {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  provider    String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  /// SENT or FAILED.
  status      String
  rows        Int
  /// SHA-256 of the file sent, to match it with the provider's copy.
  fileSha256  String
  httpStatus  Int?
  reference   String?
  message     String?
  sentById    String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
}

/// A salaried person's annual salary, paid evenly each pay period instead of by hours.
model Salary {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  userId           String    @db.Uuid
  /// Where the cost goes (the position's department).
  positionId       String    @db.Uuid
  annualAmount     Decimal   @db.Decimal(12, 2)
  /// Normal hours a week, for insurable hours on the ROE.
  weeklyHours      Decimal   @default(37.5) @db.Decimal(5, 2)
  /// Overtime hours are still paid on top (for overtime-eligible salaried staff).
  overtimeEligible Boolean   @default(false)
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  createdById      String    @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, userId, effectiveFrom])
}

/// A one-time payment or deduction on one pay run: a bonus, retroactive pay, an allowance, a
/// reimbursement (not taxed), or a deduction such as recovering an overpayment.
model PayAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  payRunId    String   @db.Uuid
  userId      String   @db.Uuid
  /// BONUS, RETRO, ALLOWANCE, VACATION_PAYOUT, OTHER_EARNING (taxable); REIMBURSEMENT (not taxable); RECOVERY, OTHER_DEDUCTION (after tax).
  kind        String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  /// LIEU_PAYOUT: the banked hours paid out.
  hours       Decimal? @db.Decimal(8, 2)
  positionId  String?  @db.Uuid
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, payRunId])
}

/// A deduction a court, the Family Responsibility Office or CRA orders the employer to take each pay
/// and send on, until the total is paid.
model PayDeductionOrder {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  userId          String    @db.Uuid
  /// GARNISHMENT, SUPPORT_ORDER, CRA_REQUIREMENT, OTHER.
  kind            String
  payee           String
  reference       String?
  /// A fixed amount each pay, or a percent of net pay (one of the two).
  amountPerPay    Decimal?  @db.Decimal(12, 2)
  percentOfNet    Decimal?  @db.Decimal(5, 2)
  /// Never more than this share of net pay (provincial exemptions; 50% unless the order says otherwise).
  maxPercentOfNet Decimal   @default(50) @db.Decimal(5, 2)
  /// Stops once this much has been taken (null = until ended).
  totalOwed       Decimal?  @db.Decimal(12, 2)
  startsOn        DateTime  @db.Date
  endsOn          DateTime? @db.Date
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, userId])
}

/// Who to call for a person in an emergency. Seen by the person, HR, and whoever responds when their working-alone session escalates.
model EmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  userId       String   @db.Uuid
  name         String
  relationship String?
  phone        String
  altPhone     String?
  /// 1 = call first.
  priority     Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([tenantId, userId])
}

enum SmsKind {
  TEXT
  CALL
}

/// Texts and voice calls waiting to go out. Bodies are rendered at sending time and the params dropped once sent.
model SmsOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String?   @db.Uuid
  toPhone   String
  kind      SmsKind   @default(TEXT)
  template  String
  params    Json      @default("{}")
  locale    String    @default("en-CA")
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, sentAt])
}

/// HR's corrections to a person's banked overtime (an opening balance, a correction). Everything else
/// in the bank comes from approved pay runs: hours banked, taken as time off, or paid out.
model LieuAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  /// Positive adds to the bank, negative takes away.
  hours       Decimal  @db.Decimal(8, 2)
  note        String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, userId])
}

enum TradeStatus {
  /// Waiting for the other person.
  PROPOSED
  /// They agreed; waiting for a supervisor.
  ACCEPTED
  APPROVED
  /// The other person said no.
  DECLINED
  /// A supervisor said no.
  DENIED
  CANCELLED
  /// A shift started or changed before it was decided.
  EXPIRED
}

/// Two people swap shifts: each takes the other's. Both must be eligible for the shift they take; a supervisor approves.
model ShiftTrade {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  fromUserId   String      @db.Uuid
  fromShiftId  String      @db.Uuid
  toUserId     String      @db.Uuid
  toShiftId    String      @db.Uuid
  status       TradeStatus @default(PROPOSED)
  note         String?
  /// Each side's eligibility and overtime when last checked.
  check        Json?
  respondedAt  DateTime?   @db.Timestamptz(3)
  decidedById  String?     @db.Uuid
  decidedAt    DateTime?   @db.Timestamptz(3)
  decisionNote String?
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  @@index([tenantId, status])
  @@index([fromShiftId])
  @@index([toShiftId])
}

/// A shared tablet at a facility where staff punch in and out with their employee number and PIN.
model Kiosk {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  facilityId  String    @db.Uuid
  name        String
  /// SHA-256 of the device's secret (shown once, when the tablet is set up).
  tokenHash   String    @unique
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  @@index([tenantId, facilityId])
}

enum ClaimStatus {
  SUBMITTED
  APPROVED
  REJECTED
  /// Paid on a pay run (payRunId).
  PAID
  WITHDRAWN
}

enum ExpenseCategory {
  MILEAGE
  MEALS
  TRAVEL
  PARKING
  SUPPLIES
  TRAINING
  OTHER
}

/// Money a person spent for work, or kilometres they drove, to be paid back (not taxed) on a pay run.
model ExpenseClaim {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  userId       String        @db.Uuid
  title        String
  status       ClaimStatus   @default(SUBMITTED)
  total        Decimal       @db.Decimal(12, 2)
  submittedAt  DateTime      @default(now()) @db.Timestamptz(3)
  decidedById  String?       @db.Uuid
  decidedAt    DateTime?     @db.Timestamptz(3)
  decisionNote String?
  payRunId     String?       @db.Uuid
  items        ExpenseItem[]

  @@index([tenantId, status])
  @@index([userId])
}

model ExpenseItem {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  claimId           String          @db.Uuid
  claim             ExpenseClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  date              DateTime        @db.Date
  category          ExpenseCategory
  description       String
  amount            Decimal         @db.Decimal(12, 2)
  /// Mileage: kilometres driven and the rate applied (cents per km).
  km                Decimal?        @db.Decimal(8, 1)
  centsPerKm        Decimal?        @db.Decimal(6, 2)
  /// GST/HST included in the amount, if the receipt shows it.
  salesTax          Decimal?        @db.Decimal(12, 2)
  receiptDocumentId String?         @db.Uuid

  @@index([claimId])
}

/// A policy staff read and sign (safety plan, code of conduct, respectful workplace…). A revision is a new row; the old one is retired.
model Policy {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  title       String
  body        String
  /// SHA-256 of title and body exactly as published.
  textSha256  String
  version     Int         @default(1)
  replacesId  String?     @db.Uuid
  /// Empty = everyone; otherwise people who hold one of these positions.
  positionIds String[]    @db.Uuid
  /// Days after publishing (or after starting) to sign it.
  dueDays     Int?
  createdById String      @db.Uuid
  publishedAt DateTime    @default(now()) @db.Timestamptz(3)
  retiredAt   DateTime?   @db.Timestamptz(3)
  acks        PolicyAck[]

  @@index([tenantId, retiredAt])
}

/// A person's signature on a policy version. Evidence: added, never changed or deleted by the app.
model PolicyAck {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  policyId   String   @db.Uuid
  policy     Policy   @relation(fields: [policyId], references: [id])
  userId     String   @db.Uuid
  signedName String
  textSha256 String
  signedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([policyId, userId])
  @@index([tenantId, userId])
}

enum LogCategory {
  HANDOVER
  MAINTENANCE
  SAFETY
  OTHER
}

/// A facility's shift log: handover notes, maintenance, safety. Added, never changed; a correction is a new entry.
model LogEntry {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  facilityId String      @db.Uuid
  authorId   String      @db.Uuid
  category   LogCategory @default(HANDOVER)
  body       String
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@index([tenantId, facilityId, createdAt])
}

/// A notice to staff: everyone, or some positions or facilities.
model Announcement {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  title       String
  body        String
  /// Empty = everyone.
  positionIds String[]           @db.Uuid
  facilityIds String[]           @db.Uuid
  pinned      Boolean            @default(false)
  expiresAt   DateTime?          @db.Timestamptz(3)
  authorId    String             @db.Uuid
  publishedAt DateTime           @default(now()) @db.Timestamptz(3)
  reads       AnnouncementRead[]

  @@index([tenantId, publishedAt])
}

model AnnouncementRead {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  readAt         DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([announcementId, userId])
}

enum ApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  OFFERED
  HIRED
  DECLINED
  WITHDRAWN
}

/// Someone applying to a job posting from the careers page. The résumé is encrypted like employee documents.
model JobApplication {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  postingId      String            @db.Uuid
  firstName      String
  lastName       String
  email          String
  phone          String?
  message        String?
  /// Certifications they hold, as they wrote them.
  certifications String?
  status         ApplicationStatus @default(NEW)
  notes          String?
  /// When they agreed to the privacy notice for applicants.
  consentAt      DateTime          @db.Timestamptz(3)
  resumeName     String?
  resumeType     String?
  resumeSize     Int?
  resumeSha256   String?
  ciphertext     Bytes?
  iv             Bytes?
  authTag        Bytes?
  wrappedKey     Bytes?
  kekId          String?
  hiredUserId    String?           @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  @@index([tenantId, postingId, status])
}

enum PayeeKind {
  PERSON
  BUSINESS
}

/// Someone paid who isn't an employee: a contract instructor, a committee or council member's honorarium. Reported on a T4A.
model Payee {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  kind           PayeeKind      @default(PERSON)
  firstName      String?
  lastName       String?
  businessName   String?
  /// Their CRA business number (9 digits, or with RT/RP and the account), for a business.
  businessNumber String?
  /// SIN, sealed with the organization's key like employees' (people only).
  sinLast3       String?
  sinCiphertext  Bytes?
  sinIv          Bytes?
  sinAuthTag     Bytes?
  sinWrappedKey  Bytes?
  sinKekId       String?
  address        Json?
  email          String?
  notes          String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  archivedAt     DateTime?      @db.Timestamptz(3)
  payments       PayeePayment[]

  @@index([tenantId])
}

/// A payment to a payee, by T4A box: 048 fees for services, 028 other income (e.g. honoraria), 020 self-employed commissions.
model PayeePayment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  payeeId     String   @db.Uuid
  payee       Payee    @relation(fields: [payeeId], references: [id])
  paidOn      DateTime @db.Date
  box         String
  amount      Decimal  @db.Decimal(12, 2)
  /// Income tax withheld (box 022), if any.
  taxWithheld Decimal  @default(0) @db.Decimal(12, 2)
  description String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, paidOn])
}

enum ReportSchedule {
  NONE
  WEEKLY
  MONTHLY
}

/// A report someone saved, optionally emailed to them each week or month (run with their access at the time).
model SavedReport {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  ownerId    String         @db.Uuid
  name       String
  reportKey  String
  /// { days } for reports that look ahead.
  params     Json           @default("{}")
  schedule   ReportSchedule @default(NONE)
  lastSentAt DateTime?      @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([tenantId, ownerId])
}

// ------------------------------------------------------------------
// PUBLIC API AND WEBHOOKS (docs/PUBLIC-API.md)
// ------------------------------------------------------------------

/// A key a city's own systems (ERP, HRIS, GIS) use to read its data through /api/v1. Only a SHA-256
/// of the key is stored; the key itself is shown once, when it's made.
model ApiKey {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  name               String
  /// The key's first characters ("fh_live_ab12cd34"), to tell keys apart. Not secret.
  prefix             String
  keyHash            String    @unique
  /// What it may read: "people:read", "schedule:read"… (services/integrations/apiKeys.ts SCOPES).
  scopes             String[]
  /// IPv4/IPv6 addresses or CIDR ranges allowed to use it. Empty = any address.
  allowedIps         String[]  @default([])
  expiresAt          DateTime? @db.Timestamptz(3)
  rateLimitPerMinute Int       @default(120)
  lastUsedAt         DateTime? @db.Timestamptz(3)
  lastUsedIp         String?
  requestCount       Int       @default(0)
  createdById        String    @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime? @db.Timestamptz(3)
  revokedById        String?   @db.Uuid
  /// The key this one replaced (rotation); the old one keeps working for a day.
  rotatedFromId      String?   @db.Uuid

  @@index([tenantId, createdAt])
}

/// A public API write's Idempotency-Key (routes/publicApi.ts): the request's fingerprint and the
/// answer, kept 24 hours so a retry gets the same answer and a reused key with another body is refused.
model ApiIdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  apiKeyId    String   @db.Uuid
  key         String
  method      String
  path        String
  /// SHA-256 of the method, path and body.
  requestHash String
  /// Null while the first request is still being handled.
  status      Int?
  response    Json?
  etag        String?
  location    String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@unique([tenantId, apiKeyId, key])
  @@index([tenantId, expiresAt])
}

/// An address on the city's own systems that FH sends signed events to (services/integrations/webhooks.ts).
model WebhookEndpoint {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @db.Uuid
  url                 String
  description         String?
  /// Event types it receives: "person.updated", "shift.published"…
  events              String[]
  /// Signing secret, sealed with the city's key (it has to be read back to sign).
  secret              Json
  /// After rotation, the old secret signs too until this moment, so receivers can switch over.
  previousSecret      Json?
  previousSecretUntil DateTime?         @db.Timestamptz(3)
  enabled             Boolean           @default(true)
  disabledAt          DateTime?         @db.Timestamptz(3)
  /// "failures" when FH turned it off after too many failed attempts in a row; "manual" otherwise.
  disabledReason      String?
  consecutiveFailures Int               @default(0)
  lastSuccessAt       DateTime?         @db.Timestamptz(3)
  lastFailureAt       DateTime?         @db.Timestamptz(3)
  createdById         String            @db.Uuid
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  deliveries          WebhookDelivery[]

  @@index([tenantId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  /// Gave up after the last attempt, or the endpoint was turned off.
  FAILED
}

/// One event for one endpoint, and how sending it went. Never holds a secret; the receiver's answer
/// is cut to 500 characters.
model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  endpointId     String                @db.Uuid
  /// The event's id: the same for every endpoint and every redelivery, so receivers can drop repeats.
  eventId        String                @db.Uuid
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  /// Not before: retries back off by pushing this forward (also a lease while one is being sent).
  nextAttemptAt  DateTime              @default(now()) @db.Timestamptz(3)
  lastAttemptAt  DateTime?             @db.Timestamptz(3)
  responseStatus Int?
  responseBody   String?
  error          String?
  durationMs     Int?
  deliveredAt    DateTime?             @db.Timestamptz(3)
  /// "<outbox event id>:<endpoint id>", so an event the outbox delivers twice is queued once.
  dedupeKey      String?
  redeliveryOfId String?               @db.Uuid
  test           Boolean               @default(false)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([tenantId, status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

// ------------------------------------------------------------------
// TRUST: FlexcityHeadquarters' own security and compliance program (Dev console only).
// No city's data: these rows describe FH. Row-level security keeps them out of every city's
// transaction (db/rls.sql, fh_only_tables). The control and framework library is code
// (services/trust/library.ts, versioned); these tables hold its state.
// ------------------------------------------------------------------

/// The state of one library control: its owner and any manual status (with the reason).
model TrustControlState {
  key           String   @id
  ownerId       String?  @db.Uuid
  /// Null = worked out from tests and evidence. PASSING | FAILING | NEEDS_EVIDENCE | NOT_APPLICABLE
  manualStatus  String?
  justification String?
  notes         String?
  updatedById   String?  @db.Uuid
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}

/// One automated test ("monitor"): who owns it and its latest result (every run updates this row).
model TrustTest {
  key           String    @id
  ownerId       String?   @db.Uuid
  enabled       Boolean   @default(true)
  lastRunAt     DateTime? @db.Timestamptz(3)
  /// PASS | FAIL | WARN | ERROR
  lastStatus    String?
  lastSummary   String?
  lastDetails   Json?
  /// The status an alert was last raised for, so a failure alerts once, not every round.
  alertedStatus String?
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
}

/// Test history: a row when a result changes, and at most one an hour while it stays the same.
model TrustTestRun {
  id         String   @id @default(uuid()) @db.Uuid
  testKey    String
  status     String
  summary    String
  /// Counts and names only: never a secret, a token or a person's details.
  details    Json?
  durationMs Int
  /// schedule | manual
  trigger    String
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([testKey, at])
  @@index([at])
}

/// Posture over time (at most hourly, and after each manual run).
model TrustScoreSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  score      Int
  /// { soc2: 72, iso27001: 64, … }
  frameworks Json
  testsPass  Int
  testsFail  Int
  testsWarn  Int
  controls   Json
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([at])
}

/// Evidence for a control: a file (sealed like employee documents), a link, a note, a test snapshot, or a CI result.
model TrustEvidence {
  id          String    @id @default(uuid()) @db.Uuid
  controlKey  String
  /// FILE | LINK | NOTE | SNAPSHOT | CI
  kind        String
  title       String
  url         String?
  note        String?
  /// CI results: PASS | FAIL
  result      String?
  fileName    String?
  contentType String?
  size        Int?
  sha256      String?
  ciphertext  Bytes?
  iv          Bytes?
  authTag     Bytes?
  wrappedKey  Bytes?
  kekId       String?
  testKey     String?
  /// When this evidence stops counting (e.g. a restore test is good for 35 days).
  validUntil  DateTime? @db.Timestamptz(3)
  addedById   String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  @@index([controlKey, createdAt])
}

model TrustEvidenceRequest {
  id          String    @id @default(uuid()) @db.Uuid
  controlKey  String
  title       String
  detail      String?
  ownerId     String?   @db.Uuid
  dueAt       DateTime  @db.Timestamptz(3)
  /// OPEN | DONE | CANCELLED
  status      String    @default("OPEN")
  evidenceId  String?   @db.Uuid
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  closedAt    DateTime? @db.Timestamptz(3)

  @@index([status, dueAt])
}

model TrustPolicy {
  id                String               @id @default(uuid()) @db.Uuid
  key               String               @unique
  title             String
  titleFr           String
  ownerId           String?              @db.Uuid
  reviewEveryMonths Int                  @default(12)
  nextReviewAt      DateTime?            @db.Timestamptz(3)
  controlKeys       String[]             @default([])
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  versions          TrustPolicyVersion[]
}

model TrustPolicyVersion {
  id           String           @id @default(uuid()) @db.Uuid
  policyId     String           @db.Uuid
  policy       TrustPolicy      @relation(fields: [policyId], references: [id])
  version      Int
  body         String
  bodyFr       String
  changeNote   String?
  /// DRAFT | APPROVED | PUBLISHED | RETIRED
  status       String           @default("DRAFT")
  createdById  String?          @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  approvedById String?          @db.Uuid
  approvedAt   DateTime?        @db.Timestamptz(3)
  publishedAt  DateTime?        @db.Timestamptz(3)
  acks         TrustPolicyAck[]

  @@unique([policyId, version])
}

/// A Dev console admin read and accepted a published policy version.
model TrustPolicyAck {
  id        String             @id @default(uuid()) @db.Uuid
  versionId String             @db.Uuid
  version   TrustPolicyVersion @relation(fields: [versionId], references: [id])
  adminId   String             @db.Uuid
  at        DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([versionId, adminId])
}

model TrustRisk {
  id                 String    @id @default(uuid()) @db.Uuid
  ref                String    @unique
  title              String
  titleFr            String?
  category           String
  description        String
  /// 1–5 each, before controls (inherent) and after (residual).
  likelihood         Int
  impact             Int
  residualLikelihood Int
  residualImpact     Int
  /// MITIGATE | ACCEPT | TRANSFER | AVOID
  treatment          String
  treatmentPlan      String?
  ownerId            String?   @db.Uuid
  controlKeys        String[]  @default([])
  vendorIds          String[]  @default([])
  dueAt              DateTime? @db.Timestamptz(3)
  reviewEveryDays    Int       @default(90)
  lastReviewedAt     DateTime? @db.Timestamptz(3)
  /// OPEN | CLOSED
  status             String    @default("OPEN")
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
}

model TrustVendor {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @unique
  purpose           String
  purposeFr         String?
  /// LOW | MEDIUM | HIGH | CRITICAL
  criticality       String
  dataAccessed      String
  personalInfo      Boolean   @default(false)
  dataLocation      String
  inCanada          Boolean   @default(false)
  website           String?
  dpaSignedAt       DateTime? @db.Timestamptz(3)
  dpaExpiresAt      DateTime? @db.Timestamptz(3)
  soc2ExpiresAt     DateTime? @db.Timestamptz(3)
  isoExpiresAt      DateTime? @db.Timestamptz(3)
  reviewEveryMonths Int       @default(12)
  lastReviewedAt    DateTime? @db.Timestamptz(3)
  nextReviewAt      DateTime? @db.Timestamptz(3)
  /// PROPOSED | ACTIVE | OFFBOARDED
  status            String    @default("ACTIVE")
  /// Built-in security questionnaire answers: { encryption: "yes", … }
  questionnaire     Json?
  score             Int?
  ownerId           String?   @db.Uuid
  controlKeys       String[]  @default([])
  notes             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
}

/// Something FH promised a customer: a contract clause, an SLA, a report, a notice window.
model TrustCommitment {
  id          String                      @id @default(uuid()) @db.Uuid
  /// The customer, when it's an organization on the platform (FH's record about it; never read by a city).
  tenantId    String?                     @db.Uuid
  customer    String
  /// SECURITY_CLAUSE | SLA_UPTIME | SUPPORT_RESPONSE | DATA_RESIDENCY | BREACH_NOTICE | PEN_TEST | REPORT_DELIVERY | QUESTIONNAIRE | CUSTOM
  kind        String
  title       String
  detail      String?
  source      String?
  dueAt       DateTime?                   @db.Timestamptz(3)
  /// NONE | MONTHLY | QUARTERLY | YEARLY
  recurrence  String                      @default("NONE")
  ownerId     String?                     @db.Uuid
  /// OPEN | MET | WAIVED (a recurring one stays OPEN with its next due date)
  status      String                      @default("OPEN")
  controlKeys String[]                    @default([])
  createdById String?                     @db.Uuid
  createdAt   DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                    @updatedAt @db.Timestamptz(3)
  fulfilments TrustCommitmentFulfilment[]

  @@index([status, dueAt])
}

model TrustCommitmentFulfilment {
  id           String          @id @default(uuid()) @db.Uuid
  commitmentId String          @db.Uuid
  commitment   TrustCommitment @relation(fields: [commitmentId], references: [id])
  dueAt        DateTime?       @db.Timestamptz(3)
  metAt        DateTime        @default(now()) @db.Timestamptz(3)
  note         String?
  evidenceId   String?         @db.Uuid
  byId         String?         @db.Uuid
}

/// Approved answers to common security questionnaire questions (city RFPs).
model TrustAnswer {
  id             String   @id @default(uuid()) @db.Uuid
  category       String
  question       String
  questionFr     String
  answer         String
  answerFr       String
  controlKeys    String[] @default([])
  lastReviewedAt DateTime @default(now()) @db.Timestamptz(3)
  reviewedById   String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

/// Reminders already sent, so each (thing, due date, days before) goes out once.
model TrustReminder {
  id         String   @id @default(uuid()) @db.Uuid
  subject    String
  dueKey     String
  daysBefore Int
  sentAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([subject, dueKey, daysBefore])
}

/// The Trust area's own feed: failing tests, reminders, overdue items. Emailed to the owner (or to every manager).
model TrustAlert {
  id        String    @id @default(uuid()) @db.Uuid
  /// test_failed | test_recovered | reminder | overdue
  kind      String
  title     String
  titleFr   String
  link      String?
  ownerId   String?   @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)
  emailedAt DateTime? @db.Timestamptz(3)

  @@index([createdAt])
  @@index([emailedAt])
}

/// One row: the Trust area's settings.
model TrustSettings {
  id           Int      @id @default(1)
  /// Residual score (likelihood × impact) at or above which a risk counts as high.
  riskAppetite Int      @default(12)
  /// Frameworks in scope; empty = all.
  frameworks   String[] @default([])
  updatedById  String?  @db.Uuid
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

/// The worker's jobs: when each last ran and finished, for the Trust tests (e.g. retention ran in the last 25 hours).
model WorkerJobRun {
  name           String    @id
  lastStartedAt  DateTime? @db.Timestamptz(3)
  lastOkAt       DateTime? @db.Timestamptz(3)
  lastErrorAt    DateTime? @db.Timestamptz(3)
  lastDurationMs Int?
}

// ------------------------------------------------------------------ Scheduling wave 2

/// A change to a published shift (times or person) and the notice it gave. When the notice is
/// shorter than the department's rule, a premium is due and flows into payroll on `payOn`.
model ShiftChange {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  shiftId       String    @db.Uuid
  /// The person the change affects.
  userId        String    @db.Uuid
  positionId    String    @db.Uuid
  /// TIME (times moved), ADDED (newly assigned), REMOVED (unassigned or cancelled).
  kind          String
  oldStartsAt   DateTime? @db.Timestamptz(3)
  oldEndsAt     DateTime? @db.Timestamptz(3)
  newStartsAt   DateTime? @db.Timestamptz(3)
  newEndsAt     DateTime? @db.Timestamptz(3)
  /// Hours between the change and the (earlier of the old and new) start.
  noticeHours   Decimal   @db.Decimal(8, 2)
  /// The rule's threshold at the time (hours of notice required).
  requiredHours Decimal?  @db.Decimal(8, 2)
  late          Boolean   @default(false)
  /// Premium: changed hours at (multiplier − 1) × rate, or a flat amount.
  premiumHours  Decimal?  @db.Decimal(8, 2)
  multiplier    Decimal?  @db.Decimal(6, 3)
  flatAmount    Decimal?  @db.Decimal(10, 2)
  /// The local date the premium is paid on (the period that contains it pays it).
  payOn         DateTime? @db.Date
  waivedAt      DateTime? @db.Timestamptz(3)
  waivedById    String?   @db.Uuid
  waiveReason   String?
  changedById   String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, payOn])
  @@index([shiftId])
  @@index([userId, createdAt])
}

/// A recurring rotation (12-hour 4-on-4-off, 2-2-3 Pitman, Monday–Friday days, custom N-week cycles).
model RotationTemplate {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  name               String
  departmentId       String?  @db.Uuid
  facilityId         String   @db.Uuid
  positionId         String   @db.Uuid
  /// Days in one cycle (7 for a week, 8 for 4-on-4-off, 14 for 2-2-3…).
  cycleDays          Int
  /// Day 0 of the cycle (local date).
  anchorDate         DateTime @db.Date
  /// [{ day, start: "07:00", end: "19:00", label?: "day" | "night" }]: an end at or before the start runs past midnight.
  pattern            Json
  /// [{ name: "A", offsetDays, userIds: [], openSlots? }]: crews start the cycle offset days later.
  crews              Json
  unpaidBreakMinutes Int?
  active             Boolean  @default(true)
  createdById        String   @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([tenantId, departmentId])
}

/// Who is on call (standby) when, per department: water/wastewater, public works, snow.
model OnCallPeriod {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  departmentId String   @db.Uuid
  userId       String   @db.Uuid
  startsAt     DateTime @db.Timestamptz(3)
  endsAt       DateTime @db.Timestamptz(3)
  note         String?
  createdById  String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([tenantId, departmentId, startsAt])
  @@index([userId, startsAt])
}

/// A department's standard week ("Summer", "School year"): slots that "Apply" turns into DRAFT
/// shifts for a week or a range (never published by itself). See services/scheduling/shiftTemplates.ts.
model ShiftTemplate {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  name           String
  departmentId   String?   @db.Uuid
  /// The local dates it's meant for (inclusive); null = no limit. Weeks outside are skipped.
  validFrom      DateTime? @db.Date
  validTo        DateTime? @db.Date
  active         Boolean   @default(true)
  /// With the organization's automatic drafts on, the worker keeps this many weeks ahead drafted (0 = never).
  autoWeeksAhead Int       @default(0)
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  slots        ShiftTemplateSlot[]
  applications ShiftTemplateApplication[]

  @@index([tenantId, departmentId])
}

/// One line of a standard week: these days, these times, this position at this facility, this many people.
model ShiftTemplateSlot {
  id                 String @id @default(uuid()) @db.Uuid
  tenantId           String @db.Uuid
  templateId         String @db.Uuid
  /// 0 = Sunday … 6 = Saturday, in the facility's time zone.
  daysOfWeek         Int[]
  /// Minutes after local midnight; an end past 1440 runs past midnight.
  startMinute        Int
  endMinute          Int
  facilityId         String @db.Uuid
  positionId         String @db.Uuid
  /// People needed: one draft shift each.
  headcount          Int    @default(1)
  unpaidBreakMinutes Int?
  sortOrder          Int    @default(0)

  template ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// One "Apply" of a template to a range (or the worker's automatic drafts ahead): what it made, for undo.
model ShiftTemplateApplication {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  templateId  String    @db.Uuid
  /// Local dates, [fromDate, toDate).
  fromDate    DateTime  @db.Date
  toDate      DateTime  @db.Date
  automatic   Boolean   @default(false)
  createdById String?   @db.Uuid
  created     Int       @default(0)
  /// Occurrences skipped or flagged: [{ slotId, date, code }] (HOLIDAY_CLOSED, FACILITY_CLOSED, OUTSIDE_HOURS, STAT_HOLIDAY).
  notes       Json      @default("[]")
  undoneAt    DateTime? @db.Timestamptz(3)
  undoneById  String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  template ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId, templateId, createdAt])
}

enum ShiftPreferenceKind {
  PREFER
  AVOID
}

/// Shifts a person would like (or would rather not) work: a soft wish, unlike availability (can work).
/// Seen only by the person and the schedulers of their department; Fill the schedule weighs it.
model ShiftPreference {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  userId      String              @db.Uuid
  kind        ShiftPreferenceKind
  /// Empty = any day. 0 = Sunday.
  daysOfWeek  Int[]
  /// A time window (minutes after local midnight); null = any time. A shift matches when it starts inside it.
  startMinute Int?
  endMinute   Int?
  positionId  String?             @db.Uuid
  facilityId  String?             @db.Uuid
  note        String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([tenantId, userId])
}

/// The most a person would like to work in a week (a wish; their hard weekly cap is User.weeklyMaxHours).
model ShiftPreferenceLimit {
  userId         String   @id @db.Uuid
  tenantId       String   @db.Uuid
  maxWeeklyHours Decimal? @db.Decimal(5, 2)
  maxDaysPerWeek Int?
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([tenantId])
}

// ---------------------------------------------------------------- Team messaging (services/messaging)

enum ConversationKind {
  DIRECT // two people
  SHIFT // everyone working the same shift at a facility; archived after it ends
  DEPARTMENT // everyone in a department and its managers
  GROUP // a group a supervisor or HR made
}

/// A conversation. Its messages are sealed with one data key, wrapped by the organization's key (KMS).
model Conversation {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  kind          ConversationKind
  /// Groups: the name people gave it. Shift and department conversations are named from their shift or department.
  title         String?
  /// DIRECT: the two people's ids, sorted, joined by ":" (one conversation per pair).
  directKey     String?
  /// SHIFT: "<facilityId>|<startsAt ISO>|<endsAt ISO>" of the shift it was made from (one per shift).
  shiftKey      String?
  /// DEPARTMENT: the department (one conversation per department).
  departmentId  String?              @db.Uuid
  createdById   String?              @db.Uuid
  /// SHIFT: archived (read-only) from this moment, some hours after the shift ends.
  closesAt      DateTime?            @db.Timestamptz(3)
  archivedAt    DateTime?            @db.Timestamptz(3)
  lastMessageAt DateTime?            @db.Timestamptz(3)
  /// The conversation's data key, wrapped by the organization's key (never stored unwrapped).
  wrappedKey    Bytes
  kekId         String
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  members       ConversationMember[]
  messages      Message[]

  @@unique([tenantId, directKey])
  @@unique([tenantId, shiftKey])
  @@unique([tenantId, departmentId])
  @@index([tenantId, lastMessageAt])
}

model ConversationMember {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  /// GROUP: the person who made it (and HR) can add and remove people.
  owner          Boolean      @default(false)
  /// Read receipt: everything up to this moment has been seen.
  lastReadAt     DateTime?    @db.Timestamptz(3)
  muted          Boolean      @default(false)
  joinedAt       DateTime     @default(now()) @db.Timestamptz(3)
  /// Added after the conversation was made: they see only messages sent from this moment. Null = the whole history (there from the start).
  historyFrom    DateTime?    @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([tenantId, userId])
}

/// One message. The text is sealed (AES-256-GCM) with the conversation's data key; the AAD ties it to this row.
model Message {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  conversationId     String             @db.Uuid
  authorId           String             @db.Uuid
  ciphertext         Bytes?
  iv                 Bytes?
  authTag            Bytes?
  /// The first version, kept when the author edits (for an investigation), sealed the same way.
  originalCiphertext Bytes?
  originalIv         Bytes?
  originalAuthTag    Bytes?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  editedAt           DateTime?          @db.Timestamptz(3)
  /// Removed by its author (or HR): shown as "message removed"; the sealed text stays until the retention period ends.
  deletedAt          DateTime?          @db.Timestamptz(3)
  deletedById        String?            @db.Uuid
  conversation       Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachment         MessageAttachment?

  @@index([conversationId, createdAt])
  @@index([tenantId, authorId])
}

/// A file sent with a message (PDF, PNG, JPEG or WebP, checked by content), sealed with the conversation's key.
model MessageAttachment {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @db.Uuid
  messageId      String  @unique @db.Uuid
  /// Older rows only: the file name before it was sealed. The retention run seals it and clears this.
  fileName       String?
  /// The file name, sealed with the conversation's key (AAD part "name").
  nameCiphertext Bytes?
  nameIv         Bytes?
  nameAuthTag    Bytes?
  contentType    String
  size           Int
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  message        Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum MessageReportStatus {
  OPEN
  CLOSED
}

/// A message reported to HR under the organization's workplace harassment policy.
model MessageReport {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  messageId      String              @db.Uuid
  conversationId String              @db.Uuid
  reporterId     String              @db.Uuid
  reason         String
  status         MessageReportStatus @default(OPEN)
  closedAt       DateTime?           @db.Timestamptz(3)
  closedById     String?             @db.Uuid
  closingNote    String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  @@index([tenantId, status])
  @@index([conversationId])
}

/// HR opened a conversation they're not in, for an investigation: who, why, until when. Append-only.
model ConversationAccess {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  reason         String
  reportId       String?  @db.Uuid
  openedAt       DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)

  @@index([conversationId, userId])
}

// ---------------------------------------------------------------- Staff surveys (services/surveys)

enum SurveyKind {
  PULSE // short check-in, always anonymous
  EXIT // one person who is leaving (Offboarding), named and said so up front
}

/// The one way an anonymous survey's results may be broken down, chosen when it's made and fixed once sent.
enum SurveyBreakdown {
  NONE
  DEPARTMENT
  POSITION
}

model Survey {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  kind          SurveyKind
  title         String
  intro         String?
  /// Anonymous: who answered is kept apart from the answers, which carry no person, time or order.
  anonymous     Boolean         @default(true)
  /// [{ id, type: RATING | CHOICE | MULTI | TEXT, text, options?: string[], required }]
  questions     Json
  /// { departmentIds: [], positionIds: [] } (both empty = everyone) or, for EXIT, the person.
  audience      Json            @default("{}")
  /// A manager's survey: the departments it is limited to (empty = HR's, whole organization).
  departmentIds String[]        @db.Uuid
  /// EXIT: the offboarding it belongs to and the person.
  offboardingId String?         @db.Uuid
  subjectUserId String?         @db.Uuid
  /// Repeated pulses share a series, for the trend.
  seriesId      String          @db.Uuid
  opensAt       DateTime        @db.Timestamptz(3)
  closesAt      DateTime        @db.Timestamptz(3)
  /// Null = draft. Invitations are made when it's published.
  publishedAt   DateTime?       @db.Timestamptz(3)
  closedAt      DateTime?       @db.Timestamptz(3)
  /// The smallest group whose results are shown, fixed when it was published.
  minGroup      Int             @default(5)
  /// The only breakdown its results offer (one dimension, so groups can't be subtracted across two).
  breakdown     SurveyBreakdown @default(DEPARTMENT)
  remindersSent Int             @default(0)
  createdById   String          @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([tenantId, seriesId])
  @@index([tenantId, closesAt])
}

/// Who was asked and whether they've answered (to stop duplicates and send reminders). No time is kept.
model SurveyInvite {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  surveyId  String  @db.Uuid
  userId    String  @db.Uuid
  responded Boolean @default(false)

  @@unique([surveyId, userId])
  @@index([tenantId, userId])
}

/// One set of answers. Anonymous: no person, no time; department and position only where the group is big enough.
model SurveyResponse {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  surveyId     String  @db.Uuid
  /// Named (exit) surveys only.
  userId       String? @db.Uuid
  /// Only the survey's breakdown dimension is kept (the other stays empty).
  departmentId String? @db.Uuid
  positionId   String? @db.Uuid
  /// { [questionId]: 1..5 | "option" | ["option", …] | "text" }
  answers      Json

  @@index([surveyId])
}

enum BidRoundKind {
  SHIFTS
  LINES
}

enum BidRoundStatus {
  /// Accepting rankings between opensAt and closesAt.
  OPEN
  /// Closed: awards proposed in seniority order, waiting for a manager to review and confirm.
  REVIEW
  /// Confirmed: shifts assigned and published, the rest on the Shift Board.
  AWARDED
  CANCELLED
}

enum SeniorityBasis {
  DATE
  HOURS
}

/// How a bid round hands out awards.
enum BidAwardOrder {
  /// One award per person per pass, most senior first; then another pass (round robin).
  ROUND_ROBIN
  /// Each person, most senior first, gets all their awards (up to the maximum) before the next person.
  SENIOR_FIRST
}

/// A shift bid round (only where the organization uses seniority): staff rank shifts or lines, and at
/// the close each gets their highest-ranked choice still open that they can work, in seniority order.
/// See services/scheduling/bidding.ts.
model BidRound {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @db.Uuid
  name               String
  kind               BidRoundKind
  departmentId       String?        @db.Uuid
  /// Who may bid: people holding one of these positions.
  positionIds        String[]       @db.Uuid
  opensAt            DateTime       @db.Timestamptz(3)
  closesAt           DateTime       @db.Timestamptz(3)
  status             BidRoundStatus @default(OPEN)
  maxAwardsPerPerson Int            @default(1)
  /// Seniority by date (then hours) or by hours (then date), as the collective agreement says.
  seniorityBasis     SeniorityBasis @default(DATE)
  /// One at a time in seniority order (round robin, default) or most senior first takes all their awards.
  awardOrder         BidAwardOrder  @default(ROUND_ROBIN)
  /// Lines built from this weekly template over [rangeFrom, rangeTo).
  templateId         String?        @db.Uuid
  rangeFrom          DateTime?      @db.Date
  rangeTo            DateTime?      @db.Date
  openedNotifiedAt   DateTime?      @db.Timestamptz(3)
  closedAt           DateTime?      @db.Timestamptz(3)
  confirmedAt        DateTime?      @db.Timestamptz(3)
  confirmedById      String?        @db.Uuid
  cancelledAt        DateTime?      @db.Timestamptz(3)
  createdById        String         @db.Uuid
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  items    BidItem[]
  choices  BidChoice[]
  entrants BidEntrant[]
  awards   BidAward[]

  @@index([tenantId, status, closesAt])
}

/// One thing to bid on: a single shift, or a line (the same shift on the same days over a season).
model BidItem {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  roundId       String   @db.Uuid
  /// Draft shifts it is made of (unassigned until the round is confirmed).
  shiftIds      String[] @db.Uuid
  positionId    String   @db.Uuid
  facilityId    String   @db.Uuid
  firstStartsAt DateTime @db.Timestamptz(3)
  lastEndsAt    DateTime @db.Timestamptz(3)
  /// Lines: { daysOfWeek, startMinute, endMinute }.
  meta          Json     @default("{}")
  sortOrder     Int      @default(0)

  round BidRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
}

/// A person's ranking: 1 = first choice. Seen by the person, the round's managers and, after the close, union stewards.
model BidChoice {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  roundId   String   @db.Uuid
  userId    String   @db.Uuid
  itemId    String   @db.Uuid
  rank      Int
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  round BidRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId, itemId])
  @@index([roundId, userId])
}

/// Someone who bid, as they stood at the close: their seniority (snapshot), place in the order, and
/// what happened to each choice ([{ itemId, rank, result, code?, pass? }]).
model BidEntrant {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  roundId        String    @db.Uuid
  userId         String    @db.Uuid
  seniorityRank  Int
  seniorityDate  DateTime? @db.Date
  seniorityHours Decimal   @default(0) @db.Decimal(10, 2)
  hireDate       DateTime? @db.Date
  /// The recorded deterministic last tie-break (a hash of the round and the person).
  tiebreak       String
  outcomes       Json      @default("[]")
  notifiedAt     DateTime? @db.Timestamptz(3)

  round BidRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
}

/// Who gets an item: proposed in seniority order at the close, or set by a manager (with a reason).
model BidAward {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  roundId        String   @db.Uuid
  itemId         String   @db.Uuid
  userId         String   @db.Uuid
  /// Round-robin pass it was won in (1 = everyone's first award), and the winner's rank for it.
  pass           Int      @default(1)
  choiceRank     Int?
  overridden     Boolean  @default(false)
  overrideReason String?
  overriddenById String?  @db.Uuid
  previousUserId String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  round BidRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, itemId])
}

/// FH's "What's new" notes, written in the Dev console (routes/platform/updates.ts). FH's own
/// content, not an organization's: written only with no organization chosen, and inside an
/// organization's session readable only when it targets that organization or all (db/rls.sql).
model ReleaseNote {
  id          String       @id @default(uuid()) @db.Uuid
  titleEn     String
  titleFr     String
  /// Plain text; lines starting with "- " or "1. " are list items (no HTML, ever).
  bodyEn      String
  bodyFr      String
  /// Who sees it: people holding one of these roles (empty = everyone).
  roles       AccessRole[]
  /// Which organizations (empty = all). Release rings chosen in the console are resolved into this list when saved.
  tenantIds   String[]     @db.Uuid
  ringIds     String[]     @db.Uuid
  /// When it appears (now or later).
  publishAt   DateTime     @db.Timestamptz(3)
  /// null while a draft.
  publishedAt DateTime?    @db.Timestamptz(3)
  /// The live "something new" signal went out (at publishing, or by the worker once publishAt passed).
  announcedAt DateTime?    @db.Timestamptz(3)
  withdrawnAt DateTime?    @db.Timestamptz(3)
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  reads       ReleaseNoteRead[]

  @@index([publishAt])
}

/// Someone saw a note (dismissing the sheet counts): shown once per person.
model ReleaseNoteRead {
  tenantId String      @db.Uuid
  userId   String      @db.Uuid
  noteId   String      @db.Uuid
  readAt   DateTime    @default(now()) @db.Timestamptz(3)
  note     ReleaseNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([tenantId, readAt])
}

/// Release rings: groups of organizations that get feature releases in turn (Pilot, Early, General).
/// FH's own records: read and written only with no organization chosen (db/rls.sql fh_only).
model ReleaseRing {
  id        String              @id @default(uuid()) @db.Uuid
  name      String              @unique
  /// Order of progression: lower rings go first.
  position  Int
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  members   ReleaseRingMember[]
}

/// An organization is in at most one ring.
model ReleaseRingMember {
  tenantId String      @id @db.Uuid
  ringId   String      @db.Uuid
  addedAt  DateTime    @default(now()) @db.Timestamptz(3)
  ring     ReleaseRing @relation(fields: [ringId], references: [id], onDelete: Cascade)

  @@index([ringId])
}

/// A bundle of feature switches to turn on (or off), ring by ring.
model Release {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  /// What changes, in words, for the advance notice to HR admins.
  summaryEn   String
  summaryFr   String
  /// { featureKey: true | false }
  features    Json
  createdById String         @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  stages      ReleaseStage[]
}

/// A release for one ring, now or at a set time. SCHEDULED → APPLIED → ROLLED_BACK, or CANCELLED.
model ReleaseStage {
  id           String          @id @default(uuid()) @db.Uuid
  releaseId    String          @db.Uuid
  ringId       String          @db.Uuid
  scheduledAt  DateTime        @db.Timestamptz(3)
  /// HR admins hear about it this many days before (or at once when it's sooner).
  noticeDays   Int             @default(7)
  status       String          @default("SCHEDULED")
  appliedAt    DateTime?       @db.Timestamptz(3)
  rolledBackAt DateTime?       @db.Timestamptz(3)
  createdById  String          @db.Uuid
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  release      Release         @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  changes      ReleaseChange[]

  @@unique([releaseId, ringId])
  @@index([status, scheduledAt])
}

/// One organization's part of a stage: what it gets, what it kept (its own choice wins), what it had
/// before (for undoing). Readable by that organization (its HR admins see what's coming); FH's otherwise.
model ReleaseChange {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  stageId      String       @db.Uuid
  releaseId    String       @db.Uuid
  titleEn      String
  titleFr      String
  summaryEn    String
  summaryFr    String
  /// { featureKey: value } the release sets here.
  features     Json
  /// Keys left alone because this organization's switch was chosen on purpose (decided again when applied).
  skipped      String[]     @default([])
  /// { featureKey: value before, or null when it was on its default } — what undoing restores.
  previous     Json?
  scheduledAt  DateTime     @db.Timestamptz(3)
  /// PLANNED → APPLIED → ROLLED_BACK, or CANCELLED.
  status       String       @default("PLANNED")
  noticeSentAt DateTime?    @db.Timestamptz(3)
  appliedAt    DateTime?    @db.Timestamptz(3)
  rolledBackAt DateTime?    @db.Timestamptz(3)
  stage        ReleaseStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, tenantId])
  @@index([tenantId, status])
  @@index([status, scheduledAt])
}

/// Planned maintenance, announced from the Dev console: a banner for everyone during the window and a
/// heads-up before it, and notices to HR admins (in-app and email) when scheduled and a day before.
/// Informational only: nothing is switched off. FH's content, read like What's new notes (db/rls.sql fh_published).
model MaintenanceWindow {
  id               String    @id @default(uuid()) @db.Uuid
  startsAt         DateTime  @db.Timestamptz(3)
  endsAt           DateTime  @db.Timestamptz(3)
  messageEn        String
  messageFr        String
  /// Which organizations (empty = all).
  tenantIds        String[]  @db.Uuid
  ringIds          String[]  @db.Uuid
  /// HR admins were told when it was scheduled / a day before (worker; per organization it checks its own notices too).
  noticeSentAt     DateTime? @db.Timestamptz(3)
  reminderSentAt   DateTime? @db.Timestamptz(3)
  cancelledAt      DateTime? @db.Timestamptz(3)
  createdById      String    @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  @@index([endsAt])
}
