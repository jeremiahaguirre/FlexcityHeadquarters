// Flexcity — aquatic staff management
//
// Conventions
// - Every tenant-scoped table carries `tenantId` so Postgres row-level security
//   (db/rls.sql) can isolate tenants without joins.
// - All instants are `@db.Timestamptz(3)`. Local-time reasoning (work days,
//   pay weeks, availability) always uses the Facility's IANA timezone.
// - Payroll-bearing rows use `onDelete: Restrict`. People are never hard-deleted;
//   see services/privacy/erasure.ts for retention-aware anonymization.
// - Money is Decimal, never Float.
// - Union Hub data is NOT in this schema. It lives in the `union_hub` Postgres
//   schema (db/union_hub.sql), reachable only through a separate DB role.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------

enum Province {
  BC
  AB
  SK
  MB
  ON
  QC
  NB
  NS
  PE
  NL
  YT
  NT
  NU
}

/// Permission roles (what a user may DO in the app). A user may hold several.
/// What a user may WORK is modelled separately by Position + certifications.
enum AccessRole {
  HR_ADMIN
  AQUATIC_SUPERVISOR
  HEAD_LIFEGUARD
  STAFF
  FRONT_DESK
  UNION_STEWARD
  /// General city employee (water works, maintenance, parks…): everyday work screens, nothing aquatic.
  EMPLOYEE
}

enum EmploymentStatus {
  FULL_TIME
  PART_TIME
  CASUAL
  ON_CALL
  VOLUNTEER
}

enum UserStatus {
  ACTIVE
  INACTIVE // seasonal / away at school — not billed, data retained
  TERMINATED
}

enum ShadowTier {
  A_SQUAD
  B_SQUAD
  C_SQUAD
  UNASSIGNED
}

enum ShiftType {
  STANDARD
  CUSTOM // e.g. private rental
  MANDATORY // e.g. in-service training
}

/// Lifecycle only. Claim/swap state lives on ShiftOffer, not here.
enum AccommodationStatus {
  ACTIVE
  CLOSED
}

enum CareStatus {
  OFFERED
  CHECKED_IN
  DECLINED
}

enum OvertimeEntryKind {
  ACCEPTED
  REFUSED
  NO_ANSWER
}

enum OnboardingOwner {
  HR
  SUPERVISOR
  EMPLOYEE
}

enum OnboardingKind {
  CHECK
  TRAINING
  ACKNOWLEDGEMENT
  DOCUMENT
  TASK
}

enum OnboardingStatus {
  COMPLETE
  WAIVED
}

enum DisciplineLevel {
  COACHING
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
  SUSPENSION
  TERMINATION
}

enum ConductCategory {
  SAFETY_PROCEDURE
  POLICY
  CONDUCT
  PERFORMANCE
  COMMENDATION
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OfferSource {
  OPEN_SHIFT // unassigned shift posted to the board
  SWAP // assigned shift the holder wants to give away
}

enum OfferStatus {
  OPEN
  PENDING_APPROVAL // claimant would incur overtime (or other soft rule) — supervisor decides
  COMPLETED
  DENIED
  CANCELLED
}

enum TimeOffType {
  VACATION
  SICK // statutory sick leave — protected
  PROTECTED_LEAVE // family responsibility, bereavement, jury duty, etc.
  UNPAID_PERSONAL
  OTHER
  /// Taken from banked overtime (time in lieu).
  LIEU
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum PunchLocationStatus {
  VERIFIED
  OUTSIDE_RADIUS
  LOW_ACCURACY
  NO_LOCATION
  FACILITY_NOT_CONFIGURED
}

enum PunchStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PoolBodyKind {
  POOL
  LEISURE_POOL
  HOT_TUB
  WADING_POOL
  WAVE_POOL
  SPLASH_PAD
}

enum PoolBodyStatus {
  OPEN
  CLOSURE_RECOMMENDED // system detected out-of-range reading, awaiting human confirmation
  CLOSED
}

enum ReliabilityEventType {
  LATE_PUNCH
  NO_SHOW
  MISSED_IN_SERVICE
  LATE_DROP // gave away a shift with < 24h notice
  PICKED_UP_SHIFT
}

enum PayCodeKey {
  REGULAR
  OVERTIME_1_5
  OVERTIME_2_0
  STAT_WORKED
  STAT_HOLIDAY_PAY
  SHIFT_PREMIUM
  VACATION_PAY
  /// Minimum call-in / reporting pay: the top-up when someone worked less than the minimum.
  REPORTING_PAY
  /// Late schedule change premium (collective agreement notice rule).
  SCHEDULE_CHANGE_PREMIUM
  /// On-call / standby pay.
  STANDBY_PAY
  /// Call-back minimum top-up when someone on call is called in.
  CALLBACK_PAY
}

enum VacationPayMode {
  PAY_EACH_PERIOD
  ACCRUE
}

/// Which day an organization closes for a statutory holiday that falls on a weekend.
/// STATUTORY: the day the law fixes (the holiday itself, or the law's own substitute such as
/// July 2 when Canada Day is a Sunday). NEXT_WEEKDAY: the next weekday that isn't already a
/// holiday, as most municipal collective agreements do (Christmas on a Saturday → Monday).
enum HolidayObservance {
  STATUTORY
  NEXT_WEEKDAY
}

/// What a person gets when a statutory holiday falls on their own day off (services/payroll/holidayRules.ts).
enum HolidayOffDayRule {
  /// Another day off with holiday pay.
  SUBSTITUTE
  /// Holiday pay for the day, no extra day off.
  PAY
}

/// How a holiday's date moves when it falls on a weekend, by law.
enum HolidayKind {
  /// Kept on its date.
  ACTUAL
  /// The law moves it for everyone to `observedOn` (Canada Day on a Sunday → July 2).
  MOVED
  /// The law moves it to `observedOn` only for people who don't usually work that day
  /// (Quebec: the Fête nationale on a Sunday → June 25 for those who don't work Sundays).
  MOVED_IF_OFF
}

// ------------------------------------------------------------------
// TENANCY
// ------------------------------------------------------------------

model Tenant {
  /// Set by FH: nobody can sign in or use the organization's pages until it's cleared.
  disabledAt            DateTime?          @db.Timestamptz(3)
  disabledReason        String?
  /// Offboarded (contract ended): disabled, and its data is deleted after this date.
  offboardedAt          DateTime?          @db.Timestamptz(3)
  deleteAfter           DateTime?          @db.Date
  /// After offboarding, the organization's administrators can still sign in, only to download
  /// their full data export, until this moment (normally the deletion date).
  exportUntil           DateTime?          @db.Timestamptz(3)
  id                    String             @id @default(uuid()) @db.Uuid
  name                  String
  subdomain             String             @unique
  logoUrl               String?
  /// { primary, primaryHover, primaryContrast, accent } — injected as CSS variables
  themeColors           Json               @default("{}")
  defaultLocale         String             @default("en-CA")
  /// How clock times are shown: "auto" (the language's usual style), "12h" or "24h".
  timeFormat            String             @default("auto")
  /// 0 = Sunday ... 6 = Saturday, in each facility's local time
  payWeekStartDay       Int                @default(0)
  vacationPayMode       VacationPayMode    @default(PAY_EACH_PERIOD)
  /// Years to keep payroll records after the end of the tax year they relate to.
  /// CRA requires 6; default adds a year of margin.
  payrollRetentionYears Int                @default(7)
  /// Statutory holidays on a weekend: close on the day the law fixes, or on the next weekday.
  holidayObservance     HolidayObservance  @default(STATUTORY)
  /// A holiday on someone's day off: substitute day or pay. Null = each province's default.
  holidayOffDayRule     HolidayOffDayRule?
  /// Direct deposit and remittance details: { businessNumber, originatorId, originatorShortName,
  /// originatorLongName, destinationDataCentre, returnsInstitution, returnsTransit, returnsAccount (sealed),
  /// employerAddress, twoPersonApproval, requirePasskey }.
  payrollSettings       Json               @default("{}")
  /// General-ledger accounts payroll posts to: { wages, employerCpp, employerEi, employerBenefits,
  /// cppPayable, eiPayable, taxPayable, pensionPayable, unionDuesPayable, benefitsPayable, netPayClearing }.
  accountingSettings    Json               @default("{}")
  /// How long routine records are kept: { notificationsDays, emailLogDays }. Missing = the defaults.
  retentionSettings     Json               @default("{}")
  /// Feature switches set from the FH Dev console: { featureKey: boolean }.
  /// Missing keys use the defaults in src/services/platform/features.ts.
  features              Json               @default("{}")
  /// Feature switches chosen on purpose for this organization (by the Dev console, or by the
  /// organization itself, e.g. seniority): a release never changes these (services/platform/releases.ts).
  featureChoices        String[]           @default([])
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  facilities        Facility[]
  users             User[]
  positions         Position[]
  departments       Department[]
  ssoConnection     SsoConnection?
  ruleOverrides     RuleOverride[]
  payCodeMappings   PayCodeMapping[]
  /// Dev console per-role customization: { ROLE: { grant: [], revoke: [], hideMenu: [] } }.
  roleOverrides     Json             @default("{}")
  /// Overtime equalization: { countRefusals, clause, periodStartMonth }.
  overtimePolicy    Json             @default("{}")
  /// Care after critical incidents: { eap: "Employee assistance: 1-800-…" }.
  careSettings      Json             @default("{}")
  /// Shares anonymous measures with other cities (and sees theirs).
  benchmarkOptIn    Boolean          @default(false)
  /// Access levels that must sign in with a passkey as a second factor.
  mfaRoles          AccessRole[]     @default([])
  /// Whether a one-time code by email or text counts as the second factor (passkeys always do).
  mfaCodes          Boolean          @default(true)
  /// Winter operations, set by the city's managers: { season: { start: "11-01", end: "04-15" },
  /// callOuts: { responseMinutes, minRestHours }, patrols: { maxShiftHours } }.
  winterSettings    Json             @default("{}")
  /// Public sign-up portal: { enabled, terms, termsFr, payment, paymentFr, privacyContact }.
  signupSettings    Json             @default("{}")
  /// Work rules for scheduling and pay (services/scheduling/workRules.ts): unpaid meal breaks,
  /// minimum call-in pay, schedule-change notice and premiums, shift premium rules, standby and
  /// call-back, with per-department overrides where collective agreements differ.
  workRules         Json             @default("{}")
  /// Team messaging (services/messaging/policy.ts): { staffDirect, minorDirect, pushPreview, shiftArchiveHours }.
  messagingSettings Json             @default("{}")
  /// Staff surveys (services/surveys): { minGroup, managersCreate }.
  surveySettings    Json             @default("{}")
}

/// Employment-standards province follows the WORK LOCATION, so it lives here,
/// not on Tenant (a YMCA association can span provinces).
model Facility {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @db.Uuid
  name                String
  province            Province
  timezone            String // IANA, e.g. "America/Vancouver"
  latitude            Decimal?         @db.Decimal(9, 6)
  longitude           Decimal?         @db.Decimal(9, 6)
  geoRadiusM          Int              @default(150)
  costCenter          String? // e.g. "CC-405-AQUATICS" for payroll export
  /// Facility size for public-sector pricing: 1 seasonal/outdoor (×0.4), 2 standard, 3 major complex (×2); null = not billed.
  billingTier         Int?
  /// Overrides this facility's price (cents per month) when set.
  billingMonthlyCents Int?
  /// Deck rotation: minutes on one station before moving on.
  rotationMinutes     Int              @default(30)
  /// Fatigue limit: continuous minutes on stations (across rotations) before a break.
  maxOnChairMinutes   Int              @default(120)
  /// Demand forecast: indoor, outdoor or both, and what kind of place it is. They set how the
  /// weather is expected to move attendance until enough history has been learned.
  exposure            FacilityExposure @default(INDOOR)
  venueKind           VenueKind        @default(POOL)
  /// Environment and Climate Change Canada city forecast site (e.g. "bc-48"), set by hand.
  weatherSite         String?
  /// The nearest forecast site to the coordinates, found by the weather job when none is set by hand.
  weatherSiteAuto     String?
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  shifts       Shift[]
  poolBodies   PoolBody[]
  timePunches  TimePunch[]
  incidents    IncidentReport[]
  deckStations DeckStation[]
  openHours    FacilityHours[]

  @@index([tenantId])
}

/// When a facility is open, by weekday (several blocks a day allowed), and the fewest lifeguards
/// on deck at any open hour, whatever the bather count. The forecast and its draft shifts use it.
model FacilityHours {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  facilityId   String   @db.Uuid
  /// 0 = Sunday, facility local time.
  dayOfWeek    Int
  opensMinute  Int
  closesMinute Int
  minGuards    Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([tenantId, facilityId, dayOfWeek])
}

enum FacilityExposure {
  INDOOR
  OUTDOOR
  MIXED
}

enum VenueKind {
  POOL
  PARK
  BEACH
  ARENA
  COMMUNITY_CENTRE
  OTHER
}

/// A one-off or yearly event that changes how many people come: Canada Day fireworks, a swim
/// meet, a tournament, a festival. For one facility, or every facility in the city (facilityId null).
/// Either extra people expected at a time while it runs, or a percentage up or down, or both.
model SpecialEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  facilityId   String?  @db.Uuid
  name         String
  startsOn     DateTime @db.Date
  endsOn       DateTime @db.Date
  /// Minutes after midnight, facility local time; both null = all day.
  startMinute  Int?
  endMinute    Int?
  extraPeople  Int?
  /// -90 to +300: expected attendance changes by this percentage.
  percent      Int?
  /// Happens every year on the same dates.
  recursYearly Boolean  @default(false)
  notes        String?
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([tenantId, facilityId])
}

/// An Environment and Climate Change Canada city forecast site: public reference data shared by
/// every organization (no organization's data here), and how the last fetch went.
model WeatherSite {
  site        String    @id
  nameEn      String
  nameFr      String?
  latitude    Float
  longitude   Float
  /// The nearest climate station with daily data, for observed weather.
  climateId   String?
  lastFetchAt DateTime? @db.Timestamptz(3)
  lastOkAt    DateTime? @db.Timestamptz(3)
  failures    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
}

/// Daily forecast for a site, cached from ECCC (kept a week). Shared by every organization near it.
model WeatherForecastDay {
  site      String
  date      DateTime @db.Date
  high      Int?
  low       Int?
  /// Chance of precipitation, %.
  pop       Int?
  iconCode  Int?
  /// sunny | partly | cloudy | showers | rain | thunder | snow | mixed | fog
  condition String
  summaryEn String?
  summaryFr String?
  fetchedAt DateTime @db.Timestamptz(3)

  @@id([site, date])
}

/// What the weather was on a day at a site: from ECCC daily climate data, or the day's own forecast
/// until climate data comes in. The forecast learns from it how attendance responds to the weather.
model WeatherObservation {
  site      String
  date      DateTime @db.Date
  high      Float?
  low       Float?
  precipMm  Float?
  snowCm    Float?
  condition String
  /// "climate" (ECCC daily climate data) or "forecast" (the day's forecast, until climate data comes in)
  source    String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([site, date])
}

/// Tenant-specific overrides of provincial rules, e.g. a collective agreement
/// that pays OT after 7.5h/day. Effective-dated so history recalculates correctly.
model RuleOverride {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  province      Province?
  ruleKey       String // e.g. "dailyOvertimeHours"
  value         Json
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  source        String? // e.g. "CUPE Local 338 CBA art. 14.02"

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, ruleKey, effectiveFrom])
}

// ------------------------------------------------------------------
// PEOPLE
// ------------------------------------------------------------------

model User {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  roles            AccessRole[]
  status           UserStatus       @default(ACTIVE)
  employmentStatus EmploymentStatus
  shadowTier       ShadowTier       @default(UNASSIGNED) // set by a manager, never automatically

  firstName          String
  lastName           String
  /// The name they go by, when it differs from their legal first name.
  preferredName      String?
  email              String
  phone              String?
  locale             String    @default("en-CA")
  /// Needed only to apply young-worker rules. Not exported anywhere.
  dateOfBirth        DateTime? @db.Date
  /// HR confirmed this person is of the age of majority or older (no birth date needed for adult-only
  /// rules such as messaging's rule of two). A birth date on file always wins. HR only; never shown to staff.
  adultConfirmedAt   DateTime? @db.Timestamptz(3)
  adultConfirmedById String?   @db.Uuid
  /// How it was confirmed (e.g. "ID checked at hire").
  adultConfirmedNote String?
  /// Identity-provider subject this account is bound to after its first single sign-on ("issuer|subject").
  ssoSubject         String?
  /// Mobile number confirmed with a texted code (E.164), for urgent texts and calls when the city turns them on.
  smsPhone           String?
  smsVerifiedAt      DateTime? @db.Timestamptz(3)
  /// Also text me about open shifts starting within the next 24 hours.
  smsUrgentShifts    Boolean   @default(false)
  /// The person agreed to bank overtime as time in lieu instead of being paid for it (where the city allows it).
  bankOvertime       Boolean   @default(false)
  bankOvertimeAt     DateTime? @db.Timestamptz(3)
  /// Private calendar feed: SHA-256 of the link's secret (the link itself is shown once).
  calendarTokenHash  String?   @unique
  calendarTokenAt    DateTime? @db.Timestamptz(3)
  /// PIN for punching at a facility's shared kiosk (hashed like a password).
  kioskPinHash       String?
  /// The employer's HR/payroll system ID — used in payroll exports.
  employeeNumber     String?
  /// The organization's own system's id for this person (HRIS/ERP), for the public API's upsert. Unique per organization.
  externalId         String?
  /// Who this person reports to, in the same organization (services/people/reporting.ts keeps it
  /// free of cycles). Null = their department's manager, where the department has one.
  reportsToId        String?   @db.Uuid
  passwordHash       String?
  /// Whole-account lockout after many failed sign-ins across networks (auth/bruteForce.ts): wrong
  /// passwords in the last 24 h, and progressive locks (15 min doubling to 1 h). Per-network
  /// failures and locks live in the rate-limit store.
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  lastFailedLoginAt  DateTime? @db.Timestamptz(3)
  lockoutLevel       Int       @default(0)
  lastLockedAt       DateTime? @db.Timestamptz(3)
  /// Networks this account signed in from recently ("<keyed hash>~<ms>", at most 5, 30 days):
  /// not blocked by a whole-account lock caused by other networks. Never the addresses themselves.
  knownNetworks      String[]  @default([])

  hireDate       DateTime? @db.Date
  /// Collective-agreement seniority can differ from hire date; hours-based
  /// seniority is accumulated separately.
  seniorityDate  DateTime? @db.Date
  seniorityHours Decimal   @default(0) @db.Decimal(10, 2)
  /// Target / cap hours per week, used by the scheduling assistant.
  weeklyMinHours Decimal?  @db.Decimal(5, 2)
  weeklyMaxHours Decimal?  @db.Decimal(5, 2)
  vscClearedDate DateTime? @db.Date
  unionMember    Boolean   @default(false)

  /// Advisory only (see services/reliability). Never drives automated decisions.
  reliabilityScore Int       @default(100)
  /// Set while the nightly review flags this person for HR / supervisor attention.
  reviewFlaggedAt  DateTime? @db.Timestamptz(3)

  /// Privacy: set when erasure was requested but payroll retention still applies.
  processingRestrictedAt DateTime? @db.Timestamptz(3)
  erasureDueAt           DateTime? @db.Date
  anonymizedAt           DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  reportsTo           User?                @relation("ReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports       User[]               @relation("ReportsTo")
  positions           UserPosition[]
  payRates            PayRate[]
  certifications      UserCertification[]
  availability        Availability[]
  timeOffRequests     TimeOffRequest[]
  shifts              Shift[]
  timePunches         TimePunch[]
  offersPosted        ShiftOffer[]         @relation("OfferPostedBy")
  offersClaimed       ShiftOffer[]         @relation("OfferClaimedBy")
  reliabilityEvents   ReliabilityEvent[]
  conductNotes        ConductNote[]
  onboarding          OnboardingRecord[]
  accommodations      AccommodationCase[]
  refreshTokens       RefreshToken[]
  managesDepartments  DepartmentManager[]
  payProfile          PayProfile?
  bankAccounts        BankAccount[]
  payStatements       PayStatement[]
  benefitEnrollments  BenefitEnrollment[]
  leaveEntitlements   LeaveEntitlement[]
  trainingRecords     TrainingRecord[]
  authTokens          AuthToken[]
  mfaCodes            MfaCode[]
  disciplinaryRecords DisciplinaryRecord[] @relation("DisciplineSubject")

  @@unique([tenantId, email])
  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, externalId])
  @@index([tenantId, status])
  @@index([reportsToId])
}

model RefreshToken {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  userId          String    @db.Uuid
  /// SHA-256 of the opaque token; the raw token only ever lives in an HTTP-only cookie.
  tokenHash       String    @unique
  /// Rotation family — reuse of a revoked token revokes the whole family.
  familyId        String    @db.Uuid
  /// When the person last proved who they are (password or passkey), carried
  /// through rotation. Sensitive actions need this to be recent.
  authenticatedAt DateTime  @default(now()) @db.Timestamptz(3)
  /// When this session proved a second factor (a passkey), carried through
  /// rotation. Null = password only.
  mfaAt           DateTime? @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([familyId])
}

enum AuthTokenPurpose {
  INVITE
  RESET
  /// One-time hand-off after single sign-on, traded for a session on the organization's own site.
  SSO
  /// The same, when the identity provider confirmed a second factor.
  SSO_MFA
  /// A code texted to confirm a mobile number.
  SMS_VERIFY
}

/// One-time links for invitations and password resets. Only a hash is stored.
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
}

/// A one-time sign-in code sent by email or text as the second factor. Only an HMAC-SHA256 of
/// the code (keyed with the server secret, bound to this row and person) is kept, never the code.
/// A newer code supersedes older ones; 5 wrong tries end it; it lasts 10 minutes.
model MfaCode {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  userId    String     @db.Uuid
  channel   MfaChannel
  codeHash  String
  expiresAt DateTime   @db.Timestamptz(3)
  attempts  Int        @default(0)
  usedAt    DateTime?  @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

enum MfaChannel {
  EMAIL
  SMS
}

// ------------------------------------------------------------------
// POSITIONS, PAY & CERTIFICATIONS
// ------------------------------------------------------------------

/// What can be worked: "Lifeguard", "Swim Instructor", "Head Lifeguard"...
/// Shifts require a Position; Positions require certifications.
model Position {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  name               String
  nameFr             String?
  minimumAge         Int?
  /// Driving limits for this position: { maxDailyHours, minRestHours, maxHoursIn7Days }.
  /// Empty = no limits beyond the province's rules.
  hoursOfService     Json?
  /// The department this position belongs to (Aquatics, Water Works…). Null = none yet.
  departmentId       String?  @db.Uuid
  /// Unpaid meal break minutes on this position's shifts (a shift's own value wins). Null = none.
  unpaidBreakMinutes Int?
  /// Never alone (working-alone rule): at least two qualified people must overlap on its shifts.
  neverAlone         Boolean  @default(false)
  /// The organization's own system's id (public API upsert). Unique per organization.
  externalId         String?
  /// For the public API's updated_since filter.
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  department      Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  requirements    PositionCertRequirement[]
  qualifiedUsers  UserPosition[]
  payRates        PayRate[]
  shifts          Shift[]
  payCodeMappings PayCodeMapping[]
  onboarding      PositionOnboarding[]

  @@unique([tenantId, name])
  @@unique([tenantId, externalId])
}

/// A part of the city's workforce: Aquatics, Water Works, Parks… Supervisors and
/// managers see only their departments; HR sees every department.
model Department {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  name         String
  nameFr       String?
  /// The built-in aquatic roles (supervisor, head lifeguard) manage this department.
  aquatic      Boolean             @default(false)
  /// General-ledger segment (cost centre) its labour costs post to.
  glCode       String?
  /// Labour budget for the year, for budget-to-actual.
  labourBudget Decimal?            @db.Decimal(14, 2)
  /// The organization's own system's id (public API upsert). Unique per organization.
  externalId   String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  positions    Position[]
  managers     DepartmentManager[]

  @@unique([tenantId, name])
  @@unique([tenantId, externalId])
}

/// A supervisor or manager HR chose to run a department. A department can have several.
model DepartmentManager {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  departmentId String     @db.Uuid
  userId       String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

/// Work restrictions from an accommodation or return-to-work plan. Holds the
/// restrictions only, never a diagnosis; the scheduler enforces them and
/// supervisors see only that a shift is outside the person's restrictions.
model AccommodationCase {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @db.Uuid
  userId              String              @db.Uuid
  status              AccommodationStatus @default(ACTIVE)
  /// General label only, e.g. "Return to work" (no medical details).
  label               String
  startsOn            DateTime            @db.Date
  endsOn              DateTime?           @db.Date
  reviewOn            DateTime?           @db.Date
  maxShiftHours       Decimal?            @db.Decimal(4, 2)
  maxWeeklyHours      Decimal?            @db.Decimal(5, 2)
  /// Minutes after midnight, local time.
  noStartBefore       Int?
  noEndAfter          Int?
  /// Days of week (0 = Sunday) not to schedule.
  daysOff             Int[]
  excludedPositionIds String[]            @db.Uuid
  createdById         String              @db.Uuid
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  closedAt            DateTime?           @db.Timestamptz(3)
  reviewNotifiedAt    DateTime?           @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

/// A private check-in offered after a critical incident. Only that it was
/// offered and followed up is kept, never what was said.
model CareCheckIn {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  userId        String     @db.Uuid
  incidentId    String     @db.Uuid
  status        CareStatus @default(OFFERED)
  dueAt         DateTime   @db.Timestamptz(3)
  breakAskedAt  DateTime?  @db.Timestamptz(3)
  completedAt   DateTime?  @db.Timestamptz(3)
  completedById String?    @db.Uuid
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([incidentId, userId])
  @@index([status, dueAt])
}

/// Overtime equalization ledger: overtime accepted (automatic from approvals
/// and assignments) and call-outs refused or unanswered (recorded by a supervisor).
model OvertimeEntry {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  userId       String            @db.Uuid
  positionId   String?           @db.Uuid
  shiftId      String?           @db.Uuid
  kind         OvertimeEntryKind
  hours        Decimal           @db.Decimal(6, 2)
  occurredAt   DateTime          @db.Timestamptz(3)
  recordedById String            @db.Uuid
  note         String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@index([userId, occurredAt])
}

/// One onboarding requirement in a city's catalogue: a check, training, policy
/// to acknowledge, document to collect or task to do, and who completes it.
/// Sensitive results (police checks, SIN) are never stored: only that they
/// were seen, when, and by whom.
model OnboardingItem {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  /// Stable key for the built-in catalogue (null for city-made items).
  key              String?
  name             String
  nameFr           String?
  description      String?
  descriptionFr    String?
  owner            OnboardingOwner
  kind             OnboardingKind
  /// Required for everyone, whatever their position.
  allStaff         Boolean         @default(false)
  /// Must be done (and not expired) before the person can be scheduled.
  blocksScheduling Boolean         @default(false)
  /// Renewal period; null = never expires.
  validityMonths   Int?
  /// Text the employee reads before acknowledging (policies).
  policyText       String?
  sortOrder        Int             @default(0)
  archivedAt       DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  positions PositionOnboarding[]
  records   OnboardingRecord[]

  @@unique([tenantId, key])
}

/// Which items a position requires (the per-position switches).
model PositionOnboarding {
  tenantId   String @db.Uuid
  positionId String @db.Uuid
  itemId     String @db.Uuid

  position Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  item     OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([positionId, itemId])
}

/// A completed or waived item for a person. Renewals add a new record.
model OnboardingRecord {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  userId         String           @db.Uuid
  itemId         String           @db.Uuid
  status         OnboardingStatus
  completedOn    DateTime         @db.Date
  expiresOn      DateTime?        @db.Date
  recordedById   String           @db.Uuid
  recordedAt     DateTime         @default(now()) @db.Timestamptz(3)
  /// Factual and non-sensitive (e.g. "Seen: clear, ref. on file with RCMP"); never the result itself.
  note           String?
  waivedReason   String?
  reminderSentAt DateTime?        @db.Timestamptz(3)

  item OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, itemId])
}

model PositionCertRequirement {
  tenantId        String @db.Uuid
  positionId      String @db.Uuid
  certificationId String @db.Uuid

  position      Position      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id])

  @@id([positionId, certificationId])
}

/// A manager has approved this user to work this position.
model UserPosition {
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  positionId String   @db.Uuid
  approvedAt DateTime @default(now()) @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@id([userId, positionId])
}

/// Effective-dated, per position — a guard and an instructor shift can pay differently.
model PayRate {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  userId        String    @db.Uuid
  positionId    String    @db.Uuid
  hourlyRate    Decimal   @db.Decimal(10, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([userId, positionId, effectiveFrom])
}

/// Global catalogue rows have tenantId = null; tenants may add their own.
model Certification {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String? @db.Uuid
  name           String
  nameFr         String?
  issuingBody    String
  /// null = does not expire
  validityMonths Int?

  userCerts      UserCertification[]
  requiredFor    PositionCertRequirement[]
  prerequisites  CertificationPrerequisite[] @relation("CertRequires")
  prerequisiteOf CertificationPrerequisite[] @relation("CertIsRequiredBy")
}

/// e.g. National Lifeguard is only valid while the holder also has current
/// Standard First Aid.
model CertificationPrerequisite {
  certificationId String @db.Uuid
  requiresId      String @db.Uuid

  certification Certification @relation("CertRequires", fields: [certificationId], references: [id], onDelete: Cascade)
  requires      Certification @relation("CertIsRequiredBy", fields: [requiresId], references: [id], onDelete: Cascade)

  @@id([certificationId, requiresId])
}

model UserCertification {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  userId          String    @db.Uuid
  certificationId String    @db.Uuid
  issueDate       DateTime  @db.Date
  /// null = does not expire
  expiryDate      DateTime? @db.Date
  documentUrl     String?
  verifiedById    String?   @db.Uuid
  verifiedAt      DateTime? @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  certification Certification @relation(fields: [certificationId], references: [id])

  @@index([tenantId, expiryDate])
  @@index([userId])
}

// ------------------------------------------------------------------
// AVAILABILITY & TIME OFF
// ------------------------------------------------------------------

/// Recurring weekly availability, in the facility's local time.
model Availability {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  userId        String    @db.Uuid
  dayOfWeek     Int // 0 = Sunday
  startMinute   Int // minutes after local midnight
  endMinute     Int // may exceed 1440 for availability running past midnight
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model TimeOffRequest {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  userId       String        @db.Uuid
  type         TimeOffType
  startsAt     DateTime      @db.Timestamptz(3)
  endsAt       DateTime      @db.Timestamptz(3)
  status       RequestStatus @default(PENDING)
  note         String?
  decisionNote String?
  decidedById  String?       @db.Uuid
  decidedAt    DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Leave hours this request used, measured at approval from the person's scheduled shifts in it
  /// (their shifts are released when it's approved); weekdays × 8 h when nothing was scheduled.
  chargedHours Decimal? @db.Decimal(8, 2)
  chargedBasis String?

  @@index([userId, startsAt, endsAt])
}

// ------------------------------------------------------------------
// SCHEDULING
// ------------------------------------------------------------------

model Shift {
  id                    String      @id @default(uuid()) @db.Uuid
  tenantId              String      @db.Uuid
  facilityId            String      @db.Uuid
  positionId            String      @db.Uuid
  userId                String?     @db.Uuid // null = open shift
  startsAt              DateTime    @db.Timestamptz(3)
  endsAt                DateTime    @db.Timestamptz(3)
  shiftType             ShiftType   @default(STANDARD)
  status                ShiftStatus @default(DRAFT)
  customTitle           String?
  /// Extra $/h on top of the base rate (e.g. specialised class).
  premiumPerHour        Decimal?    @db.Decimal(10, 2)
  /// Why the scheduling assistant could not fill it (null when filled or not attempted).
  conflictReason        String?
  /// Optimistic-lock counter. Every assignment change must match + increment it.
  version               Int         @default(0)
  /// Unpaid meal break minutes for this shift; null = the position's. Paid hours = length − break.
  unpaidBreakMinutes    Int?
  /// Never alone for this shift; null = the position's flag.
  neverAlone            Boolean?
  /// A call-back (someone on call called in): the call-back minimum applies instead of reporting pay.
  callBack              Boolean     @default(false)
  /// Made by "Generate shifts" from a rotation template.
  rotationTemplateId    String?     @db.Uuid
  /// Made by applying a weekly shift template: the slot, and the application (undo cancels its drafts).
  templateSlotId        String?     @db.Uuid
  templateApplicationId String?     @db.Uuid
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @db.Timestamptz(3)

  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  position    Position     @relation(fields: [positionId], references: [id], onDelete: Restrict)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  timePunches TimePunch[]
  offers      ShiftOffer[]

  @@index([tenantId, facilityId, startsAt, endsAt])
  @@index([userId, startsAt])
  @@index([templateSlotId, startsAt])
  @@index([templateApplicationId])
}

/// A shift on the Shift Board: either an open shift or a swap offer.
/// The original holder stays responsible until status = COMPLETED.
model ShiftOffer {
  id                 String      @id @default(uuid()) @db.Uuid
  tenantId           String      @db.Uuid
  shiftId            String      @db.Uuid
  source             OfferSource
  postedById         String?     @db.Uuid // null for OPEN_SHIFT posted by the system
  claimedById        String?     @db.Uuid
  status             OfferStatus @default(OPEN)
  /// Snapshot of the compliance evaluation at claim time (reasons, OT hours).
  complianceSnapshot Json?
  decidedById        String?     @db.Uuid
  decidedAt          DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  shift     Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  postedBy  User? @relation("OfferPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  claimedBy User? @relation("OfferClaimedBy", fields: [claimedById], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([shiftId])
}

enum SchoolPeriodKind {
  TERM
  BREAK
}

/// The organization's local school calendar, used for young-worker hour limits
/// (school-day vs non-school-day limits, no work during school hours).
model SchoolCalendarPeriod {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @db.Uuid
  kind     SchoolPeriodKind
  name     String
  startsOn DateTime         @db.Date
  endsOn   DateTime         @db.Date

  @@index([tenantId, startsOn])
}

model StatutoryHoliday {
  id         String      @id @default(uuid()) @db.Uuid
  province   Province
  /// The holiday's own date.
  date       DateTime    @db.Date
  name       String
  nameFr     String?
  /// Which holiday (NEW_YEAR, CANADA_DAY, ...): the weekend rules differ per holiday.
  key        String?
  /// Whether the law moves it when it falls on a weekend; `observedOn` is then the day it moves to.
  kind       HolidayKind @default(ACTUAL)
  observedOn DateTime?   @db.Date
  /// The next weekday that isn't already a holiday, for organizations that observe weekend
  /// holidays on a weekday (collective agreements). Null when the holiday is on a weekday.
  weekdayOn  DateTime?   @db.Date

  @@unique([province, date])
}

// ------------------------------------------------------------------
// TIMEKEEPING
// ------------------------------------------------------------------

model TimePunch {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  userId             String              @db.Uuid
  facilityId         String              @db.Uuid
  /// Nullable: unscheduled call-ins still need a punch.
  shiftId            String?             @db.Uuid
  /// Position worked — determines pay rate. Defaults from the shift.
  positionId         String              @db.Uuid
  clockIn            DateTime            @db.Timestamptz(3)
  clockOut           DateTime?           @db.Timestamptz(3)
  ipAddress          String?
  latitude           Decimal?            @db.Decimal(9, 6)
  longitude          Decimal?            @db.Decimal(9, 6)
  accuracyM          Int?
  distanceM          Int?
  locationStatus     PunchLocationStatus @default(NO_LOCATION)
  status             PunchStatus         @default(PENDING)
  varianceReason     String?
  /// Punched at this facility kiosk (a shared tablet), not on the person's own device.
  kioskId            String?             @db.Uuid
  reviewedById       String?             @db.Uuid
  reviewedAt         DateTime?           @db.Timestamptz(3)
  /// Ids the phone gave each tap, so a re-sent punch is recognised instead of saved twice.
  clientInId         String?             @db.Uuid
  clientOutId        String?             @db.Uuid
  /// Saved on the phone without a connection and sent later: flagged for review.
  recordedOffline    Boolean             @default(false)
  /// When an offline clock-in / clock-out reached the server (null when sent live).
  clockInReceivedAt  DateTime?           @db.Timestamptz(3)
  clockOutReceivedAt DateTime?           @db.Timestamptz(3)
  /// How far the phone's clock was off the server's, in seconds (+ = phone behind), when measured.
  /// Offline times are corrected by it; large differences are flagged for review.
  clockSkewS         Int?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  facility Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  shift    Shift?          @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  edits    TimePunchEdit[]

  @@unique([tenantId, clientInId])
  @@unique([tenantId, clientOutId])
  @@index([tenantId, userId, clockIn])
  /// Punch review lists one status (pending first) by time.
  @@index([tenantId, status, clockIn])
}

/// Every change to a punch is recorded — original values are never lost.
model TimePunchEdit {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  punchId    String   @db.Uuid
  editedById String   @db.Uuid
  field      String
  oldValue   String?
  newValue   String?
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  punch TimePunch @relation(fields: [punchId], references: [id], onDelete: Restrict)

  @@index([punchId])
}

model PayCodeMapping {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  key        PayCodeKey
  /// null = default for all positions
  positionId String?    @db.Uuid
  code       String // employer's pay code, e.g. "REG_LIFEGUARD"

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])

  @@unique([tenantId, key, positionId])
}

// ------------------------------------------------------------------
// RELIABILITY (advisory)
// ------------------------------------------------------------------

model ReliabilityEvent {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  userId         String               @db.Uuid
  type           ReliabilityEventType
  occurredAt     DateTime             @db.Timestamptz(3)
  /// e.g. punch id / offer id that produced the event
  sourceId       String?
  /// Set when the event overlaps protected leave or a manager excuses it.
  excludedReason String?
  /// Who excused it and when (null for automatic exclusions).
  excusedById    String?              @db.Uuid
  excusedAt      DateTime?            @db.Timestamptz(3)
  /// Recorded by a supervisor (missed in-service, a no-show the timeclock can't see).
  recordedById   String?              @db.Uuid
  /// Factual note the employee can read alongside the event.
  note           String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
}

// ------------------------------------------------------------------
// AQUATIC OPERATIONS
// ------------------------------------------------------------------

/// A body of water with its own chemistry and its own thresholds.
/// Thresholds come from the applicable provincial / health-authority regulation
/// and MUST be configured before readings are accepted — there are no defaults.
model PoolBody {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @db.Uuid
  facilityId             String         @db.Uuid
  name                   String
  kind                   PoolBodyKind
  status                 PoolBodyStatus @default(OPEN)
  freeChlorineMinPpm     Decimal?       @db.Decimal(5, 2)
  freeChlorineMaxPpm     Decimal?       @db.Decimal(5, 2)
  combinedChlorineMaxPpm Decimal?       @db.Decimal(5, 2)
  phMin                  Decimal?       @db.Decimal(4, 2)
  phMax                  Decimal?       @db.Decimal(4, 2)
  thresholdSource        String? // e.g. "BC Pool Regulation / Interior Health permit conditions"
  /// Max bathers per on-duty lifeguard, per the regulation / facility safety plan.
  bathersPerLifeguard    Int?
  /// Maximum bathers allowed at once (permit / occupant load). Headcounts above it alert supervisors.
  maxCapacity            Int?
  depthMinM              Decimal?       @db.Decimal(4, 2)
  depthMaxM              Decimal?       @db.Decimal(4, 2)
  volumeLitres           Int?
  notes                  String?
  /// Retired pools keep their history but leave the deck screens.
  archivedAt             DateTime?      @db.Timestamptz(3)
  headcounts             HeadCount[]

  facility Facility          @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  readings ChemicalReading[]
  closures PoolClosure[]

  @@index([facilityId])
}

model ChemicalReading {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  poolBodyId        String    @db.Uuid
  recordedById      String    @db.Uuid
  recordedAt        DateTime  @db.Timestamptz(3)
  freeChlorinePpm   Decimal?  @db.Decimal(5, 2)
  totalChlorinePpm  Decimal?  @db.Decimal(5, 2)
  ph                Decimal?  @db.Decimal(4, 2)
  waterTempC        Decimal?  @db.Decimal(4, 1)
  batherCount       Int?
  outOfRange        Boolean   @default(false)
  outOfRangeDetails Json?
  signedOffById     String?   @db.Uuid
  signedOffAt       DateTime? @db.Timestamptz(3)

  poolBody PoolBody @relation(fields: [poolBodyId], references: [id], onDelete: Restrict)

  @@index([poolBodyId, recordedAt])
}

model PoolClosure {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  poolBodyId    String    @db.Uuid
  readingId     String?   @db.Uuid
  reason        String
  recommendedAt DateTime  @db.Timestamptz(3)
  confirmedById String?   @db.Uuid
  confirmedAt   DateTime? @db.Timestamptz(3)
  dismissedById String?   @db.Uuid
  dismissedAt   DateTime? @db.Timestamptz(3)
  reopenedById  String?   @db.Uuid
  reopenedAt    DateTime? @db.Timestamptz(3)

  poolBody PoolBody @relation(fields: [poolBodyId], references: [id], onDelete: Restrict)

  @@index([poolBodyId, recommendedAt])
}

/// Envelope-encrypted: the narrative is AES-256-GCM encrypted with a per-record
/// data key, which is itself wrapped by the tenant's KMS key.
model IncidentReport {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  facilityId     String   @db.Uuid
  reportedById   String   @db.Uuid
  occurredAt     DateTime @db.Timestamptz(3)
  category       String // non-sensitive, for reporting (e.g. "FIRST_AID", "RESCUE")
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  wrappedDataKey Bytes
  kekId          String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  facility  Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  accessLog IncidentAccessLog[]

  @@index([tenantId, occurredAt])
