// Flexcity — aquatic staff management
//
// Conventions
// - Every tenant-scoped table carries `tenantId` so Postgres row-level security
//   (db/rls.sql) can isolate tenants without joins.
// - All instants are `@db.Timestamptz(3)`. Local-time reasoning (work days,
//   pay weeks, availability) always uses the Facility's IANA timezone.
// - Payroll-bearing rows use `onDelete: Restrict`. People are never hard-deleted;
//   see services/privacy/erasure.ts for retention-aware anonymization.
// - Money is Decimal, never Float.
// - Union Hub data is NOT in this schema. It lives in the `union_hub` Postgres
//   schema (db/union_hub.sql), reachable only through a separate DB role.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------

enum Province {
  BC
  AB
  SK
  MB
  ON
  QC
  NB
  NS
  PE
  NL
  YT
  NT
  NU
}

/// Permission roles (what a user may DO in the app). A user may hold several.
/// What a user may WORK is modelled separately by Position + certifications.
enum AccessRole {
  HR_ADMIN
  AQUATIC_SUPERVISOR
  HEAD_LIFEGUARD
  STAFF
  FRONT_DESK
  UNION_STEWARD
  /// General city employee (water works, maintenance, parks…): everyday work screens, nothing aquatic.
  EMPLOYEE
}

enum EmploymentStatus {
  FULL_TIME
  PART_TIME
  CASUAL
  ON_CALL
  VOLUNTEER
}

enum UserStatus {
  ACTIVE
  INACTIVE // seasonal / away at school — not billed, data retained
  TERMINATED
}

enum ShadowTier {
  A_SQUAD
  B_SQUAD
  C_SQUAD
  UNASSIGNED
}

enum ShiftType {
  STANDARD
  CUSTOM // e.g. private rental
  MANDATORY // e.g. in-service training
}

/// Lifecycle only. Claim/swap state lives on ShiftOffer, not here.
enum AccommodationStatus {
  ACTIVE
  CLOSED
}

enum CareStatus {
  OFFERED
  CHECKED_IN
  DECLINED
}

enum OvertimeEntryKind {
  ACCEPTED
  REFUSED
  NO_ANSWER
}

enum OnboardingOwner {
  HR
  SUPERVISOR
  EMPLOYEE
}

enum OnboardingKind {
  CHECK
  TRAINING
  ACKNOWLEDGEMENT
  DOCUMENT
  TASK
}

enum OnboardingStatus {
  COMPLETE
  WAIVED
}

enum DisciplineLevel {
  COACHING
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
  SUSPENSION
  TERMINATION
}

enum ConductCategory {
  SAFETY_PROCEDURE
  POLICY
  CONDUCT
  PERFORMANCE
  COMMENDATION
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OfferSource {
  OPEN_SHIFT // unassigned shift posted to the board
  SWAP // assigned shift the holder wants to give away
}

enum OfferStatus {
  OPEN
  PENDING_APPROVAL // claimant would incur overtime (or other soft rule) — supervisor decides
  COMPLETED
  DENIED
  CANCELLED
}

enum TimeOffType {
  VACATION
  SICK // statutory sick leave — protected
  PROTECTED_LEAVE // family responsibility, bereavement, jury duty, etc.
  UNPAID_PERSONAL
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum PunchLocationStatus {
  VERIFIED
  OUTSIDE_RADIUS
  LOW_ACCURACY
  NO_LOCATION
  FACILITY_NOT_CONFIGURED
}

enum PunchStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PoolBodyKind {
  POOL
  LEISURE_POOL
  HOT_TUB
  WADING_POOL
  WAVE_POOL
  SPLASH_PAD
}

enum PoolBodyStatus {
  OPEN
  CLOSURE_RECOMMENDED // system detected out-of-range reading, awaiting human confirmation
  CLOSED
}

enum ReliabilityEventType {
  LATE_PUNCH
  NO_SHOW
  MISSED_IN_SERVICE
  LATE_DROP // gave away a shift with < 24h notice
  PICKED_UP_SHIFT
}

enum PayCodeKey {
  REGULAR
  OVERTIME_1_5
  OVERTIME_2_0
  STAT_WORKED
  STAT_HOLIDAY_PAY
  SHIFT_PREMIUM
  VACATION_PAY
}

enum VacationPayMode {
  PAY_EACH_PERIOD
  ACCRUE
}

// ------------------------------------------------------------------
// TENANCY
// ------------------------------------------------------------------

model Tenant {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  subdomain       String          @unique
  logoUrl         String?
  /// { primary, primaryHover, primaryContrast, accent } — injected as CSS variables
  themeColors     Json            @default("{}")
  defaultLocale   String          @default("en-CA")
  /// 0 = Sunday ... 6 = Saturday, in each facility's local time
  payWeekStartDay Int             @default(0)
  vacationPayMode VacationPayMode @default(PAY_EACH_PERIOD)
  /// Years to keep payroll records after the end of the tax year they relate to.
  /// CRA requires 6; default adds a year of margin.
  payrollRetentionYears Int       @default(7)
  /// Feature switches set from the FH Dev console: { featureKey: boolean }.
  /// Missing keys use the defaults in src/services/platform/features.ts.
  features        Json            @default("{}")
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  facilities      Facility[]
  users           User[]
  positions       Position[]
  ruleOverrides   RuleOverride[]
  payCodeMappings PayCodeMapping[]
  /// Dev console per-role customization: { ROLE: { grant: [], revoke: [], hideMenu: [] } }.
  roleOverrides Json @default("{}")
  /// Overtime equalization: { countRefusals, clause, periodStartMonth }.
  overtimePolicy Json @default("{}")
  /// Care after critical incidents: { eap: "Employee assistance: 1-800-…" }.
  careSettings   Json @default("{}")
  /// Shares anonymous measures with other cities (and sees theirs).
  benchmarkOptIn Boolean @default(false)
}

/// Employment-standards province follows the WORK LOCATION, so it lives here,
/// not on Tenant (a YMCA association can span provinces).
model Facility {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  province    Province
  timezone    String // IANA, e.g. "America/Vancouver"
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  geoRadiusM  Int      @default(150)
  costCenter  String? // e.g. "CC-405-AQUATICS" for payroll export
  /// FH billing tier for municipal plans: 1 minor/seasonal, 2 standard, 3 major; null = not billed.
  billingTier         Int?
  /// Overrides the tier price (cents per month) when set.
  billingMonthlyCents Int?
  /// Deck rotation: minutes on one station before moving on.
  rotationMinutes     Int      @default(30)
  /// Fatigue limit: continuous minutes on stations (across rotations) before a break.
  maxOnChairMinutes   Int      @default(120)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  shifts      Shift[]
  poolBodies  PoolBody[]
  timePunches TimePunch[]
  incidents   IncidentReport[]
  deckStations DeckStation[]

  @@index([tenantId])
}

/// Tenant-specific overrides of provincial rules, e.g. a collective agreement
/// that pays OT after 7.5h/day. Effective-dated so history recalculates correctly.
model RuleOverride {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  province      Province?
  ruleKey       String // e.g. "dailyOvertimeHours"
  value         Json
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  source        String? // e.g. "CUPE Local 338 CBA art. 14.02"

  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, ruleKey, effectiveFrom])
}

// ------------------------------------------------------------------
// PEOPLE
// ------------------------------------------------------------------

model User {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  roles            AccessRole[]
  status           UserStatus       @default(ACTIVE)
  employmentStatus EmploymentStatus
  shadowTier       ShadowTier       @default(UNASSIGNED) // set by a manager, never automatically

  firstName        String
  lastName         String
  email            String
  phone            String?
  locale           String           @default("en-CA")
  /// Needed only to apply young-worker rules. Not exported anywhere.
  dateOfBirth      DateTime?        @db.Date
  /// The employer's HR/payroll system ID — used in payroll exports.
  employeeNumber   String?
  passwordHash     String?
  /// Account lockout after repeated failed sign-ins.
  failedLoginCount Int              @default(0)
  lockedUntil      DateTime?        @db.Timestamptz(3)

  hireDate         DateTime?        @db.Date
  /// Collective-agreement seniority can differ from hire date; hours-based
  /// seniority is accumulated separately.
  seniorityDate    DateTime?        @db.Date
  seniorityHours   Decimal          @default(0) @db.Decimal(10, 2)
  /// Target / cap hours per week, used by the scheduling assistant.
  weeklyMinHours   Decimal?         @db.Decimal(5, 2)
  weeklyMaxHours   Decimal?         @db.Decimal(5, 2)
  vscClearedDate   DateTime?        @db.Date
  unionMember      Boolean          @default(false)

  /// Advisory only (see services/reliability). Never drives automated decisions.
  reliabilityScore Int              @default(100)
  /// Set while the nightly review flags this person for HR / supervisor attention.
  reviewFlaggedAt  DateTime?        @db.Timestamptz(3)

  /// Privacy: set when erasure was requested but payroll retention still applies.
  processingRestrictedAt DateTime?  @db.Timestamptz(3)
  erasureDueAt     DateTime?        @db.Date
  anonymizedAt     DateTime?        @db.Timestamptz(3)

  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  positions        UserPosition[]
  payRates         PayRate[]
  certifications   UserCertification[]
  availability     Availability[]
  timeOffRequests  TimeOffRequest[]
  shifts           Shift[]
  timePunches      TimePunch[]
  offersPosted     ShiftOffer[]     @relation("OfferPostedBy")
  offersClaimed    ShiftOffer[]     @relation("OfferClaimedBy")
  reliabilityEvents ReliabilityEvent[]
  conductNotes      ConductNote[]
  onboarding        OnboardingRecord[]
  accommodations    AccommodationCase[]
  refreshTokens    RefreshToken[]
  authTokens       AuthToken[]
  disciplinaryRecords DisciplinaryRecord[] @relation("DisciplineSubject")

  @@unique([tenantId, email])
  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  /// SHA-256 of the opaque token; the raw token only ever lives in an HTTP-only cookie.
  tokenHash String    @unique
  /// Rotation family — reuse of a revoked token revokes the whole family.
  familyId  String    @db.Uuid
  /// When the person last proved who they are (password or passkey), carried
  /// through rotation. Sensitive actions need this to be recent.
  authenticatedAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([familyId])
}

enum AuthTokenPurpose {
  INVITE
  RESET
}

/// One-time links for invitations and password resets. Only a hash is stored.
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
}

// ------------------------------------------------------------------
// POSITIONS, PAY & CERTIFICATIONS
// ------------------------------------------------------------------

/// What can be worked: "Lifeguard", "Swim Instructor", "Head Lifeguard"...
/// Shifts require a Position; Positions require certifications.
model Position {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  nameFr      String?
  minimumAge  Int?

  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  requirements    PositionCertRequirement[]
  qualifiedUsers  UserPosition[]
  payRates        PayRate[]
  shifts          Shift[]
  payCodeMappings PayCodeMapping[]
  onboarding      PositionOnboarding[]

  @@unique([tenantId, name])
}

/// Work restrictions from an accommodation or return-to-work plan. Holds the
/// restrictions only, never a diagnosis; the scheduler enforces them and
/// supervisors see only that a shift is outside the person's restrictions.
model AccommodationCase {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @db.Uuid
  userId              String              @db.Uuid
  status              AccommodationStatus @default(ACTIVE)
  /// General label only, e.g. "Return to work" (no medical details).
  label               String
  startsOn            DateTime            @db.Date
  endsOn              DateTime?           @db.Date
  reviewOn            DateTime?           @db.Date
  maxShiftHours       Decimal?            @db.Decimal(4, 2)
  maxWeeklyHours      Decimal?            @db.Decimal(5, 2)
  /// Minutes after midnight, local time.
  noStartBefore       Int?
  noEndAfter          Int?
  /// Days of week (0 = Sunday) not to schedule.
  daysOff             Int[]
  excludedPositionIds String[]            @db.Uuid
  createdById         String              @db.Uuid
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  closedAt            DateTime?           @db.Timestamptz(3)
  reviewNotifiedAt    DateTime?           @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

/// A private check-in offered after a critical incident. Only that it was
/// offered and followed up is kept, never what was said.
model CareCheckIn {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  userId        String     @db.Uuid
  incidentId    String     @db.Uuid
  status        CareStatus @default(OFFERED)
  dueAt         DateTime   @db.Timestamptz(3)
  breakAskedAt  DateTime?  @db.Timestamptz(3)
  completedAt   DateTime?  @db.Timestamptz(3)
  completedById String?    @db.Uuid
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([incidentId, userId])
  @@index([status, dueAt])
}

/// Overtime equalization ledger: overtime accepted (automatic from approvals
/// and assignments) and call-outs refused or unanswered (recorded by a supervisor).
model OvertimeEntry {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  userId       String            @db.Uuid
  positionId   String?           @db.Uuid
  shiftId      String?           @db.Uuid
  kind         OvertimeEntryKind
  hours        Decimal           @db.Decimal(6, 2)
  occurredAt   DateTime          @db.Timestamptz(3)
  recordedById String            @db.Uuid
  note         String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@index([userId, occurredAt])
}

/// One onboarding requirement in a city's catalogue: a check, training, policy
/// to acknowledge, document to collect or task to do, and who completes it.
/// Sensitive results (police checks, SIN) are never stored: only that they
/// were seen, when, and by whom.
model OnboardingItem {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  /// Stable key for the built-in catalogue (null for city-made items).
  key              String?
  name             String
  nameFr           String?
  description      String?
  descriptionFr    String?
  owner            OnboardingOwner
  kind             OnboardingKind
  /// Required for everyone, whatever their position.
  allStaff         Boolean         @default(false)
  /// Must be done (and not expired) before the person can be scheduled.
  blocksScheduling Boolean         @default(false)
  /// Renewal period; null = never expires.
  validityMonths   Int?
  /// Text the employee reads before acknowledging (policies).
  policyText       String?
  sortOrder        Int             @default(0)
  archivedAt       DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  positions PositionOnboarding[]
  records   OnboardingRecord[]

  @@unique([tenantId, key])
}

/// Which items a position requires (the per-position switches).
model PositionOnboarding {
  tenantId   String @db.Uuid
  positionId String @db.Uuid
  itemId     String @db.Uuid

  position Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  item     OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([positionId, itemId])
}

/// A completed or waived item for a person. Renewals add a new record.
model OnboardingRecord {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  userId         String           @db.Uuid
  itemId         String           @db.Uuid
  status         OnboardingStatus
  completedOn    DateTime         @db.Date
  expiresOn      DateTime?        @db.Date
  recordedById   String           @db.Uuid
  recordedAt     DateTime         @default(now()) @db.Timestamptz(3)
  /// Factual and non-sensitive (e.g. "Seen: clear, ref. on file with RCMP"); never the result itself.
  note           String?
  waivedReason   String?
  reminderSentAt DateTime?        @db.Timestamptz(3)

  item OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, itemId])
}

model PositionCertRequirement {
  tenantId        String @db.Uuid
  positionId      String @db.Uuid
  certificationId String @db.Uuid

  position      Position      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id])

  @@id([positionId, certificationId])
}

/// A manager has approved this user to work this position.
model UserPosition {
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  positionId String   @db.Uuid
  approvedAt DateTime @default(now()) @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@id([userId, positionId])
}

/// Effective-dated, per position — a guard and an instructor shift can pay differently.
model PayRate {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  userId        String    @db.Uuid
  positionId    String    @db.Uuid
  hourlyRate    Decimal   @db.Decimal(10, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([userId, positionId, effectiveFrom])
}

/// Global catalogue rows have tenantId = null; tenants may add their own.
model Certification {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String? @db.Uuid
  name           String
  nameFr         String?
  issuingBody    String
  /// null = does not expire
  validityMonths Int?

  userCerts      UserCertification[]
  requiredFor    PositionCertRequirement[]
  prerequisites  CertificationPrerequisite[] @relation("CertRequires")
  prerequisiteOf CertificationPrerequisite[] @relation("CertIsRequiredBy")
}

/// e.g. National Lifeguard is only valid while the holder also has current
/// Standard First Aid.
model CertificationPrerequisite {
  certificationId String @db.Uuid
  requiresId      String @db.Uuid

  certification Certification @relation("CertRequires", fields: [certificationId], references: [id], onDelete: Cascade)
  requires      Certification @relation("CertIsRequiredBy", fields: [requiresId], references: [id], onDelete: Cascade)

  @@id([certificationId, requiresId])
}

model UserCertification {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  userId          String    @db.Uuid
  certificationId String    @db.Uuid
  issueDate       DateTime  @db.Date
  /// null = does not expire
  expiryDate      DateTime? @db.Date
  documentUrl     String?
  verifiedById    String?   @db.Uuid
  verifiedAt      DateTime? @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  certification Certification @relation(fields: [certificationId], references: [id])

  @@index([tenantId, expiryDate])
  @@index([userId])
}

// ------------------------------------------------------------------
// AVAILABILITY & TIME OFF
// ------------------------------------------------------------------

/// Recurring weekly availability, in the facility's local time.
model Availability {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  userId        String    @db.Uuid
  dayOfWeek     Int // 0 = Sunday
  startMinute   Int // minutes after local midnight
  endMinute     Int // may exceed 1440 for availability running past midnight
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model TimeOffRequest {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  userId       String        @db.Uuid
  type         TimeOffType
  startsAt     DateTime      @db.Timestamptz(3)
  endsAt       DateTime      @db.Timestamptz(3)
  status       RequestStatus @default(PENDING)
  note         String?
  decisionNote String?
  decidedById  String?       @db.Uuid
  decidedAt    DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, startsAt, endsAt])
}

// ------------------------------------------------------------------
// SCHEDULING
// ------------------------------------------------------------------

model Shift {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  facilityId     String      @db.Uuid
  positionId     String      @db.Uuid
  userId         String?     @db.Uuid // null = open shift
  startsAt       DateTime    @db.Timestamptz(3)
  endsAt         DateTime    @db.Timestamptz(3)
  shiftType      ShiftType   @default(STANDARD)
  status         ShiftStatus @default(DRAFT)
  customTitle    String?
  /// Extra $/h on top of the base rate (e.g. specialised class).
  premiumPerHour Decimal?    @db.Decimal(10, 2)
  /// Why the scheduling assistant could not fill it (null when filled or not attempted).
  conflictReason String?
  /// Optimistic-lock counter. Every assignment change must match + increment it.
  version        Int         @default(0)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  position    Position     @relation(fields: [positionId], references: [id], onDelete: Restrict)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  timePunches TimePunch[]
  offers      ShiftOffer[]

  @@index([tenantId, facilityId, startsAt, endsAt])
  @@index([userId, startsAt])
}

/// A shift on the Shift Board: either an open shift or a swap offer.
/// The original holder stays responsible until status = COMPLETED.
model ShiftOffer {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  shiftId        String      @db.Uuid
  source         OfferSource
  postedById     String?     @db.Uuid // null for OPEN_SHIFT posted by the system
  claimedById    String?     @db.Uuid
  status         OfferStatus @default(OPEN)
  /// Snapshot of the compliance evaluation at claim time (reasons, OT hours).
  complianceSnapshot Json?
  decidedById    String?     @db.Uuid
  decidedAt      DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  shift     Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  postedBy  User? @relation("OfferPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  claimedBy User? @relation("OfferClaimedBy", fields: [claimedById], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([shiftId])
}

enum SchoolPeriodKind {
  TERM
  BREAK
}

/// The organization's local school calendar, used for young-worker hour limits
/// (school-day vs non-school-day limits, no work during school hours).
model SchoolCalendarPeriod {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @db.Uuid
  kind     SchoolPeriodKind
  name     String
  startsOn DateTime         @db.Date
  endsOn   DateTime         @db.Date

  @@index([tenantId, startsOn])
}

model StatutoryHoliday {
  id       String   @id @default(uuid()) @db.Uuid
  province Province
  date     DateTime @db.Date
  name     String
  nameFr   String?

  @@unique([province, date])
}

// ------------------------------------------------------------------
// TIMEKEEPING
// ------------------------------------------------------------------

model TimePunch {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  userId         String              @db.Uuid
  facilityId     String              @db.Uuid
  /// Nullable: unscheduled call-ins still need a punch.
  shiftId        String?             @db.Uuid
  /// Position worked — determines pay rate. Defaults from the shift.
  positionId     String              @db.Uuid
  clockIn        DateTime            @db.Timestamptz(3)
  clockOut       DateTime?           @db.Timestamptz(3)
  ipAddress      String?
  latitude       Decimal?            @db.Decimal(9, 6)
  longitude      Decimal?            @db.Decimal(9, 6)
  accuracyM      Int?
  distanceM      Int?
  locationStatus PunchLocationStatus @default(NO_LOCATION)
  status         PunchStatus         @default(PENDING)
  varianceReason String?
  reviewedById   String?             @db.Uuid
  reviewedAt     DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  facility Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  shift    Shift?          @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  edits    TimePunchEdit[]

  @@index([tenantId, userId, clockIn])
}

/// Every change to a punch is recorded — original values are never lost.
model TimePunchEdit {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  punchId     String   @db.Uuid
  editedById  String   @db.Uuid
  field       String
  oldValue    String?
  newValue    String?
  reason      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  punch TimePunch @relation(fields: [punchId], references: [id], onDelete: Restrict)

  @@index([punchId])
}

model PayCodeMapping {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  key        PayCodeKey
  /// null = default for all positions
  positionId String?    @db.Uuid
  code       String // employer's pay code, e.g. "REG_LIFEGUARD"

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])

  @@unique([tenantId, key, positionId])
}

// ------------------------------------------------------------------
// RELIABILITY (advisory)
// ------------------------------------------------------------------

model ReliabilityEvent {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  userId         String               @db.Uuid
  type           ReliabilityEventType
  occurredAt     DateTime             @db.Timestamptz(3)
  /// e.g. punch id / offer id that produced the event
  sourceId       String?
  /// Set when the event overlaps protected leave or a manager excuses it.
  excludedReason String?
  /// Who excused it and when (null for automatic exclusions).
  excusedById    String?              @db.Uuid
  excusedAt      DateTime?            @db.Timestamptz(3)
  /// Recorded by a supervisor (missed in-service, a no-show the timeclock can't see).
  recordedById   String?              @db.Uuid
  /// Factual note the employee can read alongside the event.
  note           String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
}

// ------------------------------------------------------------------
// AQUATIC OPERATIONS
// ------------------------------------------------------------------

/// A body of water with its own chemistry and its own thresholds.
/// Thresholds come from the applicable provincial / health-authority regulation
/// and MUST be configured before readings are accepted — there are no defaults.
model PoolBody {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  facilityId          String         @db.Uuid
  name                String
  kind                PoolBodyKind
  status              PoolBodyStatus @default(OPEN)
  freeChlorineMinPpm  Decimal?       @db.Decimal(5, 2)
  freeChlorineMaxPpm  Decimal?       @db.Decimal(5, 2)
  combinedChlorineMaxPpm Decimal?    @db.Decimal(5, 2)
  phMin               Decimal?       @db.Decimal(4, 2)
  phMax               Decimal?       @db.Decimal(4, 2)
  thresholdSource     String? // e.g. "BC Pool Regulation / Interior Health permit conditions"
  /// Max bathers per on-duty lifeguard, per the regulation / facility safety plan.
  bathersPerLifeguard Int?
  /// Maximum bathers allowed at once (permit / occupant load). Headcounts above it alert supervisors.
  maxCapacity         Int?
  depthMinM           Decimal?       @db.Decimal(4, 2)
  depthMaxM           Decimal?       @db.Decimal(4, 2)
  volumeLitres        Int?
  notes               String?
  /// Retired pools keep their history but leave the deck screens.
  archivedAt          DateTime?      @db.Timestamptz(3)
  headcounts          HeadCount[]

  facility  Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  readings  ChemicalReading[]
  closures  PoolClosure[]

  @@index([facilityId])
}

model ChemicalReading {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  poolBodyId         String   @db.Uuid
  recordedById       String   @db.Uuid
  recordedAt         DateTime @db.Timestamptz(3)
  freeChlorinePpm    Decimal? @db.Decimal(5, 2)
  totalChlorinePpm   Decimal? @db.Decimal(5, 2)
  ph                 Decimal? @db.Decimal(4, 2)
  waterTempC         Decimal? @db.Decimal(4, 1)
  batherCount        Int?
  outOfRange         Boolean  @default(false)
  outOfRangeDetails  Json?
  signedOffById      String?  @db.Uuid
  signedOffAt        DateTime? @db.Timestamptz(3)

  poolBody PoolBody @relation(fields: [poolBodyId], references: [id], onDelete: Restrict)

  @@index([poolBodyId, recordedAt])
}

model PoolClosure {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  poolBodyId    String    @db.Uuid
  readingId     String?   @db.Uuid
  reason        String
  recommendedAt DateTime  @db.Timestamptz(3)
  confirmedById String?   @db.Uuid
  confirmedAt   DateTime? @db.Timestamptz(3)
  dismissedById String?   @db.Uuid
  dismissedAt   DateTime? @db.Timestamptz(3)
  reopenedById  String?   @db.Uuid
  reopenedAt    DateTime? @db.Timestamptz(3)

  poolBody PoolBody @relation(fields: [poolBodyId], references: [id], onDelete: Restrict)

  @@index([poolBodyId, recommendedAt])
}

/// Envelope-encrypted: the narrative is AES-256-GCM encrypted with a per-record
/// data key, which is itself wrapped by the tenant's KMS key.
model IncidentReport {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  facilityId       String   @db.Uuid
  reportedById     String   @db.Uuid
  occurredAt       DateTime @db.Timestamptz(3)
  category         String // non-sensitive, for reporting (e.g. "FIRST_AID", "RESCUE")
  ciphertext       Bytes
  iv               Bytes
  authTag          Bytes
  wrappedDataKey   Bytes
  kekId            String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  facility  Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  accessLog IncidentAccessLog[]

  @@index([tenantId, occurredAt])
}

/// A lifeguard station on deck (a chair, a roving position, the slide tower).
model DeckStation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  facilityId String    @db.Uuid
  poolBodyId String?   @db.Uuid
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId])
}

/// Who was on which station, from when to when. stationId null = off the chair (break, other duties).
model RotationLog {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  facilityId        String    @db.Uuid
  stationId         String?   @db.Uuid
  userId            String    @db.Uuid
  startedAt         DateTime  @db.Timestamptz(3)
  endedAt           DateTime? @db.Timestamptz(3)
  recordedById      String    @db.Uuid
  overdueNotifiedAt DateTime? @db.Timestamptz(3)

  @@index([facilityId, startedAt])
  @@index([userId, startedAt])
}

/// A supervisor's factual note about someone's conduct or performance,
/// optionally tied to an incident. Being named in an incident report never
/// creates one: a person decides, so reporting stays safe.
model ConductNote {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  userId          String          @db.Uuid
  recordedById    String          @db.Uuid
  occurredAt      DateTime        @db.Timestamptz(3)
  category        ConductCategory
  summary         String
  incidentId      String?         @db.Uuid
  retractedAt     DateTime?       @db.Timestamptz(3)
  retractedReason String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
}

model IncidentAccessLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  incidentId String   @db.Uuid
  userId     String   @db.Uuid
  purpose    String
  accessedAt DateTime @default(now()) @db.Timestamptz(3)

  incident IncidentReport @relation(fields: [incidentId], references: [id], onDelete: Restrict)
}

// ------------------------------------------------------------------
// HR
// ------------------------------------------------------------------

model DisciplinaryRecord {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  userId           String    @db.Uuid
  issuedById       String    @db.Uuid
  issuedAt         DateTime  @db.Timestamptz(3)
  summary          String
  /// PNG data captured from the signature canvas.
  acknowledgementSignature Bytes?
  acknowledgedAt   DateTime? @db.Timestamptz(3)
  /// Union members may request a steward was present.
  stewardPresent   Boolean   @default(false)
  /// Step in progressive discipline (null on records made before levels existed).
  level            DisciplineLevel?
  /// Frozen copy of the facts relied on (events, notes) as they were when issued.
  evidence         Json      @default("[]")
  /// Fair-process confirmations made by the issuer, with the time they were made.
  fairProcess      Json?
  /// The employee's own written response, kept with the record.
  employeeResponse String?
  respondedAt      DateTime? @db.Timestamptz(3)

  user User @relation("DisciplineSubject", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, at])
}

// ------------------------------------------------------------------
// NOTIFICATIONS
// ------------------------------------------------------------------

/// Stored as a type + params (not text) so each person reads it in their own language.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  type      String // e.g. "shift_available", "claim_needs_approval"
  params    Json      @default("{}")
  /// In-app path to open, e.g. "/board"
  link      String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([tenantId])
}

/// Emails are queued here inside the business transaction and sent by the worker,
/// so a mail outage never loses or duplicates a business change.
model EmailOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  toEmail   String
  template  String
  params    Json      @default("{}")
  locale    String    @default("en-CA")
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([sentAt, createdAt])
}

// ------------------------------------------------------------------
// LESSONS
// ------------------------------------------------------------------

/// A weekly class (e.g. "Swimmer 3, Tuesdays 4:30 p.m.") between two dates.
model LessonClass {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  facilityId  String   @db.Uuid
  positionId  String   @db.Uuid // the instructor position whose shift covers it
  name        String
  level       String?
  dayOfWeek   Int // 0 = Sunday, facility local time
  startMinute Int
  endMinute   Int
  startsOn    DateTime @db.Date
  endsOn      DateTime @db.Date
  maxSwimmers Int      @default(8)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  enrollments LessonEnrollment[]
  attendance  LessonAttendance[]

  @@index([tenantId, facilityId, dayOfWeek])
}

/// Swimmers are often children: keep only what the instructor needs on deck.
model LessonEnrollment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  classId      String   @db.Uuid
  swimmerName  String
  /// Short safety note visible to the instructor (e.g. "Asthma: inhaler in bag").
  safetyNote   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  lessonClass LessonClass        @relation(fields: [classId], references: [id], onDelete: Restrict)
  attendance  LessonAttendance[]

  @@index([classId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

model LessonAttendance {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  classId      String           @db.Uuid
  enrollmentId String           @db.Uuid
  sessionDate  DateTime         @db.Date
  status       AttendanceStatus
  recordedById String           @db.Uuid
  /// When the instructor tapped it on the deck (may be before upload when offline).
  recordedAt   DateTime         @db.Timestamptz(3)
  /// Client-generated id, so a retried offline upload never double-counts.
  clientId     String           @unique
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  lessonClass LessonClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  enrollment  LessonEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, sessionDate])
}

// ------------------------------------------------------------------
// JOB BOARD
// ------------------------------------------------------------------

/// Public job posting. Applications go to the organization's own page or inbox
/// (applyUrl), so FH never collects applicant personal information.
model JobPosting {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  facilityId       String?          @db.Uuid
  title            String
  titleFr          String?
  description      String
  descriptionFr    String?
  employmentStatus EmploymentStatus
  payMin           Decimal?         @db.Decimal(10, 2)
  payMax           Decimal?         @db.Decimal(10, 2)
  closesOn         DateTime         @db.Date
  applyUrl         String
  published        Boolean          @default(false)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  @@index([tenantId, published, closesOn])
}

/// An organization's uploaded logo, served at /api/public/logo.
model TenantLogo {
  tenantId    String   @id @db.Uuid
  contentType String
  bytes       Bytes
  sha256      String
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

/// FlexcityHeadquarters staff who set up and support organizations (the Dev console).
/// Not tied to any tenant; never accepted by tenant routes.
model PlatformAdmin {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique
  name         String
  passwordHash String
  failedLogins Int               @default(0)
  lockedUntil  DateTime?         @db.Timestamptz(3)
  lastLoginAt  DateTime?         @db.Timestamptz(3)
  disabledAt   DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  sessions     PlatformSession[]
}

/// Opaque, revocable Dev console sessions (HTTP-only cookie). Only the hash is stored.
model PlatformSession {
  id        String        @id @default(uuid()) @db.Uuid
  adminId   String        @db.Uuid
  admin     PlatformAdmin @relation(fields: [adminId], references: [id])
  tokenHash String        @unique
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt DateTime      @db.Timestamptz(3)
  revokedAt DateTime?     @db.Timestamptz(3)

  @@index([adminId])
}

/// Everything done from the Dev console, across organizations.
model PlatformAudit {
  id       String   @id @default(uuid()) @db.Uuid
  adminId  String   @db.Uuid
  tenantId String?  @db.Uuid
  action   String
  detail   Json?
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, at])
}

/// A passkey (WebAuthn credential): Windows Hello, Face ID / Touch ID, Android
/// fingerprint or face unlock, or a security key. Only the public key is stored.
model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  userId       String    @db.Uuid
  /// base64url credential id
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)

  @@index([tenantId, userId])
}

/// Passkeys for FH Dev console accounts.
model PlatformPasskey {
  id           String    @id @default(uuid()) @db.Uuid
  adminId      String    @db.Uuid
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)

  @@index([adminId])
}

/// Single-use WebAuthn challenges (5 minutes).
model WebAuthnChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  challenge String    @unique
  /// register | login | step-up | platform-register | platform-login
  purpose   String
  tenantId  String?   @db.Uuid
  userId    String?   @db.Uuid
  adminId   String?   @db.Uuid
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
}

/// A role an organization defines for its own non-aquatic jobs ("Water Works
/// Operator", "Maintenance Lead"). Its permissions come only from the safe,
/// non-aquatic list in src/services/people/customRoles.ts.
model CustomRole {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  name        String
  nameFr      String?
  description String?
  permissions String[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  members     UserCustomRole[]

  @@unique([tenantId, name])
}

model UserCustomRole {
  tenantId     String     @db.Uuid
  userId       String     @db.Uuid
  customRoleId String     @db.Uuid
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@id([userId, customRoleId])
  @@index([tenantId, customRoleId])
}

/// A bather count taken on deck (the clicker). Kept apart from water chemistry.
model HeadCount {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  poolBodyId   String   @db.Uuid
  count        Int
  overCapacity Boolean  @default(false)
  recordedById String   @db.Uuid
  recordedAt   DateTime @default(now()) @db.Timestamptz(3)

  poolBody PoolBody @relation(fields: [poolBodyId], references: [id], onDelete: Restrict)

  @@index([poolBodyId, recordedAt])
  @@index([tenantId, recordedAt])
}

// ------------------------------------------------------------------ Billing
// FlexcityHeadquarters' own invoicing of organizations (Dev console only).

enum BillingPlan {
  /// Per facility per month by tier, unlimited staff.
  MUNICIPAL
  /// Base fee including 20 active users, then per active user.
  CLUB
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model BillingAccount {
  tenantId          String      @id @db.Uuid
  plan              BillingPlan @default(MUNICIPAL)
  legalName         String
  contactName       String?
  email             String
  addressLine1      String?
  addressLine2      String?
  city              String?
  /// Two-letter province or territory: decides the sales tax.
  province          String
  postalCode        String?
  poNumber          String?
  paymentTermsDays  Int         @default(30)
  taxExempt         Boolean     @default(false)
  taxExemptNote     String?
  addOnHr           Boolean     @default(false)
  addOnOps          Boolean     @default(false)
  /// CLUB plan: price per active user beyond the 20 included, in cents.
  clubUserRateCents Int         @default(500)
  notes             String?
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)
}

model Invoice {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  /// Assigned when sent, in sequence (FH-2026-0001); drafts have none.
  number        String?          @unique
  status        InvoiceStatus    @default(DRAFT)
  periodStart   DateTime         @db.Date
  periodEnd     DateTime         @db.Date
  issueDate     DateTime?        @db.Date
  dueDate       DateTime?        @db.Date
  currency      String           @default("CAD")
  subtotalCents Int              @default(0)
  /// [{ name: "GST", rate: "5", amountCents: 12500 }]
  taxLines      Json             @default("[]")
  totalCents    Int              @default(0)
  paidCents     Int              @default(0)
  /// The billing details as they were when sent.
  billTo        Json
  poNumber      String?
  notes         String?
  sentAt        DateTime?        @db.Timestamptz(3)
  paidAt        DateTime?        @db.Timestamptz(3)
  voidedAt      DateTime?        @db.Timestamptz(3)
  voidReason    String?
  createdById   String           @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  lines         InvoiceLine[]
  payments      InvoicePayment[]

  @@index([tenantId, periodStart])
  @@index([status])
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitCents   Int
  amountCents Int
}

model InvoicePayment {
  id           String   @id @default(uuid()) @db.Uuid
  invoiceId    String   @db.Uuid
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents  Int
  receivedOn   DateTime @db.Date
  /// EFT | CHEQUE | CARD | OTHER
  method       String
  reference    String?
  recordedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

model InvoiceCounter {
  year Int @id
  last Int @default(0)
}

/// Enquiries from the marketing website (sales, demo requests, support). Seen in the Dev console.
model Lead {
  id                String   @id @default(uuid()) @db.Uuid
  /// SALES | DEMO | SUPPORT
  kind              String
  name              String
  email             String
  organization      String?
  role              String?
  province          String?
  facilities        Int?
  message           String
  locale            String   @default("en-CA")
  /// CASL: express consent to marketing email, recorded separately from the enquiry itself.
  marketingConsent  Boolean  @default(false)
  consentText       String?
  /// NEW | CONTACTED | WON | CLOSED
  status            String   @default("NEW")
  notes             String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

/// Cross-city benchmark: quartiles of one measure across opted-in cities on a
/// date. No city ids or values are stored, and only when at least five cities
/// contribute. Platform-owned (no tenant).
model BenchmarkSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  metric     String
  computedOn DateTime @db.Date
  cities     Int
  p25        Float
  p50        Float
  p75        Float

  @@unique([metric, computedOn])
}
