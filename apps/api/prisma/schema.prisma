// Flexcity — aquatic staff management
//
// Conventions
// - Every tenant-scoped table carries `tenantId` so Postgres row-level security
//   (db/rls.sql) can isolate tenants without joins.
// - All instants are `@db.Timestamptz(3)`. Local-time reasoning (work days,
//   pay weeks, availability) always uses the Facility's IANA timezone.
// - Payroll-bearing rows use `onDelete: Restrict`. People are never hard-deleted;
//   see services/privacy/erasure.ts for retention-aware anonymization.
// - Money is Decimal, never Float.
// - Union Hub data is NOT in this schema. It lives in the `union_hub` Postgres
//   schema (db/union_hub.sql), reachable only through a separate DB role.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------

enum Province {
  BC
  AB
  SK
  MB
  ON
  QC
  NB
  NS
  PE
  NL
  YT
  NT
  NU
}

/// Permission roles (what a user may DO in the app). A user may hold several.
/// What a user may WORK is modelled separately by Position + certifications.
enum AccessRole {
  HR_ADMIN
  AQUATIC_SUPERVISOR
  HEAD_LIFEGUARD
  STAFF
  FRONT_DESK
  UNION_STEWARD
  /// General city employee (water works, maintenance, parks…): everyday work screens, nothing aquatic.
  EMPLOYEE
}

enum EmploymentStatus {
  FULL_TIME
  PART_TIME
  CASUAL
  ON_CALL
  VOLUNTEER
}

enum UserStatus {
  ACTIVE
  INACTIVE // seasonal / away at school — not billed, data retained
  TERMINATED
}

enum ShadowTier {
  A_SQUAD
  B_SQUAD
  C_SQUAD
  UNASSIGNED
}

enum ShiftType {
  STANDARD
  CUSTOM // e.g. private rental
  MANDATORY // e.g. in-service training
}

/// Lifecycle only. Claim/swap state lives on ShiftOffer, not here.
enum AccommodationStatus {
  ACTIVE
  CLOSED
}

enum CareStatus {
  OFFERED
  CHECKED_IN
  DECLINED
}

enum OvertimeEntryKind {
  ACCEPTED
  REFUSED
  NO_ANSWER
}

enum OnboardingOwner {
  HR
  SUPERVISOR
  EMPLOYEE
}

enum OnboardingKind {
  CHECK
  TRAINING
  ACKNOWLEDGEMENT
  DOCUMENT
  TASK
}

enum OnboardingStatus {
  COMPLETE
  WAIVED
}

enum DisciplineLevel {
  COACHING
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
  SUSPENSION
  TERMINATION
}

enum ConductCategory {
  SAFETY_PROCEDURE
  POLICY
  CONDUCT
  PERFORMANCE
  COMMENDATION
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OfferSource {
  OPEN_SHIFT // unassigned shift posted to the board
  SWAP // assigned shift the holder wants to give away
}

enum OfferStatus {
  OPEN
  PENDING_APPROVAL // claimant would incur overtime (or other soft rule) — supervisor decides
  COMPLETED
  DENIED
  CANCELLED
}

enum TimeOffType {
  VACATION
  SICK // statutory sick leave — protected
  PROTECTED_LEAVE // family responsibility, bereavement, jury duty, etc.
  UNPAID_PERSONAL
  OTHER
  /// Taken from banked overtime (time in lieu).
  LIEU
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum PunchLocationStatus {
  VERIFIED
  OUTSIDE_RADIUS
  LOW_ACCURACY
  NO_LOCATION
  FACILITY_NOT_CONFIGURED
}

enum PunchStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PoolBodyKind {
  POOL
  LEISURE_POOL
  HOT_TUB
  WADING_POOL
  WAVE_POOL
  SPLASH_PAD
}

enum PoolBodyStatus {
  OPEN
  CLOSURE_RECOMMENDED // system detected out-of-range reading, awaiting human confirmation
  CLOSED
}

enum ReliabilityEventType {
  LATE_PUNCH
  NO_SHOW
  MISSED_IN_SERVICE
  LATE_DROP // gave away a shift with < 24h notice
  PICKED_UP_SHIFT
}

enum PayCodeKey {
  REGULAR
  OVERTIME_1_5
  OVERTIME_2_0
  STAT_WORKED
  STAT_HOLIDAY_PAY
  SHIFT_PREMIUM
  VACATION_PAY
}

enum VacationPayMode {
  PAY_EACH_PERIOD
  ACCRUE
}

// ------------------------------------------------------------------
// TENANCY
// ------------------------------------------------------------------

model Tenant {
  /// Set by FH: nobody can sign in or use the organization's pages until it's cleared.
  disabledAt            DateTime?       @db.Timestamptz(3)
  disabledReason        String?
  /// Offboarded (contract ended): disabled, and its data is deleted after this date.
  offboardedAt          DateTime?       @db.Timestamptz(3)
  deleteAfter           DateTime?       @db.Date
  /// After offboarding, the organization's administrators can still sign in, only to download
  /// their full data export, until this moment (normally the deletion date).
  exportUntil           DateTime?       @db.Timestamptz(3)
  id                    String          @id @default(uuid()) @db.Uuid
  name                  String
  subdomain             String          @unique
  logoUrl               String?
  /// { primary, primaryHover, primaryContrast, accent } — injected as CSS variables
  themeColors           Json            @default("{}")
  defaultLocale         String          @default("en-CA")
  /// How clock times are shown: "auto" (the language's usual style), "12h" or "24h".
  timeFormat            String          @default("auto")
  /// 0 = Sunday ... 6 = Saturday, in each facility's local time
  payWeekStartDay       Int             @default(0)
  vacationPayMode       VacationPayMode @default(PAY_EACH_PERIOD)
  /// Years to keep payroll records after the end of the tax year they relate to.
  /// CRA requires 6; default adds a year of margin.
  payrollRetentionYears Int             @default(7)
  /// Direct deposit and remittance details: { businessNumber, originatorId, originatorShortName,
  /// originatorLongName, destinationDataCentre, returnsInstitution, returnsTransit, returnsAccount (sealed),
  /// employerAddress, twoPersonApproval, requirePasskey }.
  payrollSettings       Json            @default("{}")
  /// General-ledger accounts payroll posts to: { wages, employerCpp, employerEi, employerBenefits,
  /// cppPayable, eiPayable, taxPayable, pensionPayable, unionDuesPayable, benefitsPayable, netPayClearing }.
  accountingSettings    Json            @default("{}")
  /// How long routine records are kept: { notificationsDays, emailLogDays }. Missing = the defaults.
  retentionSettings     Json            @default("{}")
  /// Feature switches set from the FH Dev console: { featureKey: boolean }.
  /// Missing keys use the defaults in src/services/platform/features.ts.
  features              Json            @default("{}")
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)

  facilities      Facility[]
  users           User[]
  positions       Position[]
  departments     Department[]
  ssoConnection   SsoConnection?
  ruleOverrides   RuleOverride[]
  payCodeMappings PayCodeMapping[]
  /// Dev console per-role customization: { ROLE: { grant: [], revoke: [], hideMenu: [] } }.
  roleOverrides   Json             @default("{}")
  /// Overtime equalization: { countRefusals, clause, periodStartMonth }.
  overtimePolicy  Json             @default("{}")
  /// Care after critical incidents: { eap: "Employee assistance: 1-800-…" }.
  careSettings    Json             @default("{}")
  /// Shares anonymous measures with other cities (and sees theirs).
  benchmarkOptIn  Boolean          @default(false)
  /// Access levels that must sign in with a passkey as a second factor.
  mfaRoles        AccessRole[]     @default([])
  /// Winter operations, set by the city's managers: { season: { start: "11-01", end: "04-15" },
  /// callOuts: { responseMinutes, minRestHours }, patrols: { maxShiftHours } }.
  winterSettings  Json             @default("{}")
  /// Public sign-up portal: { enabled, terms, termsFr, payment, paymentFr, privacyContact }.
  signupSettings  Json             @default("{}")
}

/// Employment-standards province follows the WORK LOCATION, so it lives here,
/// not on Tenant (a YMCA association can span provinces).
model Facility {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  name                String
  province            Province
  timezone            String // IANA, e.g. "America/Vancouver"
  latitude            Decimal? @db.Decimal(9, 6)
  longitude           Decimal? @db.Decimal(9, 6)
  geoRadiusM          Int      @default(150)
  costCenter          String? // e.g. "CC-405-AQUATICS" for payroll export
  /// Facility size for public-sector pricing: 1 seasonal/outdoor (×0.4), 2 standard, 3 major complex (×2); null = not billed.
  billingTier         Int?
  /// Overrides this facility's price (cents per month) when set.
  billingMonthlyCents Int?
  /// Deck rotation: minutes on one station before moving on.
  rotationMinutes     Int      @default(30)
  /// Fatigue limit: continuous minutes on stations (across rotations) before a break.
  maxOnChairMinutes   Int      @default(120)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  shifts       Shift[]
  poolBodies   PoolBody[]
  timePunches  TimePunch[]
  incidents    IncidentReport[]
  deckStations DeckStation[]
  openHours    FacilityHours[]

  @@index([tenantId])
}

/// When a facility is open, by weekday (several blocks a day allowed), and the fewest lifeguards
/// on deck at any open hour, whatever the bather count. The forecast and its draft shifts use it.
model FacilityHours {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  facilityId   String   @db.Uuid
  /// 0 = Sunday, facility local time.
  dayOfWeek    Int
  opensMinute  Int
  closesMinute Int
  minGuards    Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([tenantId, facilityId, dayOfWeek])
}

/// Tenant-specific overrides of provincial rules, e.g. a collective agreement
/// that pays OT after 7.5h/day. Effective-dated so history recalculates correctly.
model RuleOverride {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  province      Province?
  ruleKey       String // e.g. "dailyOvertimeHours"
  value         Json
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  source        String? // e.g. "CUPE Local 338 CBA art. 14.02"

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, ruleKey, effectiveFrom])
}

// ------------------------------------------------------------------
// PEOPLE
// ------------------------------------------------------------------

model User {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  roles            AccessRole[]
  status           UserStatus       @default(ACTIVE)
  employmentStatus EmploymentStatus
  shadowTier       ShadowTier       @default(UNASSIGNED) // set by a manager, never automatically

  firstName        String
  lastName         String
  email            String
  phone            String?
  locale           String    @default("en-CA")
  /// Needed only to apply young-worker rules. Not exported anywhere.
  dateOfBirth      DateTime? @db.Date
  /// Identity-provider subject this account is bound to after its first single sign-on ("issuer|subject").
  ssoSubject       String?
  /// Mobile number confirmed with a texted code (E.164), for urgent texts and calls when the city turns them on.
  smsPhone         String?
  smsVerifiedAt    DateTime? @db.Timestamptz(3)
  /// Also text me about open shifts starting within the next 24 hours.
  smsUrgentShifts  Boolean   @default(false)
  /// The person agreed to bank overtime as time in lieu instead of being paid for it (where the city allows it).
  bankOvertime     Boolean   @default(false)
  bankOvertimeAt   DateTime? @db.Timestamptz(3)
  /// Private calendar feed: SHA-256 of the link's secret (the link itself is shown once).
  calendarTokenHash String?   @unique
  calendarTokenAt   DateTime? @db.Timestamptz(3)
  /// PIN for punching at a facility's shared kiosk (hashed like a password).
  kioskPinHash      String?
  /// The employer's HR/payroll system ID — used in payroll exports.
  employeeNumber   String?
  passwordHash     String?
  /// Account lockout after repeated failed sign-ins.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(3)

  hireDate       DateTime? @db.Date
  /// Collective-agreement seniority can differ from hire date; hours-based
  /// seniority is accumulated separately.
  seniorityDate  DateTime? @db.Date
  seniorityHours Decimal   @default(0) @db.Decimal(10, 2)
  /// Target / cap hours per week, used by the scheduling assistant.
  weeklyMinHours Decimal?  @db.Decimal(5, 2)
  weeklyMaxHours Decimal?  @db.Decimal(5, 2)
  vscClearedDate DateTime? @db.Date
  unionMember    Boolean   @default(false)

  /// Advisory only (see services/reliability). Never drives automated decisions.
  reliabilityScore Int       @default(100)
  /// Set while the nightly review flags this person for HR / supervisor attention.
  reviewFlaggedAt  DateTime? @db.Timestamptz(3)

  /// Privacy: set when erasure was requested but payroll retention still applies.
  processingRestrictedAt DateTime? @db.Timestamptz(3)
  erasureDueAt           DateTime? @db.Date
  anonymizedAt           DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  positions           UserPosition[]
  payRates            PayRate[]
  certifications      UserCertification[]
  availability        Availability[]
  timeOffRequests     TimeOffRequest[]
  shifts              Shift[]
  timePunches         TimePunch[]
  offersPosted        ShiftOffer[]         @relation("OfferPostedBy")
  offersClaimed       ShiftOffer[]         @relation("OfferClaimedBy")
  reliabilityEvents   ReliabilityEvent[]
  conductNotes        ConductNote[]
  onboarding          OnboardingRecord[]
  accommodations      AccommodationCase[]
  refreshTokens       RefreshToken[]
  managesDepartments  DepartmentManager[]
  payProfile          PayProfile?
  bankAccounts        BankAccount[]
  payStatements       PayStatement[]
  benefitEnrollments  BenefitEnrollment[]
  leaveEntitlements   LeaveEntitlement[]
  trainingRecords     TrainingRecord[]
  authTokens          AuthToken[]
  disciplinaryRecords DisciplinaryRecord[] @relation("DisciplineSubject")

  @@unique([tenantId, email])
  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status])
}

model RefreshToken {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  userId          String    @db.Uuid
  /// SHA-256 of the opaque token; the raw token only ever lives in an HTTP-only cookie.
  tokenHash       String    @unique
  /// Rotation family — reuse of a revoked token revokes the whole family.
  familyId        String    @db.Uuid
  /// When the person last proved who they are (password or passkey), carried
  /// through rotation. Sensitive actions need this to be recent.
  authenticatedAt DateTime  @default(now()) @db.Timestamptz(3)
  /// When this session proved a second factor (a passkey), carried through
  /// rotation. Null = password only.
  mfaAt           DateTime? @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([familyId])
}

enum AuthTokenPurpose {
  INVITE
  RESET
  /// One-time hand-off after single sign-on, traded for a session on the organization's own site.
  SSO
  /// The same, when the identity provider confirmed a second factor.
  SSO_MFA
  /// A code texted to confirm a mobile number.
  SMS_VERIFY
}

/// One-time links for invitations and password resets. Only a hash is stored.
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
}

// ------------------------------------------------------------------
// POSITIONS, PAY & CERTIFICATIONS
// ------------------------------------------------------------------

/// What can be worked: "Lifeguard", "Swim Instructor", "Head Lifeguard"...
/// Shifts require a Position; Positions require certifications.
model Position {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @db.Uuid
  name           String
  nameFr         String?
  minimumAge     Int?
  /// Driving limits for this position: { maxDailyHours, minRestHours, maxHoursIn7Days }.
  /// Empty = no limits beyond the province's rules.
  hoursOfService Json?
  /// The department this position belongs to (Aquatics, Water Works…). Null = none yet.
  departmentId   String? @db.Uuid

  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  department      Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  requirements    PositionCertRequirement[]
  qualifiedUsers  UserPosition[]
  payRates        PayRate[]
  shifts          Shift[]
  payCodeMappings PayCodeMapping[]
  onboarding      PositionOnboarding[]

  @@unique([tenantId, name])
}

/// A part of the city's workforce: Aquatics, Water Works, Parks… Supervisors and
/// managers see only their departments; HR sees every department.
model Department {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  name         String
  nameFr       String?
  /// The built-in aquatic roles (supervisor, head lifeguard) manage this department.
  aquatic      Boolean             @default(false)
  /// General-ledger segment (cost centre) its labour costs post to.
  glCode       String?
  /// Labour budget for the year, for budget-to-actual.
  labourBudget Decimal?            @db.Decimal(14, 2)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  positions    Position[]
  managers     DepartmentManager[]

  @@unique([tenantId, name])
}

/// A supervisor or manager HR chose to run a department. A department can have several.
model DepartmentManager {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  departmentId String     @db.Uuid
  userId       String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

/// Work restrictions from an accommodation or return-to-work plan. Holds the
/// restrictions only, never a diagnosis; the scheduler enforces them and
/// supervisors see only that a shift is outside the person's restrictions.
model AccommodationCase {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @db.Uuid
  userId              String              @db.Uuid
  status              AccommodationStatus @default(ACTIVE)
  /// General label only, e.g. "Return to work" (no medical details).
  label               String
  startsOn            DateTime            @db.Date
  endsOn              DateTime?           @db.Date
  reviewOn            DateTime?           @db.Date
  maxShiftHours       Decimal?            @db.Decimal(4, 2)
  maxWeeklyHours      Decimal?            @db.Decimal(5, 2)
  /// Minutes after midnight, local time.
  noStartBefore       Int?
  noEndAfter          Int?
  /// Days of week (0 = Sunday) not to schedule.
  daysOff             Int[]
  excludedPositionIds String[]            @db.Uuid
  createdById         String              @db.Uuid
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  closedAt            DateTime?           @db.Timestamptz(3)
  reviewNotifiedAt    DateTime?           @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

/// A private check-in offered after a critical incident. Only that it was
/// offered and followed up is kept, never what was said.
model CareCheckIn {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  userId        String     @db.Uuid
  incidentId    String     @db.Uuid
  status        CareStatus @default(OFFERED)
  dueAt         DateTime   @db.Timestamptz(3)
  breakAskedAt  DateTime?  @db.Timestamptz(3)
  completedAt   DateTime?  @db.Timestamptz(3)
  completedById String?    @db.Uuid
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([incidentId, userId])
  @@index([status, dueAt])
}

/// Overtime equalization ledger: overtime accepted (automatic from approvals
/// and assignments) and call-outs refused or unanswered (recorded by a supervisor).
model OvertimeEntry {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  userId       String            @db.Uuid
  positionId   String?           @db.Uuid
  shiftId      String?           @db.Uuid
  kind         OvertimeEntryKind
  hours        Decimal           @db.Decimal(6, 2)
  occurredAt   DateTime          @db.Timestamptz(3)
  recordedById String            @db.Uuid
  note         String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@index([userId, occurredAt])
}

/// One onboarding requirement in a city's catalogue: a check, training, policy
/// to acknowledge, document to collect or task to do, and who completes it.
/// Sensitive results (police checks, SIN) are never stored: only that they
/// were seen, when, and by whom.
model OnboardingItem {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  /// Stable key for the built-in catalogue (null for city-made items).
  key              String?
  name             String
  nameFr           String?
  description      String?
  descriptionFr    String?
  owner            OnboardingOwner
  kind             OnboardingKind
  /// Required for everyone, whatever their position.
  allStaff         Boolean         @default(false)
  /// Must be done (and not expired) before the person can be scheduled.
  blocksScheduling Boolean         @default(false)
  /// Renewal period; null = never expires.
  validityMonths   Int?
  /// Text the employee reads before acknowledging (policies).
  policyText       String?
  sortOrder        Int             @default(0)
  archivedAt       DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  positions PositionOnboarding[]
  records   OnboardingRecord[]

  @@unique([tenantId, key])
}

/// Which items a position requires (the per-position switches).
model PositionOnboarding {
  tenantId   String @db.Uuid
  positionId String @db.Uuid
  itemId     String @db.Uuid

  position Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  item     OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([positionId, itemId])
}

/// A completed or waived item for a person. Renewals add a new record.
model OnboardingRecord {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  userId         String           @db.Uuid
  itemId         String           @db.Uuid
  status         OnboardingStatus
  completedOn    DateTime         @db.Date
  expiresOn      DateTime?        @db.Date
  recordedById   String           @db.Uuid
  recordedAt     DateTime         @default(now()) @db.Timestamptz(3)
  /// Factual and non-sensitive (e.g. "Seen: clear, ref. on file with RCMP"); never the result itself.
  note           String?
  waivedReason   String?
  reminderSentAt DateTime?        @db.Timestamptz(3)

  item OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, itemId])
}

model PositionCertRequirement {
  tenantId        String @db.Uuid
  positionId      String @db.Uuid
  certificationId String @db.Uuid

  position      Position      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id])

  @@id([positionId, certificationId])
}

/// A manager has approved this user to work this position.
model UserPosition {
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  positionId String   @db.Uuid
  approvedAt DateTime @default(now()) @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@id([userId, positionId])
}

/// Effective-dated, per position — a guard and an instructor shift can pay differently.
model PayRate {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  userId        String    @db.Uuid
  positionId    String    @db.Uuid
  hourlyRate    Decimal   @db.Decimal(10, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([userId, positionId, effectiveFrom])
}

/// Global catalogue rows have tenantId = null; tenants may add their own.
model Certification {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String? @db.Uuid
  name           String
  nameFr         String?
  issuingBody    String
  /// null = does not expire
  validityMonths Int?

  userCerts      UserCertification[]
  requiredFor    PositionCertRequirement[]
  prerequisites  CertificationPrerequisite[] @relation("CertRequires")
  prerequisiteOf CertificationPrerequisite[] @relation("CertIsRequiredBy")
}

/// e.g. National Lifeguard is only valid while the holder also has current
/// Standard First Aid.
model CertificationPrerequisite {
  certificationId String @db.Uuid
  requiresId      String @db.Uuid

  certification Certification @relation("CertRequires", fields: [certificationId], references: [id], onDelete: Cascade)
  requires      Certification @relation("CertIsRequiredBy", fields: [requiresId], references: [id], onDelete: Cascade)

  @@id([certificationId, requiresId])
}

model UserCertification {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  userId          String    @db.Uuid
  certificationId String    @db.Uuid
  issueDate       DateTime  @db.Date
  /// null = does not expire
  expiryDate      DateTime? @db.Date
  documentUrl     String?
  verifiedById    String?   @db.Uuid
  verifiedAt      DateTime? @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  certification Certification @relation(fields: [certificationId], references: [id])

  @@index([tenantId, expiryDate])
  @@index([userId])
}

// ------------------------------------------------------------------
// AVAILABILITY & TIME OFF
// ------------------------------------------------------------------

/// Recurring weekly availability, in the facility's local time.
model Availability {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  userId        String    @db.Uuid
  dayOfWeek     Int // 0 = Sunday
  startMinute   Int // minutes after local midnight
  endMinute     Int // may exceed 1440 for availability running past midnight
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model TimeOffRequest {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  userId       String        @db.Uuid
  type         TimeOffType
  startsAt     DateTime      @db.Timestamptz(3)
  endsAt       DateTime      @db.Timestamptz(3)
  status       RequestStatus @default(PENDING)
  note         String?
  decisionNote String?
  decidedById  String?       @db.Uuid
  decidedAt    DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, startsAt, endsAt])
  /// Leave hours this request used, measured at approval from the person's scheduled shifts in it
  /// (their shifts are released when it's approved); weekdays × 8 h when nothing was scheduled.
  chargedHours     Decimal?  @db.Decimal(8, 2)
  chargedBasis     String?
}

// ------------------------------------------------------------------
// SCHEDULING
// ------------------------------------------------------------------

model Shift {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  facilityId     String      @db.Uuid
  positionId     String      @db.Uuid
  userId         String?     @db.Uuid // null = open shift
  startsAt       DateTime    @db.Timestamptz(3)
  endsAt         DateTime    @db.Timestamptz(3)
  shiftType      ShiftType   @default(STANDARD)
  status         ShiftStatus @default(DRAFT)
  customTitle    String?
  /// Extra $/h on top of the base rate (e.g. specialised class).
  premiumPerHour Decimal?    @db.Decimal(10, 2)
  /// Why the scheduling assistant could not fill it (null when filled or not attempted).
  conflictReason String?
  /// Optimistic-lock counter. Every assignment change must match + increment it.
  version        Int         @default(0)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  position    Position     @relation(fields: [positionId], references: [id], onDelete: Restrict)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  timePunches TimePunch[]
  offers      ShiftOffer[]

  @@index([tenantId, facilityId, startsAt, endsAt])
  @@index([userId, startsAt])
}

/// A shift on the Shift Board: either an open shift or a swap offer.
/// The original holder stays responsible until status = COMPLETED.
model ShiftOffer {
  id                 String      @id @default(uuid()) @db.Uuid
  tenantId           String      @db.Uuid
  shiftId            String      @db.Uuid
  source             OfferSource
  postedById         String?     @db.Uuid // null for OPEN_SHIFT posted by the system
  claimedById        String?     @db.Uuid
  status             OfferStatus @default(OPEN)
  /// Snapshot of the compliance evaluation at claim time (reasons, OT hours).
  complianceSnapshot Json?
  decidedById        String?     @db.Uuid
  decidedAt          DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  shift     Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  postedBy  User? @relation("OfferPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  claimedBy User? @relation("OfferClaimedBy", fields: [claimedById], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([shiftId])
}

enum SchoolPeriodKind {
  TERM
  BREAK
}

/// The organization's local school calendar, used for young-worker hour limits
/// (school-day vs non-school-day limits, no work during school hours).
model SchoolCalendarPeriod {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @db.Uuid
  kind     SchoolPeriodKind
  name     String
  startsOn DateTime         @db.Date
  endsOn   DateTime         @db.Date

  @@index([tenantId, startsOn])
}

model StatutoryHoliday {
  id       String   @id @default(uuid()) @db.Uuid
  province Province
  date     DateTime @db.Date
  name     String
  nameFr   String?

  @@unique([province, date])
}

// ------------------------------------------------------------------
// TIMEKEEPING
// ------------------------------------------------------------------

model TimePunch {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  userId         String              @db.Uuid
  facilityId     String              @db.Uuid
  /// Nullable: unscheduled call-ins still need a punch.
  shiftId        String?             @db.Uuid
  /// Position worked — determines pay rate. Defaults from the shift.
  positionId     String              @db.Uuid
  clockIn        DateTime            @db.Timestamptz(3)
  clockOut       DateTime?           @db.Timestamptz(3)
  ipAddress      String?
  latitude       Decimal?            @db.Decimal(9, 6)
  longitude      Decimal?            @db.Decimal(9, 6)
  accuracyM      Int?
  distanceM      Int?
  locationStatus PunchLocationStatus @default(NO_LOCATION)
  status         PunchStatus         @default(PENDING)
  varianceReason String?
  /// Punched at this facility kiosk (a shared tablet), not on the person's own device.
  kioskId        String?             @db.Uuid
  reviewedById   String?             @db.Uuid
  reviewedAt     DateTime?           @db.Timestamptz(3)
  /// Ids the phone gave each tap, so a re-sent punch is recognised instead of saved twice.
  clientInId     String?             @db.Uuid
  clientOutId    String?             @db.Uuid
  /// Saved on the phone without a connection and sent later: flagged for review.
  recordedOffline Boolean            @default(false)
  /// When an offline clock-in / clock-out reached the server (null when sent live).
  clockInReceivedAt  DateTime?       @db.Timestamptz(3)
  clockOutReceivedAt DateTime?       @db.Timestamptz(3)
  /// How far the phone's clock was off the server's, in seconds (+ = phone behind), when measured.
  /// Offline times are corrected by it; large differences are flagged for review.
  clockSkewS     Int?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  facility Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  shift    Shift?          @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  edits    TimePunchEdit[]

  @@unique([tenantId, clientInId])
  @@unique([tenantId, clientOutId])
  @@index([tenantId, userId, clockIn])
  /// Punch review lists one status (pending first) by time.
  @@index([tenantId, status, clockIn])
}

/// Every change to a punch is recorded — original values are never lost.
model TimePunchEdit {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  punchId    String   @db.Uuid
  editedById String   @db.Uuid
  field      String
  oldValue   String?
  newValue   String?
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  punch TimePunch @relation(fields: [punchId], references: [id], onDelete: Restrict)

  @@index([punchId])
}

model PayCodeMapping {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  key        PayCodeKey
  /// null = default for all positions
  positionId String?    @db.Uuid
  code       String // employer's pay code, e.g. "REG_LIFEGUARD"

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])

  @@unique([tenantId, key, positionId])
}

// ------------------------------------------------------------------
// RELIABILITY (advisory)
// ------------------------------------------------------------------

model ReliabilityEvent {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  userId         String               @db.Uuid
  type           ReliabilityEventType
  occurredAt     DateTime             @db.Timestamptz(3)
  /// e.g. punch id / offer id that produced the event
  sourceId       String?
  /// Set when the event overlaps protected leave or a manager excuses it.
  excludedReason String?
  /// Who excused it and when (null for automatic exclusions).
  excusedById    String?              @db.Uuid
  excusedAt      DateTime?            @db.Timestamptz(3)
  /// Recorded by a supervisor (missed in-service, a no-show the timeclock can't see).
  recordedById   String?              @db.Uuid
  /// Factual note the employee can read alongside the event.
  note           String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
}

// ------------------------------------------------------------------
// AQUATIC OPERATIONS
// ------------------------------------------------------------------

/// A body of water with its own chemistry and its own thresholds.
/// Thresholds come from the applicable provincial / health-authority regulation
/// and MUST be configured before readings are accepted — there are no defaults.
model PoolBody {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @db.Uuid
  facilityId             String         @db.Uuid
  name                   String
  kind                   PoolBodyKind
  status                 PoolBodyStatus @default(OPEN)
  freeChlorineMinPpm     Decimal?       @db.Decimal(5, 2)
  freeChlorineMaxPpm     Decimal?       @db.Decimal(5, 2)
  combinedChlorineMaxPpm Decimal?       @db.Decimal(5, 2)
  phMin                  Decimal?       @db.Decimal(4, 2)
  phMax                  Decimal?       @db.Decimal(4, 2)
  thresholdSource        String? // e.g. "BC Pool Regulation / Interior Health permit conditions"
  /// Max bathers per on-duty lifeguard, per the regulation / facility safety plan.
  bathersPerLifeguard    Int?
  /// Maximum bathers allowed at once (permit / occupant load). Headcounts above it alert supervisors.
  maxCapacity            Int?
  depthMinM              Decimal?       @db.Decimal(4, 2)
  depthMaxM              Decimal?       @db.Decimal(4, 2)
  volumeLitres           Int?
  notes                  String?
  /// Retired pools keep their history but leave the deck screens.
  archivedAt             DateTime?      @db.Timestamptz(3)
  headcounts             HeadCount[]

  facility Facility          @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  readings ChemicalReading[]
  closures PoolClosure[]

  @@index([facilityId])
}

model ChemicalReading {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  poolBodyId        String    @db.Uuid
  recordedById      String    @db.Uuid
  recordedAt        DateTime  @db.Timestamptz(3)
  freeChlorinePpm   Decimal?  @db.Decimal(5, 2)
  totalChlorinePpm  Decimal?  @db.Decimal(5, 2)
  ph                Decimal?  @db.Decimal(4, 2)
  waterTempC        Decimal?  @db.Decimal(4, 1)
  batherCount       Int?
  outOfRange        Boolean   @default(false)
  outOfRangeDetails Json?
  signedOffById     String?   @db.Uuid
  signedOffAt       DateTime? @db.Timestamptz(3)

  poolBody PoolBody @relation(fields: [poolBodyId], references: [id], onDelete: Restrict)

  @@index([poolBodyId, recordedAt])
}

model PoolClosure {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  poolBodyId    String    @db.Uuid
  readingId     String?   @db.Uuid
  reason        String
  recommendedAt DateTime  @db.Timestamptz(3)
  confirmedById String?   @db.Uuid
  confirmedAt   DateTime? @db.Timestamptz(3)
  dismissedById String?   @db.Uuid
  dismissedAt   DateTime? @db.Timestamptz(3)
  reopenedById  String?   @db.Uuid
  reopenedAt    DateTime? @db.Timestamptz(3)

  poolBody PoolBody @relation(fields: [poolBodyId], references: [id], onDelete: Restrict)

  @@index([poolBodyId, recommendedAt])
}

/// Envelope-encrypted: the narrative is AES-256-GCM encrypted with a per-record
/// data key, which is itself wrapped by the tenant's KMS key.
model IncidentReport {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  facilityId     String   @db.Uuid
  reportedById   String   @db.Uuid
  occurredAt     DateTime @db.Timestamptz(3)
  category       String // non-sensitive, for reporting (e.g. "FIRST_AID", "RESCUE")
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  wrappedDataKey Bytes
  kekId          String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  facility  Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  accessLog IncidentAccessLog[]

  @@index([tenantId, occurredAt])
}

/// A lifeguard station on deck (a chair, a roving position, the slide tower).
model DeckStation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  facilityId String    @db.Uuid
  poolBodyId String?   @db.Uuid
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId])
}

/// Who was on which station, from when to when. stationId null = off the chair (break, other duties).
model RotationLog {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  facilityId        String    @db.Uuid
  stationId         String?   @db.Uuid
  userId            String    @db.Uuid
  startedAt         DateTime  @db.Timestamptz(3)
  endedAt           DateTime? @db.Timestamptz(3)
  recordedById      String    @db.Uuid
  overdueNotifiedAt DateTime? @db.Timestamptz(3)

  @@index([facilityId, startedAt])
  @@index([userId, startedAt])
}

/// A supervisor's factual note about someone's conduct or performance,
/// optionally tied to an incident. Being named in an incident report never
/// creates one: a person decides, so reporting stays safe.
model ConductNote {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  userId          String          @db.Uuid
  recordedById    String          @db.Uuid
  occurredAt      DateTime        @db.Timestamptz(3)
  category        ConductCategory
  summary         String
  incidentId      String?         @db.Uuid
  retractedAt     DateTime?       @db.Timestamptz(3)
  retractedReason String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
}

model IncidentAccessLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  incidentId String   @db.Uuid
  userId     String   @db.Uuid
  purpose    String
  accessedAt DateTime @default(now()) @db.Timestamptz(3)

  incident IncidentReport @relation(fields: [incidentId], references: [id], onDelete: Restrict)
}

// ------------------------------------------------------------------
// HR
// ------------------------------------------------------------------

model DisciplinaryRecord {
  id                       String           @id @default(uuid()) @db.Uuid
  tenantId                 String           @db.Uuid
  userId                   String           @db.Uuid
  issuedById               String           @db.Uuid
  issuedAt                 DateTime         @db.Timestamptz(3)
  summary                  String
  /// PNG data captured from the signature canvas.
  acknowledgementSignature Bytes?
  acknowledgedAt           DateTime?        @db.Timestamptz(3)
  /// SHA-256 of exactly what was signed (content at signing) and of the signature image.
  signedSha256             String?
  signatureSha256          String?
  /// Union members may request a steward was present.
  stewardPresent           Boolean          @default(false)
  /// Step in progressive discipline (null on records made before levels existed).
  level                    DisciplineLevel?
  /// Frozen copy of the facts relied on (events, notes) as they were when issued.
  evidence                 Json             @default("[]")
  /// Fair-process confirmations made by the issuer, with the time they were made.
  fairProcess              Json?
  /// The employee's own written response, kept with the record.
  employeeResponse         String?
  respondedAt              DateTime?        @db.Timestamptz(3)

  user User @relation("DisciplineSubject", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model AuditLog {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  actorId  String?  @db.Uuid
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, at])
}

// ------------------------------------------------------------------
// NOTIFICATIONS
// ------------------------------------------------------------------

/// Stored as a type + params (not text) so each person reads it in their own language.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  type      String // e.g. "shift_available", "claim_needs_approval"
  params    Json      @default("{}")
  /// In-app path to open, e.g. "/board"
  link      String?
  readAt    DateTime? @db.Timestamptz(3)
  /// Sent to the person's devices (web push), or skipped because they have none.
  pushedAt  DateTime? @db.Timestamptz(3)
  /// Set when written by the event outbox: "<event id>:<recipient hash>", so a redelivered event never notifies twice.
  dedupeKey String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, dedupeKey])
  @@index([userId, createdAt])
  @@index([tenantId])
}

enum EventStatus {
  PENDING
  DELIVERED
  /// Gave up after the last attempt; kept for an operator to look at (lib/outbox.ts).
  DEAD
}

/// Transactional outbox for domain events (lib/outbox.ts). Written in the same transaction as the
/// change it describes; the dispatcher (API process right after commit, and the worker every few
/// seconds) delivers each one at least once. The payload is cleared once delivered.
model EventOutbox {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  type        String
  payload     Json        @default("{}")
  status      EventStatus @default(PENDING)
  attempts    Int         @default(0)
  /// Not before: retries back off by pushing this forward.
  availableAt DateTime    @default(now()) @db.Timestamptz(3)
  lastError   String?
  deliveredAt DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([tenantId, status, availableAt])
}

/// Emails are queued here inside the business transaction and sent by the worker,
/// so a mail outage never loses or duplicates a business change.
model EmailOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  toEmail   String
  template  String
  params    Json      @default("{}")
  locale    String    @default("en-CA")
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([sentAt, createdAt])
}

// ------------------------------------------------------------------
// LESSONS
// ------------------------------------------------------------------

/// A weekly class (e.g. "Swimmer 3, Tuesdays 4:30 p.m.") between two dates.
model LessonClass {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  facilityId       String   @db.Uuid
  positionId       String   @db.Uuid // the instructor position whose shift covers it
  name             String
  level            String?
  dayOfWeek        Int // 0 = Sunday, facility local time
  startMinute      Int
  endMinute        Int
  startsOn         DateTime @db.Date
  endsOn           DateTime @db.Date
  maxSwimmers      Int      @default(8)
  /// Several days a week (e.g. Monday to Friday); empty = just `dayOfWeek`.
  daysOfWeek       Int[]    @default([])
  /// Part of a registration campaign (lessons, swim club…), with its level and price.
  campaignId       String?  @db.Uuid
  levelId          String?  @db.Uuid
  minAgeMonths     Int?
  maxAgeMonths     Int?
  priceCents       Int?
  memberPriceCents Int?
  /// Instructors and member services see it once its campaign is published.
  published        Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  enrollments LessonEnrollment[]
  attendance  LessonAttendance[]

  @@index([tenantId, facilityId, dayOfWeek])
}

/// Swimmers are often children: keep only what the instructor needs on deck.
model LessonEnrollment {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  classId        String           @db.Uuid
  swimmerName    String
  /// Short safety note visible to the instructor (e.g. "Asthma: inhaler in bag").
  safetyNote     String?
  active         Boolean          @default(true)
  /// Registered by member services for a child (or adult) on file.
  memberId       String?          @db.Uuid
  householdId    String?          @db.Uuid
  status         EnrollmentStatus @default(ENROLLED)
  priceCents     Int?
  registeredById String?          @db.Uuid
  /// Age check skipped by staff, and why.
  ageOverride    String?
  /// STAFF (member services) or ONLINE (the public sign-up page).
  source         String           @default("STAFF")
  /// Reference given to the family, e.g. R-7F3K2Q.
  reference      String?          @unique
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  lessonClass LessonClass        @relation(fields: [classId], references: [id], onDelete: Restrict)
  attendance  LessonAttendance[]

  @@index([classId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

model LessonAttendance {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  classId      String           @db.Uuid
  enrollmentId String           @db.Uuid
  sessionDate  DateTime         @db.Date
  status       AttendanceStatus
  recordedById String           @db.Uuid
  /// When the instructor tapped it on the deck (may be before upload when offline).
  recordedAt   DateTime         @db.Timestamptz(3)
  /// Client-generated id, so a retried offline upload never double-counts.
  clientId     String           @unique
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  lessonClass LessonClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  enrollment  LessonEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, sessionDate])
}

// ------------------------------------------------------------------
// JOB BOARD
// ------------------------------------------------------------------

/// Public job posting. Applications go to the organization's own page or inbox
/// (applyUrl), so FH never collects applicant personal information.
model JobPosting {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  facilityId       String?          @db.Uuid
  title            String
  titleFr          String?
  description      String
  descriptionFr    String?
  employmentStatus EmploymentStatus
  payMin           Decimal?         @db.Decimal(10, 2)
  payMax           Decimal?         @db.Decimal(10, 2)
  closesOn         DateTime         @db.Date
  /// Where to apply when not in the app (an https link or a mailto: address).
  applyUrl         String?
  /// Applicants apply on the careers page; applications land in FH.
  applyInApp       Boolean          @default(false)
  published        Boolean          @default(false)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  @@index([tenantId, published, closesOn])
}

/// An organization's uploaded logo, served at /api/public/logo.
model TenantLogo {
  tenantId    String   @id @db.Uuid
  contentType String
  bytes       Bytes
  sha256      String
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

/// FlexcityHeadquarters staff who set up and support organizations (the Dev console).
/// Not tied to any tenant; never accepted by tenant routes.
model PlatformAdmin {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique
  name         String
  passwordHash String
  failedLogins Int               @default(0)
  lockedUntil  DateTime?         @db.Timestamptz(3)
  lastLoginAt  DateTime?         @db.Timestamptz(3)
  disabledAt   DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  sessions     PlatformSession[]
}

/// Opaque, revocable Dev console sessions (HTTP-only cookie). Only the hash is stored.
model PlatformSession {
  id        String        @id @default(uuid()) @db.Uuid
  adminId   String        @db.Uuid
  admin     PlatformAdmin @relation(fields: [adminId], references: [id])
  tokenHash String        @unique
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt DateTime      @db.Timestamptz(3)
  revokedAt DateTime?     @db.Timestamptz(3)
  /// When this session proved a second factor (a passkey). Null = password only.
  mfaAt     DateTime?     @db.Timestamptz(3)

  @@index([adminId])
}

/// Everything done from the Dev console, across organizations.
model PlatformAudit {
  id       String   @id @default(uuid()) @db.Uuid
  adminId  String   @db.Uuid
  tenantId String?  @db.Uuid
  action   String
  detail   Json?
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, at])
}

/// A passkey (WebAuthn credential): Windows Hello, Face ID / Touch ID, Android
/// fingerprint or face unlock, or a security key. Only the public key is stored.
model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  userId       String    @db.Uuid
  /// base64url credential id
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)

  @@index([tenantId, userId])
}

/// Passkeys for FH Dev console accounts.
model PlatformPasskey {
  id           String    @id @default(uuid()) @db.Uuid
  adminId      String    @db.Uuid
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)

  @@index([adminId])
}

/// Single-use WebAuthn challenges (5 minutes).
model WebAuthnChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  challenge String    @unique
  /// register | login | step-up | platform-register | platform-login
  purpose   String
  tenantId  String?   @db.Uuid
  userId    String?   @db.Uuid
  adminId   String?   @db.Uuid
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
}

/// A role an organization defines for its own non-aquatic jobs ("Water Works
/// Operator", "Maintenance Lead"). Its permissions come only from the safe,
/// non-aquatic list in src/services/people/customRoles.ts.
model CustomRole {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  name               String
  nameFr             String?
  description        String?
  permissions        String[]
  /// Department scope: lead and manager capabilities reach only people who hold
  /// one of these positions (empty = every position)…
  scopePositionIds   String[]         @default([]) @db.Uuid
  /// …and only shifts at these facilities (empty = every facility).
  scopeFacilityIds   String[]         @default([]) @db.Uuid
  /// …or every position in these departments, including ones added later.
  scopeDepartmentIds String[]         @default([]) @db.Uuid
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  members            UserCustomRole[]

  @@unique([tenantId, name])
}

model UserCustomRole {
  tenantId     String     @db.Uuid
  userId       String     @db.Uuid
  customRoleId String     @db.Uuid
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@id([userId, customRoleId])
  @@index([tenantId, customRoleId])
}

/// A bather count taken on deck (the clicker). Kept apart from water chemistry.
model HeadCount {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  poolBodyId   String   @db.Uuid
  count        Int
  overCapacity Boolean  @default(false)
  recordedById String   @db.Uuid
  recordedAt   DateTime @default(now()) @db.Timestamptz(3)

  poolBody PoolBody @relation(fields: [poolBodyId], references: [id], onDelete: Restrict)

  @@index([poolBodyId, recordedAt])
  @@index([tenantId, recordedAt])
}

// ------------------------------------------------------------------ Billing
// FlexcityHeadquarters' own invoicing of organizations (Dev console only).

enum BillingPlan {
  /// Public sector: a plan level, priced per facility per month, unlimited staff.
  MUNICIPAL
  /// Private sector: core fee including 20 active users, then per active user, plus chosen modules.
  CLUB
}

/// How often an organization is invoiced (services/billing/terms.ts).
enum BillingCycle {
  MONTHLY
  /// Twelve months of fixed charges in advance.
  ANNUAL
  /// The whole term in advance on one invoice.
  TERM
}

/// Public-sector plans (services/billing/catalog.ts).
enum PlanLevel {
  SMALL
  BUSINESS
  MULTI_COMPLEX
  ENTERPRISE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model BillingAccount {
  tenantId            String      @id @db.Uuid
  plan                BillingPlan @default(MUNICIPAL)
  legalName           String
  contactName         String?
  email               String
  addressLine1        String?
  addressLine2        String?
  city                String?
  /// Two-letter province or territory: decides the sales tax.
  province            String
  postalCode          String?
  poNumber            String?
  paymentTermsDays    Int         @default(30)
  taxExempt           Boolean     @default(false)
  taxExemptNote       String?
  /// Public sector: which plan.
  level               PlanLevel   @default(BUSINESS)
  /// Public sector: the quoted rate per standard facility per month, in cents (Multi-complex and
  /// Enterprise; replaces the list price). Facility sizes still scale it.
  quotedRateCents     Int?
  /// Public sector, Multi-complex: the quoted staff allowance (active people), replacing the per-facility one.
  includedStaff       Int?
  /// How often fixed charges are invoiced.
  billingCycle        BillingCycle @default(MONTHLY)
  /// Committed term in months (12, 36, 60...); null = month to month. Prices are held for the term.
  termMonths          Int?
  /// First day of the term, and of yearly invoices.
  termStart           DateTime?   @db.Date
  /// Commitment discount on fixed charges, in percent; null = the standard for the term.
  discountPercent     Decimal?    @db.Decimal(5, 2)
  /// Extra staff places added to the plan, billed every month at the plan's per-person rate (private: the per-user rate).
  extraStaffSeats     Int         @default(0)
  /// Options switched away from the plan's standard, and custom prices: { "<option>": { "on": bool, "cents": int } }
  /// (services/billing/catalog.ts). Private sector: every option is off unless switched on here.
  items               Json        @default("{}")
  /// Until then, every feature is on (a trial or pilot).
  trialEndsAt         DateTime?   @db.Timestamptz(3)
  /// Days after an invoice's due date before the app turns read-only.
  graceDays           Int         @default(30)
  /// The Dev console can hold off suspension (e.g. a cheque is in the mail).
  suspensionHoldUntil DateTime?   @db.Timestamptz(3)
  /// How they usually pay: INVOICE (EFT or cheque), CARD or PAD (pre-authorized debit).
  preferredPayment    String      @default("INVOICE")
  /// Private sector: price per active user beyond the 20 included, in cents.
  clubUserRateCents   Int         @default(500)
  notes               String?
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)
}

model Invoice {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  /// Assigned when sent, in sequence (FH-2026-0001); drafts have none.
  number        String?          @unique
  status        InvoiceStatus    @default(DRAFT)
  periodStart   DateTime         @db.Date
  periodEnd     DateTime         @db.Date
  issueDate     DateTime?        @db.Date
  dueDate       DateTime?        @db.Date
  currency      String           @default("CAD")
  subtotalCents Int              @default(0)
  /// [{ name: "GST", rate: "5", amountCents: 12500 }]
  taxLines      Json             @default("[]")
  totalCents    Int              @default(0)
  paidCents     Int              @default(0)
  /// The billing details as they were when sent.
  billTo        Json
  poNumber      String?
  notes         String?
  sentAt        DateTime?        @db.Timestamptz(3)
  paidAt        DateTime?        @db.Timestamptz(3)
  voidedAt      DateTime?        @db.Timestamptz(3)
  voidReason    String?
  /// Last online checkout started for this invoice (Stripe Checkout Session id).
  checkoutId    String?
  createdById   String           @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  lines         InvoiceLine[]
  payments      InvoicePayment[]

  @@index([tenantId, periodStart])
  @@index([status])
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  /// facility | club_base | club_users | addon_hr | addon_ops | credit | other: decides the revenue account.
  kind        String  @default("other")
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitCents   Int
  amountCents Int
}

model InvoicePayment {
  id           String   @id @default(uuid()) @db.Uuid
  invoiceId    String   @db.Uuid
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents  Int
  receivedOn   DateTime @db.Date
  /// EFT | CHEQUE | CARD | PAD | OTHER
  method       String
  reference    String?
  recordedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

model InvoiceCounter {
  year Int @id
  last Int @default(0)
}

/// Enquiries from the marketing website (sales, demo requests, support). Seen in the Dev console.
model Lead {
  id               String   @id @default(uuid()) @db.Uuid
  /// SALES | DEMO | SUPPORT
  kind             String
  name             String
  email            String
  organization     String?
  role             String?
  province         String?
  facilities       Int?
  message          String
  locale           String   @default("en-CA")
  /// CASL: express consent to marketing email, recorded separately from the enquiry itself.
  marketingConsent Boolean  @default(false)
  consentText      String?
  /// NEW | CONTACTED | WON | CLOSED
  status           String   @default("NEW")
  notes            String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

/// Cross-city benchmark: quartiles of one measure across opted-in cities on a
/// date. No city ids or values are stored, and only when at least five cities
/// contribute. Platform-owned (no tenant).
model BenchmarkSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  metric     String
  computedOn DateTime @db.Date
  cities     Int
  p25        Float
  p50        Float
  p75        Float

  @@unique([metric, computedOn])
}

/// Sign-in and reset attempts, shared by every API server so rate limits hold
/// across instances and restarts. Platform-level (no tenant); rows older than
/// a day are pruned.
model RateLimitHit {
  id  BigInt   @id @default(autoincrement())
  key String
  at  DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, at])
}

enum LoneWorkStatus {
  ACTIVE
  /// Missed a check-in: the worker and their monitors were told.
  OVERDUE
  /// Still no answer after the grace period: supervisors and HR were told.
  ESCALATED
  /// The worker pressed "I need help".
  HELP
  ENDED
}

/// Someone working alone (a pump station, an arena at night, a park patrol)
/// checks in on a timer. A missed check-in alerts their monitors, then escalates.
model LoneWorkSession {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  userId          String         @db.Uuid
  facilityId      String?        @db.Uuid
  location        String
  task            String?
  intervalMinutes Int
  status          LoneWorkStatus @default(ACTIVE)
  startedAt       DateTime       @default(now()) @db.Timestamptz(3)
  lastCheckInAt   DateTime       @default(now()) @db.Timestamptz(3)
  nextDueAt       DateTime       @db.Timestamptz(3)
  overdueAt       DateTime?      @db.Timestamptz(3)
  escalatedAt     DateTime?      @db.Timestamptz(3)
  helpAt          DateTime?      @db.Timestamptz(3)
  helpNote        String?
  /// The person chose to keep their location up to date during this session (while the app is open).
  shareLocation   Boolean        @default(false)
  locationAt      DateTime?      @db.Timestamptz(3)
  /// The "check-in due soon" reminder for the current interval was sent.
  remindedAt      DateTime?      @db.Timestamptz(3)
  /// Last position the worker's device shared, if any.
  latitude        Decimal?       @db.Decimal(9, 6)
  longitude       Decimal?       @db.Decimal(9, 6)
  respondingId    String?        @db.Uuid
  respondingAt    DateTime?      @db.Timestamptz(3)
  endedAt         DateTime?      @db.Timestamptz(3)

  @@index([tenantId, status, nextDueAt])
  @@index([userId, startedAt])
}

// ------------------------------------------------------------ Winter operations

enum CallOutStatus {
  OPEN
  FILLED
  CANCELLED
}

enum CallOutContactStatus {
  /// Waiting for their turn.
  WAITING
  /// Offered now; answer within the response time.
  OFFERED
  ACCEPTED
  DECLINED
  NO_ANSWER
  /// Not eligible (rest, hours, certificates, time off…); the reason is kept.
  SKIPPED
  /// The call-out was filled or cancelled before their turn.
  NOT_NEEDED
}

/// A storm call-out: extra crew offered in overtime order, one at a time.
model CallOut {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  facilityId      String           @db.Uuid
  positionId      String           @db.Uuid
  /// The open shift created for it; assigned to whoever accepts.
  shiftId         String           @db.Uuid
  reason          String
  startsAt        DateTime         @db.Timestamptz(3)
  endsAt          DateTime         @db.Timestamptz(3)
  responseMinutes Int
  status          CallOutStatus    @default(OPEN)
  filledUserId    String?          @db.Uuid
  createdById     String           @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  closedAt        DateTime?        @db.Timestamptz(3)
  contacts        CallOutContact[]

  @@index([tenantId, status, createdAt])
}

model CallOutContact {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @db.Uuid
  callOutId    String               @db.Uuid
  callOut      CallOut              @relation(fields: [callOutId], references: [id], onDelete: Cascade)
  userId       String               @db.Uuid
  rank         Int
  status       CallOutContactStatus @default(WAITING)
  skipReason   String?
  offeredAt    DateTime?            @db.Timestamptz(3)
  respondedAt  DateTime?            @db.Timestamptz(3)
  /// Who recorded the answer when it came by phone (null = the person answered in the app).
  recordedById String?              @db.Uuid

  @@index([callOutId, rank])
  @@index([tenantId, status, offeredAt])
}

/// A road or area patrolled in winter, and how often it must be checked.
model PatrolRoute {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  name          String
  /// e.g. a road class under the city's maintenance standard (Ontario O. Reg. 239/02: 1–5).
  roadClass     String?
  /// Hours between patrols during the winter season.
  intervalHours Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, name])
}

/// One patrol: what the roads were like and what was done, as evidence.
model PatrolRecord {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  routeId        String    @db.Uuid
  userId         String    @db.Uuid
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  endedAt        DateTime? @db.Timestamptz(3)
  /// CLEAR, WET, SLUSH, SNOW_PACKED, LOOSE_SNOW, ICE, BLACK_ICE, DRIFTING, FREEZING_RAIN
  conditions     String[]
  /// INSPECTED, PLOWED, SALTED, SANDED, BRINE, HAZARD_REPORTED
  actions        String[]
  snowCm         Decimal?  @db.Decimal(5, 1)
  airTempC       Decimal?  @db.Decimal(4, 1)
  roadTempC      Decimal?  @db.Decimal(4, 1)
  materialTonnes Decimal?  @db.Decimal(7, 2)
  vehicle        String?
  notes          String?
  startLat       Decimal?  @db.Decimal(9, 6)
  startLng       Decimal?  @db.Decimal(9, 6)
  endLat         Decimal?  @db.Decimal(9, 6)
  endLng         Decimal?  @db.Decimal(9, 6)

  @@index([tenantId, routeId, startedAt])
  @@index([userId, startedAt])
}

// ------------------------------------------------- Programs and member services

enum EnrollmentStatus {
  ENROLLED
  WAITLISTED
  CANCELLED
}

/// A swim level (Red Cross, Lifesaving Society, or the city's own), with its ages.
model SwimLevel {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @db.Uuid
  program         String
  name            String
  nameFr          String?
  minAgeMonths    Int
  maxAgeMonths    Int?
  parentInWater   Boolean @default(false)
  /// Swimmers per instructor.
  ratio           Int     @default(6)
  durationMinutes Int     @default(30)
  sortOrder       Int     @default(0)
  active          Boolean @default(true)

  @@unique([tenantId, program, name])
}

enum CampaignKind {
  LESSONS
  SWIM_CLUB
  CAMP
  OTHER
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// A registration campaign: a season of lessons, a swim club session, a camp.
model LessonCampaign {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @db.Uuid
  name                 String
  nameFr               String?
  kind                 CampaignKind   @default(LESSONS)
  status               CampaignStatus @default(DRAFT)
  startsOn             DateTime       @db.Date
  endsOn               DateTime       @db.Date
  registrationOpensAt  DateTime?      @db.Timestamptz(3)
  registrationClosesAt DateTime?      @db.Timestamptz(3)
  /// No lessons these days (stat holidays, pool closures).
  skipDates            DateTime[]     @db.Date
  notes                String?
  createdById          String         @db.Uuid
  publishedAt          DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)

  @@index([tenantId, status])
}

/// A family on file: parents or guardians and their children.
model Household {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  name           String
  address        String?
  emergencyName  String?
  emergencyPhone String?
  notes          String?
  /// STAFF or ONLINE; online families may duplicate one already on file.
  source         String   @default("STAFF")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  members        Member[]

  @@index([tenantId, name])
}

enum MemberRole {
  GUARDIAN
  CHILD
  ADULT
}

model Member {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  householdId  String     @db.Uuid
  household    Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role         MemberRole
  firstName    String
  lastName     String
  dateOfBirth  DateTime?  @db.Date
  email        String?
  phone        String?
  /// Short note the instructor sees on deck (e.g. "Asthma: inhaler in bag").
  safetyNote   String?
  /// Consent to share photos, recorded at registration.
  photoConsent Boolean    @default(false)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([tenantId, lastName])
  @@index([householdId])
}

enum FeeKind {
  MEMBERSHIP
  DROP_IN
  PASS
  PROGRAM
}

enum FeePeriod {
  YEAR
  MONTH
  VISIT
  NONE
}

/// The facility price list: memberships by year or month, drop-in, passes, programs.
model FeeItem {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  /// null = every facility.
  facilityId String?   @db.Uuid
  kind       FeeKind
  period     FeePeriod @default(NONE)
  /// ADULT, YOUTH, CHILD, SENIOR, FAMILY, STUDENT, ALL
  ageGroup   String    @default("ALL")
  name       String
  nameFr     String?
  priceCents Int
  /// Visits on a pass (e.g. 10).
  visits     Int?
  active     Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, kind])
}

/// Something member services sold: a membership, a drop-in, a pass, a lesson registration.
model Sale {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  householdId   String?   @db.Uuid
  memberId      String?   @db.Uuid
  feeId         String?   @db.Uuid
  enrollmentId  String?   @db.Uuid
  facilityId    String?   @db.Uuid
  description   String
  priceCents    Int
  validFrom     DateTime? @db.Date
  validTo       DateTime? @db.Date
  /// CASH, DEBIT, CREDIT, ON_ACCOUNT, COMPLIMENTARY
  paymentMethod String
  soldById      String    @db.Uuid
  refundedAt    DateTime? @db.Timestamptz(3)
  refundedById  String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([householdId])
}

/// Something the public can book at a facility: a party room, a lane, ice time.
model BookableService {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  facilityId      String   @db.Uuid
  name            String
  nameFr          String?
  description     String?
  descriptionFr   String?
  durationMinutes Int
  priceCents      Int
  /// Bookings that can run at the same time (e.g. 2 party rooms).
  capacity        Int      @default(1)
  maxPartySize    Int?
  daysOfWeek      Int[]
  openMinute      Int
  closeMinute     Int
  /// Booked at least this many days ahead.
  leadDays        Int      @default(2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, active])
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
}

model BookingRequest {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  serviceId    String        @db.Uuid
  startsAt     DateTime      @db.Timestamptz(3)
  endsAt       DateTime      @db.Timestamptz(3)
  partySize    Int?
  name         String
  email        String
  phone        String
  organization String?
  notes        String?
  status       BookingStatus @default(REQUESTED)
  reference    String        @unique
  decidedById  String?       @db.Uuid
  decidedAt    DateTime?     @db.Timestamptz(3)
  decisionNote String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([tenantId, serviceId, startsAt])
  @@index([tenantId, status])
}

/// A certificate that must be on duty at a facility at set times, e.g. a
/// refrigeration plant operator while an arena's ice plant runs, or a water
/// treatment operator (ORO) at a plant. The schedule is checked against it.
model CoverageRule {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  facilityId      String    @db.Uuid
  name            String
  certificationId String    @db.Uuid
  minCount        Int       @default(1)
  daysOfWeek      Int[]
  startMinute     Int
  /// Up to 2880: a window can run past midnight (e.g. 22:00 to 06:00).
  endMinute       Int
  note            String?
  active          Boolean   @default(true)
  lastAlertedAt   DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, facilityId])
}

// ------------------------------------------------------------------ Fleet

/// A city vehicle: a plow, a pickup, a sewer flusher, an ice resurfacer.
model Vehicle {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  facilityId         String?   @db.Uuid
  unit               String
  description        String
  plate              String?
  /// The licence needed to drive it (a certification, e.g. Class 3 with air brakes).
  certificationId    String?   @db.Uuid
  outOfServiceAt     DateTime? @db.Timestamptz(3)
  outOfServiceReason String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, unit])
}

enum InspectionResult {
  PASS
  MINOR
  MAJOR
}

/// A driver's pre-trip (or post-trip) inspection, item by item.
model VehicleInspection {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  vehicleId    String           @db.Uuid
  userId       String           @db.Uuid
  at           DateTime         @default(now()) @db.Timestamptz(3)
  odometerKm   Int?
  /// [{ item: "BRAKES", ok: false, severity: "MAJOR", note: "Soft pedal" }]
  items        Json
  result       InspectionResult
  notes        String?
  /// When a major defect was fixed and the vehicle returned to service.
  repairedAt   DateTime?        @db.Timestamptz(3)
  repairedById String?          @db.Uuid
  repairNote   String?

  @@index([tenantId, vehicleId, at])
}

enum InjuryClaimStatus {
  /// Needs reporting to the board.
  OPEN
  FILED
  /// First aid only, no lost time: kept on file, no report required.
  NOT_REQUIRED
}

/// A worker's injury and the employer's report to the province's
/// compensation board (WSIB, WorkSafeBC, WCB…), with its deadline.
model InjuryClaim {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  userId          String            @db.Uuid
  facilityId      String            @db.Uuid
  incidentId      String?           @db.Uuid
  occurredAt      DateTime          @db.Timestamptz(3)
  /// When a supervisor or HR learned of it: the deadline counts from here.
  learnedAt       DateTime          @db.Timestamptz(3)
  province        Province
  board           String
  dueAt           DateTime          @db.Timestamptz(3)
  lostTime        Boolean           @default(false)
  healthCare      Boolean           @default(false)
  /// Short and factual (e.g. "Sprained right ankle on pool deck stairs"); details stay in the incident report.
  description     String
  status          InjuryClaimStatus @default(OPEN)
  claimNumber     String?
  filedAt         DateTime?         @db.Timestamptz(3)
  filedById       String?           @db.Uuid
  accommodationId String?           @db.Uuid
  createdById     String            @db.Uuid
  reminderSentAt  DateTime?         @db.Timestamptz(3)
  overdueSentAt   DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  @@index([tenantId, status, dueAt])
}

// ------------------------------------------------------------------ Payroll

enum PayRunStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

enum BankAccountStatus {
  /// Entered, waiting for someone other than the person who entered it to verify.
  PENDING
  ACTIVE
  RETIRED
  REJECTED
}

/// Tax set-up for one employee (from their TD1 forms). SIN is sealed with the city's key.
model PayProfile {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  userId            String    @unique @db.Uuid
  /// Province or territory of employment for tax; null = the province of the facility they work at.
  province          Province?
  /// TD1 total claim amounts; null = the basic personal amount.
  federalClaim      Decimal?  @db.Decimal(12, 2)
  provincialClaim   Decimal?  @db.Decimal(12, 2)
  extraTaxPerPeriod Decimal   @default(0) @db.Decimal(10, 2)
  /// Home mailing address for tax slips (T4, RL-1) and the ROE: { line1, line2, city, province, postalCode }.
  mailingAddress    Json?
  cppExempt         Boolean   @default(false)
  eiExempt          Boolean   @default(false)
  sinCiphertext     Bytes?
  sinIv             Bytes?
  sinAuthTag        Bytes?
  sinWrappedKey     Bytes?
  sinKekId          String?
  sinLast3          String?
  td1SignedAt       DateTime? @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

/// Where someone's pay is deposited. The account number is sealed; only the last four digits are kept in clear.
model BankAccount {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  userId            String            @db.Uuid
  holderName        String
  /// Financial institution number (3 digits) and branch transit (5 digits).
  institution       String
  transit           String
  accountCiphertext Bytes
  accountIv         Bytes
  accountAuthTag    Bytes
  accountWrappedKey Bytes
  accountKekId      String
  last4             String
  status            BankAccountStatus @default(PENDING)
  /// The direct-deposit authorization the person agreed to, word for word.
  consentText       String
  consentAt         DateTime          @db.Timestamptz(3)
  enteredById       String            @db.Uuid
  verifiedById      String?           @db.Uuid
  verifiedAt        DateTime?         @db.Timestamptz(3)
  retiredAt         DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

/// One pay run: a pay period for the whole city or one department.
model PayRun {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  departmentId       String?           @db.Uuid
  periodStart        DateTime          @db.Date
  periodEnd          DateTime          @db.Date
  payDate            DateTime          @db.Date
  periodsPerYear     Int
  status             PayRunStatus      @default(DRAFT)
  preparedById       String            @db.Uuid
  approvedById       String?           @db.Uuid
  approvedAt         DateTime?         @db.Timestamptz(3)
  paidAt             DateTime?         @db.Timestamptz(3)
  voidedAt           DateTime?         @db.Timestamptz(3)
  /// { gross, deductions, net, employerCpp, employerEi, people, deposits, cheques }
  totals             Json              @default("{}")
  /// Problems that must be fixed before approval.
  blockers           Json              @default("[]")
  warnings           Json              @default("[]")
  fileCreationNumber Int?
  depositFileSha256  String?
  /// REGULAR (hours and salaries for the period) or OFF_CYCLE (one-time payments only: a bonus run, final pay, a correction).
  kind               String            @default("REGULAR")
  /// Why an off-cycle run was made.
  note               String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  statements         PayStatement[]
  transmissions      PayTransmission[]

  @@index([tenantId, periodStart])
}

/// What one person is paid in one run: earnings, deductions, net and year-to-date.
model PayStatement {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  payRunId        String   @db.Uuid
  userId          String   @db.Uuid
  departmentId    String?  @db.Uuid
  province        Province
  year            Int
  payDate         DateTime @db.Date
  hours           Decimal  @db.Decimal(10, 2)
  /// [{ code, positionId, hours, rate, amount }]
  earnings        Json
  /// { cpp, cpp2, ei, federalTax, provincialTax, extraTax }
  deductions      Json
  gross           Decimal  @db.Decimal(12, 2)
  totalDeductions Decimal  @db.Decimal(12, 2)
  net             Decimal  @db.Decimal(12, 2)
  employerCpp     Decimal  @db.Decimal(12, 2)
  employerEi      Decimal  @db.Decimal(12, 2)
  /// Year-to-date after this statement: { gross, cpp, cpp2, ei, federalTax, provincialTax, net, insurable, pensionable }
  ytd             Json
  bankAccountId   String?  @db.Uuid
  depositLast4    String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  payRun          PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, year])
  @@index([payRunId])
}

/// CRA and provincial payroll rates for one year and jurisdiction ("CA" = federal, CPP and EI).
/// Shared by every city; FH staff check each table against CRA's T4127 before it's used.
model PayrollTaxTable {
  id           String    @id @default(uuid()) @db.Uuid
  year         Int
  jurisdiction String
  data         Json
  verifiedAt   DateTime? @db.Timestamptz(3)
  verifiedBy   String?
  note         String?
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([year, jurisdiction])
}

enum TransmissionStatus {
  SENT
  FAILED
}

/// Every attempt to send a pay run's deposit file to the city's bank.
model PayTransmission {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  payRunId  String             @db.Uuid
  sentById  String?            @db.Uuid
  method    String
  fileName  String
  sha256    String
  encrypted Boolean
  status    TransmissionStatus
  error     String?
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  payRun    PayRun             @relation(fields: [payRunId], references: [id], onDelete: Cascade)

  @@index([payRunId])
}

// ------------------------------------------------------------------ Benefits

enum BenefitKind {
  /// Registered pension plan (OMERS, MEPP, LAPP…): employee contributions come off taxable income.
  PENSION
  HEALTH
  DENTAL
  LIFE
  DISABILITY
  /// Union dues: deducted from pay and from taxable income.
  UNION_DUES
  EAP
  OTHER
}

/// A benefit plan or payroll deduction the city offers, with the employee and employer shares per pay.
model BenefitPlan {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid
  name            String
  nameFr          String?
  kind            BenefitKind
  provider        String?
  /// Employee share each pay: a percent of gross pay plus a fixed amount.
  employeePercent Decimal             @default(0) @db.Decimal(6, 3)
  employeeAmount  Decimal             @default(0) @db.Decimal(10, 2)
  /// Employer share each pay, the same way.
  employerPercent Decimal             @default(0) @db.Decimal(6, 3)
  employerAmount  Decimal             @default(0) @db.Decimal(10, 2)
  /// The employer's share is a taxable benefit to the employee (e.g. employer-paid group life insurance).
  employerTaxable Boolean             @default(false)
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  enrollments     BenefitEnrollment[]

  @@unique([tenantId, name])
}

model BenefitEnrollment {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  planId         String      @db.Uuid
  userId         String      @db.Uuid
  startsOn       DateTime    @db.Date
  endsOn         DateTime?   @db.Date
  /// e.g. "Single", "Family".
  coverage       String?
  /// Overrides the plan's employee share per pay (e.g. family coverage).
  employeeAmount Decimal?    @db.Decimal(10, 2)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  plan           BenefitPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([planId])
}

// ------------------------------------------------------------------ HR departments

/// Leave for one person, type and year (hours). Balance = hours + carry-over − approved leave that year.
model LeaveEntitlement {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  userId    String      @db.Uuid
  year      Int
  type      TimeOffType
  hours     Decimal     @db.Decimal(8, 2)
  carryover Decimal     @default(0) @db.Decimal(8, 2)
  note      String?
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, year, type])
}

enum ReviewStatus {
  /// Waiting for the employee's self-assessment.
  SELF
  /// Waiting for the reviewer.
  MANAGER
  /// Reviewer done; waiting for the employee to read and acknowledge.
  DISCUSS
  ACKNOWLEDGED
}

/// A performance review: goals, self-assessment, the reviewer's assessment and rating, and the employee's acknowledgement.
model PerformanceReview {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  userId           String       @db.Uuid
  reviewerId       String       @db.Uuid
  cycle            String
  dueOn            DateTime     @db.Date
  status           ReviewStatus @default(SELF)
  /// [{ text, met: boolean | null }]
  goals            Json         @default("[]")
  selfComments     String?
  managerComments  String?
  /// 1 (needs improvement) to 5 (outstanding).
  rating           Int?
  employeeComments String?
  acknowledgedAt   DateTime?    @db.Timestamptz(3)
  createdById      String       @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([reviewerId])
}

/// An internal course: in-service, WHMIS, orientation, defensive driving… Mandatory ones can apply to some positions and need renewing.
model TrainingCourse {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  name        String
  nameFr      String?
  hours       Decimal          @default(0) @db.Decimal(6, 2)
  mandatory   Boolean          @default(false)
  /// Months until it must be retaken; null = once.
  renewMonths Int?
  /// Positions it's mandatory for; empty = everyone.
  positionIds String[]         @default([]) @db.Uuid
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  records     TrainingRecord[]

  @@unique([tenantId, name])
}

model TrainingRecord {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  courseId     String         @db.Uuid
  userId       String         @db.Uuid
  completedOn  DateTime       @db.Date
  hours        Decimal?       @db.Decimal(6, 2)
  trainer      String?
  recordedById String         @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([courseId])
}

enum GrievanceStatus {
  FILED
  STEP_1
  STEP_2
  STEP_3
  ARBITRATION
  RESOLVED
  WITHDRAWN
}

/// A grievance under the collective agreement, tracked step by step against its deadlines.
model Grievance {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  number      Int
  /// The grievor; null for a policy or group grievance.
  userId      String?         @db.Uuid
  kind        String          @default("INDIVIDUAL")
  title       String
  articles    String?
  filedOn     DateTime        @db.Date
  status      GrievanceStatus @default(FILED)
  /// When the employer's reply (or the next step) is due.
  dueOn       DateTime?       @db.Date
  outcome     String?
  /// [{ at, by, status, note }]
  history     Json            @default("[]")
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, number])
}

/// Someone leaving: the checklist from last day to final pay, Record of Employment and access removed.
model Offboarding {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @unique @db.Uuid
  lastDay     DateTime  @db.Date
  reason      String
  /// [{ key, done, doneAt, doneById }]
  checklist   Json
  completedAt DateTime? @db.Timestamptz(3)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
}

enum PadStatus {
  ACTIVE
  CANCELLED
}

/// A city's authorization for FH to debit its bank account for plan charges (business PAD, Payments Canada Rule H1).
model PadAgreement {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  status           PadStatus  @default(ACTIVE)
  /// The account holder: the city or organization.
  payorName        String
  signerName       String
  signerTitle      String
  institution      String
  transit          String
  accountLast4     String
  /// The full account number, sealed with the organization's key.
  accountSealed    Json
  agreementVersion String
  /// Business PAD payors may waive the 10-day pre-notification; invoices still go out before any debit.
  waivedPreNotice  Boolean    @default(false)
  /// DEV_CONSOLE (signed form on file) or ORGANIZATION (authorized in the app).
  channel          String
  authorizedBy     String
  authorizedAt     DateTime   @default(now()) @db.Timestamptz(3)
  cancelledAt      DateTime?  @db.Timestamptz(3)
  cancelReason     String?
  debits           PadDebit[]

  @@index([tenantId, status])
}

enum PadBatchStatus {
  CREATED
  SENT
  SETTLED
}

/// One debit file to FH's bank.
model PadBatch {
  id          String         @id @default(uuid()) @db.Uuid
  /// CPA-005 file creation number, 1–9999, one higher every file.
  fileNumber  Int
  debitDate   DateTime       @db.Date
  status      PadBatchStatus @default(CREATED)
  totalCents  Int
  count       Int
  createdById String         @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  sentAt      DateTime?      @db.Timestamptz(3)
  settledAt   DateTime?      @db.Timestamptz(3)
  debits      PadDebit[]
}

enum PadDebitStatus {
  PENDING
  SETTLED
  RETURNED
}

model PadDebit {
  id           String         @id @default(uuid()) @db.Uuid
  batchId      String         @db.Uuid
  batch        PadBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  agreementId  String         @db.Uuid
  agreement    PadAgreement   @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  invoiceId    String         @db.Uuid
  tenantId     String         @db.Uuid
  amountCents  Int
  status       PadDebitStatus @default(PENDING)
  returnReason String?
  returnedOn   DateTime?      @db.Date

  @@index([invoiceId])
}

/// FH's own books: chart of accounts, PAD originator details, fiscal settings. One row.
model FhBooks {
  id              Int       @id @default(1)
  /// { ar: "1200", bank: "1000", ... } overrides of the default chart.
  accounts        Json      @default("{}")
  /// { originatorId, dataCentre, shortName, longName, transactionCode, returns: { institution, transit, last4, sealed } }
  padOriginator   Json?
  lastFileNumber  Int       @default(0)
  /// First month of FH's fiscal year (1–12).
  fiscalYearStart Int       @default(1)
  /// Entries on or before this date can't change (books closed).
  closedThrough   DateTime? @db.Date
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}

/// Adjustments FH's accountant posts by hand (bank fees, interest, accruals). Each balances.
model FhJournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  memo        String
  /// [{ account: "6100", debitCents: 1500, creditCents: 0 }]
  lines       Json
  reference   String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

enum DocumentKind {
  MEDICAL_NOTE
  CERTIFICATE
  IDENTIFICATION
  CONTRACT
  POLICY
  OTHER
  /// A receipt attached to an expense claim.
  RECEIPT
}

enum DocumentVisibility {
  /// HR only (and the employee): medical notes always.
  HR
  /// HR, the employee and the supervisors of their department.
  DEPARTMENT
}

/// A file kept on an employee's record (a doctor's note, a certificate, a contract). Encrypted with the organization's key.
model EmployeeDocument {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  userId        String             @db.Uuid
  uploadedById  String             @db.Uuid
  kind          DocumentKind
  visibility    DocumentVisibility @default(HR)
  title         String
  fileName      String
  contentType   String
  size          Int
  /// SHA-256 of the original file, to show it hasn't changed.
  sha256        String
  ciphertext    Bytes
  iv            Bytes
  authTag       Bytes
  wrappedKey    Bytes
  kekId         String
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  deletedAt     DateTime?          @db.Timestamptz(3)
  deletedById   String?            @db.Uuid
  deletedReason String?

  @@index([tenantId, userId])
}

enum SupportLevel {
  /// Set-up screens: settings, facilities, positions, roles, menus, billing. No personal records.
  SETUP
  /// Everything HR sees, read-only.
  FULL
}

/// The organization's consent for FH support to look in, read-only, until it expires.
model SupportGrant {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  grantedById String       @db.Uuid
  level       SupportLevel @default(SETUP)
  reason      String?
  expiresAt   DateTime     @db.Timestamptz(3)
  revokedAt   DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([tenantId, expiresAt])
}

/// One FH support visit under a grant: a one-time code exchanged in the city's app for a short, read-only session.
model SupportSession {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  grantId       String    @db.Uuid
  adminId       String    @db.Uuid
  codeHash      String    @unique
  codeExpiresAt DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)
  endsAt        DateTime  @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId])
}

enum SsoProtocol {
  OIDC
  SAML
}

/// The organization's single sign-on: Microsoft Entra ID (or any OpenID Connect provider), or SAML 2.0.
/// Only signs in people who already have an account; it never creates one.
model SsoConnection {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @unique @db.Uuid
  protocol    SsoProtocol
  enabled     Boolean     @default(false)
  /// Password sign-in is off, except for people who can change this setting (so nobody is locked out).
  enforced    Boolean     @default(false)
  /// The identity provider always requires a second factor (e.g. Entra conditional access), so SSO counts as MFA.
  idpMfa      Boolean     @default(false)
  /// Button text, e.g. "Microsoft".
  label       String?
  /// Only emails at these domains may sign in this way; empty means any.
  domains     String[]    @default([])
  oidcIssuer  String?
  oidcClientId String?
  /// Sealed client secret.
  oidcSecret  Json?
  samlEntryPoint String?
  samlIdpIssuer  String?
  /// The identity provider's signing certificate (PEM or base64).
  samlCert    String?
  lastUsedAt  DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

/// A browser or installed app that receives push notifications for one person.
model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  userId     String    @db.Uuid
  /// The push service's address for this device (unguessable).
  endpoint   String    @unique
  p256dh     String
  auth       String
  /// e.g. "iPhone", "Android", "Windows": shown so people can tell their devices apart.
  device     String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSentAt DateTime? @db.Timestamptz(3)
  failures   Int       @default(0)

  @@index([tenantId, userId])
}

/// A person's signed information and consent agreement (services/privacy/consent.ts): evidence of
/// exactly what they were shown and agreed to. Never edited; a new version is a new row.
model ConsentRecord {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  userId          String   @db.Uuid
  version         String
  locale          String
  /// SHA-256 of the agreement text exactly as shown.
  textSha256      String
  /// The agreement exactly as shown ({ title, intro, sections, confirm }), so a certificate shows the version this person signed.
  agreement       Json?
  signedName      String
  /// PNG from the signature pad, and its SHA-256.
  signature       Bytes
  signatureSha256 String
  /// { notifications, location }: granted, denied, skipped or unsupported.
  choices         Json
  ipAddress       String?
  userAgent       String?
  signedAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, signedAt])
  @@index([userId, version])
}

/// Quebec workforce skills law (Loi sur les compétences, the 1% law): what an employer with a payroll
/// over the threshold spent on eligible training in a year. It reduces the WSDRF contribution owed.
model TrainingSpend {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  year        Int
  spentOn     DateTime            @db.Date
  category    TrainingSpendKind
  description String
  amountCents Int
  /// Link to the training it paid for, when there is one.
  trainingRecordId String?        @db.Uuid
  createdById String              @db.Uuid
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)

  @@index([tenantId, year])
}

enum TrainingSpendKind {
  COURSE_FEES
  TRAINER
  WAGES_IN_TRAINING
  TRAVEL
  MATERIALS
  OTHER
}

/// Each pay period sent to a payroll provider (ADP, Dayforce, Wagepoint) over its API.
model PayrollSync {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  provider     String
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date
  /// SENT or FAILED.
  status       String
  rows         Int
  /// SHA-256 of the file sent, to match it with the provider's copy.
  fileSha256   String
  httpStatus   Int?
  reference    String?
  message      String?
  sentById     String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
}

/// A salaried person's annual salary, paid evenly each pay period instead of by hours.
model Salary {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  userId        String    @db.Uuid
  /// Where the cost goes (the position's department).
  positionId    String    @db.Uuid
  annualAmount  Decimal   @db.Decimal(12, 2)
  /// Normal hours a week, for insurable hours on the ROE.
  weeklyHours   Decimal   @default(37.5) @db.Decimal(5, 2)
  /// Overtime hours are still paid on top (for overtime-eligible salaried staff).
  overtimeEligible Boolean @default(false)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, userId, effectiveFrom])
}

/// A one-time payment or deduction on one pay run: a bonus, retroactive pay, an allowance, a
/// reimbursement (not taxed), or a deduction such as recovering an overpayment.
model PayAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  payRunId    String   @db.Uuid
  userId      String   @db.Uuid
  /// BONUS, RETRO, ALLOWANCE, VACATION_PAYOUT, OTHER_EARNING (taxable); REIMBURSEMENT (not taxable); RECOVERY, OTHER_DEDUCTION (after tax).
  kind        String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  /// LIEU_PAYOUT: the banked hours paid out.
  hours       Decimal? @db.Decimal(8, 2)
  positionId  String?  @db.Uuid
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, payRunId])
}

/// A deduction a court, the Family Responsibility Office or CRA orders the employer to take each pay
/// and send on, until the total is paid.
model PayDeductionOrder {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  userId       String    @db.Uuid
  /// GARNISHMENT, SUPPORT_ORDER, CRA_REQUIREMENT, OTHER.
  kind         String
  payee        String
  reference    String?
  /// A fixed amount each pay, or a percent of net pay (one of the two).
  amountPerPay Decimal?  @db.Decimal(12, 2)
  percentOfNet Decimal?  @db.Decimal(5, 2)
  /// Never more than this share of net pay (provincial exemptions; 50% unless the order says otherwise).
  maxPercentOfNet Decimal @default(50) @db.Decimal(5, 2)
  /// Stops once this much has been taken (null = until ended).
  totalOwed    Decimal?  @db.Decimal(12, 2)
  startsOn     DateTime  @db.Date
  endsOn       DateTime? @db.Date
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, userId])
}


/// Who to call for a person in an emergency. Seen by the person, HR, and whoever responds when their working-alone session escalates.
model EmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  userId       String   @db.Uuid
  name         String
  relationship String?
  phone        String
  altPhone     String?
  /// 1 = call first.
  priority     Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([tenantId, userId])
}

enum SmsKind {
  TEXT
  CALL
}

/// Texts and voice calls waiting to go out. Bodies are rendered at sending time and the params dropped once sent.
model SmsOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String?   @db.Uuid
  toPhone   String
  kind      SmsKind   @default(TEXT)
  template  String
  params    Json      @default("{}")
  locale    String    @default("en-CA")
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, sentAt])
}

/// HR's corrections to a person's banked overtime (an opening balance, a correction). Everything else
/// in the bank comes from approved pay runs: hours banked, taken as time off, or paid out.
model LieuAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  /// Positive adds to the bank, negative takes away.
  hours       Decimal  @db.Decimal(8, 2)
  note        String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, userId])
}

enum TradeStatus {
  /// Waiting for the other person.
  PROPOSED
  /// They agreed; waiting for a supervisor.
  ACCEPTED
  APPROVED
  /// The other person said no.
  DECLINED
  /// A supervisor said no.
  DENIED
  CANCELLED
  /// A shift started or changed before it was decided.
  EXPIRED
}

/// Two people swap shifts: each takes the other's. Both must be eligible for the shift they take; a supervisor approves.
model ShiftTrade {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @db.Uuid
  fromUserId       String      @db.Uuid
  fromShiftId      String      @db.Uuid
  toUserId         String      @db.Uuid
  toShiftId        String      @db.Uuid
  status           TradeStatus @default(PROPOSED)
  note             String?
  /// Each side's eligibility and overtime when last checked.
  check            Json?
  respondedAt      DateTime?   @db.Timestamptz(3)
  decidedById      String?     @db.Uuid
  decidedAt        DateTime?   @db.Timestamptz(3)
  decisionNote     String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  @@index([tenantId, status])
  @@index([fromShiftId])
  @@index([toShiftId])
}

/// A shared tablet at a facility where staff punch in and out with their employee number and PIN.
model Kiosk {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  facilityId  String    @db.Uuid
  name        String
  /// SHA-256 of the device's secret (shown once, when the tablet is set up).
  tokenHash   String    @unique
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  @@index([tenantId, facilityId])
}

enum ClaimStatus {
  SUBMITTED
  APPROVED
  REJECTED
  /// Paid on a pay run (payRunId).
  PAID
  WITHDRAWN
}

enum ExpenseCategory {
  MILEAGE
  MEALS
  TRAVEL
  PARKING
  SUPPLIES
  TRAINING
  OTHER
}

/// Money a person spent for work, or kilometres they drove, to be paid back (not taxed) on a pay run.
model ExpenseClaim {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  userId       String      @db.Uuid
  title        String
  status       ClaimStatus @default(SUBMITTED)
  total        Decimal     @db.Decimal(12, 2)
  submittedAt  DateTime    @default(now()) @db.Timestamptz(3)
  decidedById  String?     @db.Uuid
  decidedAt    DateTime?   @db.Timestamptz(3)
  decisionNote String?
  payRunId     String?     @db.Uuid
  items        ExpenseItem[]

  @@index([tenantId, status])
  @@index([userId])
}

model ExpenseItem {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  claimId           String          @db.Uuid
  claim             ExpenseClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  date              DateTime        @db.Date
  category          ExpenseCategory
  description       String
  amount            Decimal         @db.Decimal(12, 2)
  /// Mileage: kilometres driven and the rate applied (cents per km).
  km                Decimal?        @db.Decimal(8, 1)
  centsPerKm        Decimal?        @db.Decimal(6, 2)
  /// GST/HST included in the amount, if the receipt shows it.
  salesTax          Decimal?        @db.Decimal(12, 2)
  receiptDocumentId String?         @db.Uuid

  @@index([claimId])
}

/// A policy staff read and sign (safety plan, code of conduct, respectful workplace…). A revision is a new row; the old one is retired.
model Policy {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  title        String
  body         String
  /// SHA-256 of title and body exactly as published.
  textSha256   String
  version      Int         @default(1)
  replacesId   String?     @db.Uuid
  /// Empty = everyone; otherwise people who hold one of these positions.
  positionIds  String[]    @db.Uuid
  /// Days after publishing (or after starting) to sign it.
  dueDays      Int?
  createdById  String      @db.Uuid
  publishedAt  DateTime    @default(now()) @db.Timestamptz(3)
  retiredAt    DateTime?   @db.Timestamptz(3)
  acks         PolicyAck[]

  @@index([tenantId, retiredAt])
}

/// A person's signature on a policy version. Evidence: added, never changed or deleted by the app.
model PolicyAck {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  policyId   String   @db.Uuid
  policy     Policy   @relation(fields: [policyId], references: [id])
  userId     String   @db.Uuid
  signedName String
  textSha256 String
  signedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([policyId, userId])
  @@index([tenantId, userId])
}

enum LogCategory {
  HANDOVER
  MAINTENANCE
  SAFETY
  OTHER
}

/// A facility's shift log: handover notes, maintenance, safety. Added, never changed; a correction is a new entry.
model LogEntry {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  facilityId String      @db.Uuid
  authorId   String      @db.Uuid
  category   LogCategory @default(HANDOVER)
  body       String
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@index([tenantId, facilityId, createdAt])
}

/// A notice to staff: everyone, or some positions or facilities.
model Announcement {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  title       String
  body        String
  /// Empty = everyone.
  positionIds String[]           @db.Uuid
  facilityIds String[]           @db.Uuid
  pinned      Boolean            @default(false)
  expiresAt   DateTime?          @db.Timestamptz(3)
  authorId    String             @db.Uuid
  publishedAt DateTime           @default(now()) @db.Timestamptz(3)
  reads       AnnouncementRead[]

  @@index([tenantId, publishedAt])
}

model AnnouncementRead {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  readAt         DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([announcementId, userId])
}

enum ApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  OFFERED
  HIRED
  DECLINED
  WITHDRAWN
}

/// Someone applying to a job posting from the careers page. The résumé is encrypted like employee documents.
model JobApplication {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  postingId     String            @db.Uuid
  firstName     String
  lastName      String
  email         String
  phone         String?
  message       String?
  /// Certifications they hold, as they wrote them.
  certifications String?
  status        ApplicationStatus @default(NEW)
  notes         String?
  /// When they agreed to the privacy notice for applicants.
  consentAt     DateTime          @db.Timestamptz(3)
  resumeName    String?
  resumeType    String?
  resumeSize    Int?
  resumeSha256  String?
  ciphertext    Bytes?
  iv            Bytes?
  authTag       Bytes?
  wrappedKey    Bytes?
  kekId         String?
  hiredUserId   String?           @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  @@index([tenantId, postingId, status])
}

enum PayeeKind {
  PERSON
  BUSINESS
}

/// Someone paid who isn't an employee: a contract instructor, a committee or council member's honorarium. Reported on a T4A.
model Payee {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  kind           PayeeKind      @default(PERSON)
  firstName      String?
  lastName       String?
  businessName   String?
  /// Their CRA business number (9 digits, or with RT/RP and the account), for a business.
  businessNumber String?
  /// SIN, sealed with the organization's key like employees' (people only).
  sinLast3       String?
  sinCiphertext  Bytes?
  sinIv          Bytes?
  sinAuthTag     Bytes?
  sinWrappedKey  Bytes?
  sinKekId       String?
  address        Json?
  email          String?
  notes          String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  archivedAt     DateTime?      @db.Timestamptz(3)
  payments       PayeePayment[]

  @@index([tenantId])
}

/// A payment to a payee, by T4A box: 048 fees for services, 028 other income (e.g. honoraria), 020 self-employed commissions.
model PayeePayment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  payeeId     String   @db.Uuid
  payee       Payee    @relation(fields: [payeeId], references: [id])
  paidOn      DateTime @db.Date
  box         String
  amount      Decimal  @db.Decimal(12, 2)
  /// Income tax withheld (box 022), if any.
  taxWithheld Decimal  @default(0) @db.Decimal(12, 2)
  description String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, paidOn])
}

enum ReportSchedule {
  NONE
  WEEKLY
  MONTHLY
}

/// A report someone saved, optionally emailed to them each week or month (run with their access at the time).
model SavedReport {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  ownerId    String         @db.Uuid
  name       String
  reportKey  String
  /// { days } for reports that look ahead.
  params     Json           @default("{}")
  schedule   ReportSchedule @default(NONE)
  lastSentAt DateTime?      @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([tenantId, ownerId])
}
