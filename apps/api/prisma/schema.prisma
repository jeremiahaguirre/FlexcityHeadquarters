model IncidentAccessLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  incidentId String   @db.Uuid
  userId     String   @db.Uuid
  purpose    String
  accessedAt DateTime @default(now()) @db.Timestamptz(3)

  incident IncidentReport @relation(fields: [incidentId], references: [id], onDelete: Restrict)
}

// ------------------------------------------------------------------
// HR
// ------------------------------------------------------------------

model DisciplinaryRecord {
  id                       String           @id @default(uuid()) @db.Uuid
  tenantId                 String           @db.Uuid
  userId                   String           @db.Uuid
  issuedById               String           @db.Uuid
  issuedAt                 DateTime         @db.Timestamptz(3)
  summary                  String
  /// PNG data captured from the signature canvas.
  acknowledgementSignature Bytes?
  acknowledgedAt           DateTime?        @db.Timestamptz(3)
  /// SHA-256 of exactly what was signed (content at signing) and of the signature image.
  signedSha256             String?
  signatureSha256          String?
  /// Union members may request a steward was present.
  stewardPresent           Boolean          @default(false)
  /// Step in progressive discipline (null on records made before levels existed).
  level                    DisciplineLevel?
  /// Frozen copy of the facts relied on (events, notes) as they were when issued.
  evidence                 Json             @default("[]")
  /// Fair-process confirmations made by the issuer, with the time they were made.
  fairProcess              Json?
  /// The employee's own written response, kept with the record.
  employeeResponse         String?
  respondedAt              DateTime?        @db.Timestamptz(3)

  user User @relation("DisciplineSubject", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model AuditLog {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  actorId  String?  @db.Uuid
  /// The organization API key that made the change (public API writes); actorId is then null.
  apiKeyId String?  @db.Uuid
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, at])
}

// ------------------------------------------------------------------
// NOTIFICATIONS
// ------------------------------------------------------------------

/// Stored as a type + params (not text) so each person reads it in their own language.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  type      String // e.g. "shift_available", "claim_needs_approval"
  params    Json      @default("{}")
  /// In-app path to open, e.g. "/board"
  link      String?
  readAt    DateTime? @db.Timestamptz(3)
  /// Sent to the person's devices (web push), or skipped because they have none.
  pushedAt  DateTime? @db.Timestamptz(3)
  /// Set when written by the event outbox: "<event id>:<recipient hash>", so a redelivered event never notifies twice.
  dedupeKey String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, dedupeKey])
  @@index([userId, createdAt])
  @@index([tenantId])
}

enum EventStatus {
  PENDING
  DELIVERED
  /// Gave up after the last attempt; kept for an operator to look at (lib/outbox.ts).
  DEAD
}

/// Transactional outbox for domain events (lib/outbox.ts). Written in the same transaction as the
/// change it describes; the dispatcher (API process right after commit, and the worker every few
/// seconds) delivers each one at least once. The payload is cleared once delivered.
model EventOutbox {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  type        String
  payload     Json        @default("{}")
  status      EventStatus @default(PENDING)
  attempts    Int         @default(0)
  /// Not before: retries back off by pushing this forward.
  availableAt DateTime    @default(now()) @db.Timestamptz(3)
  lastError   String?
  deliveredAt DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([tenantId, status, availableAt])
}

/// Emails are queued here inside the business transaction and sent by the worker,
/// so a mail outage never loses or duplicates a business change.
model EmailOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  toEmail   String
  template  String
  params    Json      @default("{}")
  locale    String    @default("en-CA")
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([sentAt, createdAt])
}

// ------------------------------------------------------------------
// LESSONS
// ------------------------------------------------------------------

/// A weekly class (e.g. "Swimmer 3, Tuesdays 4:30 p.m.") between two dates.
model LessonClass {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  facilityId       String   @db.Uuid
  positionId       String   @db.Uuid // the instructor position whose shift covers it
  name             String
  level            String?
  dayOfWeek        Int // 0 = Sunday, facility local time
  startMinute      Int
  endMinute        Int
  startsOn         DateTime @db.Date
  endsOn           DateTime @db.Date
  maxSwimmers      Int      @default(8)
  /// Several days a week (e.g. Monday to Friday); empty = just `dayOfWeek`.
  daysOfWeek       Int[]    @default([])
  /// Part of a registration campaign (lessons, swim club…), with its level and price.
  campaignId       String?  @db.Uuid
  levelId          String?  @db.Uuid
  minAgeMonths     Int?
  maxAgeMonths     Int?
  priceCents       Int?
  memberPriceCents Int?
  /// Instructors and member services see it once its campaign is published.
  published        Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  enrollments LessonEnrollment[]
  attendance  LessonAttendance[]

  @@index([tenantId, facilityId, dayOfWeek])
}

/// Swimmers are often children: keep only what the instructor needs on deck.
model LessonEnrollment {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  classId        String           @db.Uuid
  swimmerName    String
  /// Short safety note visible to the instructor (e.g. "Asthma: inhaler in bag").
  safetyNote     String?
  active         Boolean          @default(true)
  /// Registered by member services for a child (or adult) on file.
  memberId       String?          @db.Uuid
  householdId    String?          @db.Uuid
  status         EnrollmentStatus @default(ENROLLED)
  priceCents     Int?
  registeredById String?          @db.Uuid
  /// Age check skipped by staff, and why.
  ageOverride    String?
  /// STAFF (member services) or ONLINE (the public sign-up page).
  source         String           @default("STAFF")
  /// Reference given to the family, e.g. R-7F3K2Q.
  reference      String?          @unique
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  lessonClass LessonClass        @relation(fields: [classId], references: [id], onDelete: Restrict)
  attendance  LessonAttendance[]

  @@index([classId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

model LessonAttendance {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  classId      String           @db.Uuid
  enrollmentId String           @db.Uuid
  sessionDate  DateTime         @db.Date
  status       AttendanceStatus
  recordedById String           @db.Uuid
  /// When the instructor tapped it on the deck (may be before upload when offline).
  recordedAt   DateTime         @db.Timestamptz(3)
  /// Client-generated id, so a retried offline upload never double-counts.
  clientId     String           @unique
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  lessonClass LessonClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  enrollment  LessonEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, sessionDate])
}

