# Migrations / admin (table owner)
DATABASE_URL=postgresql://postgres@localhost:5432/flexcity
# Runtime app role — NOT the owner, so row-level security applies
# Production: every database URL must end in ?sslmode=verify-full (the API refuses to start otherwise).
APP_DATABASE_URL=postgresql://flexcity_app:change-me@localhost:5432/flexcity
# Union Hub role — the only role with access to the union_hub schema
UNION_DATABASE_URL=postgresql://flexcity_union:change-me@localhost:5432/flexcity
JWT_SECRET=replace-with-64-random-bytes-base64
# Local dev only: 32-byte base64 key-encryption key. Production uses AWS KMS (ca-central-1).
LOCAL_KEK_BASE64=

# Dev console second factor (a passkey after the password). Always on in
# production; set to "off" only for local scripts that can't use a passkey.
# PLATFORM_MFA=required
# Shared sign-in rate limits (automatic in production).
# RATE_LIMIT_STORE=database
# Online payment of invoices (card and Canadian pre-authorized debit) through
# Stripe Checkout. Webhook endpoint: https://<api host>/api/billing/stripe/webhook
# with events checkout.session.completed and checkout.session.async_payment_succeeded.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Push notifications to phones: generate once with `npx web-push generate-vapid-keys` (keep the private key secret).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Urgent texts and calls (cities switch "Text and phone alerts" on). console = log only; twilio = send.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
VAPID_SUBJECT=mailto:support@flexcityhq.example

# Public address of this API, for links that calendar apps fetch directly (shift feeds). Unset = the app's address, whose /api goes here.
# PUBLIC_API_URL=https://api.example.ca

# Operations (docs/ARCHITECTURE.md, "Health, metrics and errors").
# GET /metrics (Prometheus) needs "Authorization: Bearer <METRICS_TOKEN>"; unset = /metrics is off (404). At least 16 characters.
# METRICS_TOKEN=
# Error reports to a Sentry-compatible service (Sentry, GlitchTip), ideally hosted in Canada. Unset = errors are only logged.
# Reports are scrubbed of emails, phone/SIN/card numbers, tokens and passwords, and carry ids only (request, organization, hashed user).
# SENTRY_DSN=https://<key>@errors.example.ca/<project>
# SENTRY_ENVIRONMENT=production
# RELEASE=api@1.2.3
# GET /readyz: database check timeout (ms), oldest unsent email/text (s), worker heartbeat (s), and whether those last two fail it (on|off).
# READY_DB_TIMEOUT_MS=1500
# READY_OUTBOX_MAX_AGE_S=900
# READY_WORKER_MAX_AGE_S=300
# READY_STRICT=off
