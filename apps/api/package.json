{
  "name": "@flexcity/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:union": "tsx watch src/unionServer.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:union": "node dist/unionServer.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs && node --env-file-if-exists=.env scripts/apply-sql.mjs db/rls.sql db/union_hub.sql",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "platform:admin": "tsx scripts/platform-admin.ts",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "tenant:purge": "tsx scripts/purge-tenant.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1156.0",
    "@node-saml/node-saml": "5.2.0",
    "@prisma/client": "5.22.0",
    "@simplewebauthn/server": "13.3.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.4.3",
    "express": "4.22.3",
    "fflate": "0.8.3",
    "jose": "5.9.6",
    "luxon": "3.5.0",
    "openpgp": "6.3.2",
    "pdfkit": "^0.17.2",
    "pg": "8.13.1",
    "ssh2": "1.17.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/luxon": "3.4.2",
    "@types/node": "26.6.6",
    "@types/pdfkit": "^0.17.2",
    "@types/pg": "8.11.10",
    "@types/sax": "1.2.7",
    "@types/ssh2": "1.15.5",
    "@types/supertest": "6.0.2",
    "@types/web-push": "3.6.4",
    "prisma": "7.10.1",
    "sax": "1.6.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts"
  }
}
