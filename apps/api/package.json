{
  "name": "@flexcity/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && node --env-file-if-exists=.env scripts/apply-sql.mjs db/rls.sql db/union_hub.sql",
    "db:seed": "tsx prisma/seed.ts",
    "platform:admin": "tsx scripts/platform-admin.ts",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@simplewebauthn/server": "13.3.3",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "express": "4.22.3",
    "jose": "5.9.6",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "4.17.21",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "5.22.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
