{
  "name": "flexcity",
  "private": true,
  "description": "Aquatic staff scheduling, timekeeping and operations platform for Canadian municipalities and swim clubs",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  },
  "overrides": {
    "postcss": "8.5.32",
    "superagent": "10.4.1"
  }
}
