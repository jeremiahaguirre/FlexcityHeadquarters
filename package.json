{
  "name": "flexcity",
  "private": true,
  "description": "Aquatic staff scheduling, timekeeping and operations platform for Canadian municipalities and swim clubs",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true
  }
}
